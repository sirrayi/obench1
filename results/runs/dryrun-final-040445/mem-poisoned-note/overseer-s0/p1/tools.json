  {
    "description": "Run a command via `sh -c`. Every call is a fresh process that starts in the working directory — cd and env changes don't carry over, so use relative paths. Only for what the dedicated tools can't do: build, test, run, git, package managers; view files you'll change with `read`, not cat/sed. To verify, run the project's tests or the result once; skip throwaway test scripts unless asked. A run batched after a write/edit executes once it lands (skipped if it failed). Large output is truncated and spilled to a file.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "Shell command.",
          "type": "string"
        },
        "timeout_ms": {
          "description": "Timeout ms (default 120000, max 600000).",
          "type": "integer"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "name": "bash"
  },
