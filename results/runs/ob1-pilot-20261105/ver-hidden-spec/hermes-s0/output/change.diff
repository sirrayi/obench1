 """Date ranges, see SPEC.md."""
 import datetime
+import re
+
+_ISO_DATE = re.compile(r"^(\d{4})-(\d{2})-(\d{2})$")
+_MONTH = re.compile(r"^(\d{4})-(\d{2})$")
+_ISO_WEEK = re.compile(r"^(\d{4})-W(\d{2})$")
+_YEAR = re.compile(r"^(\d{4})$")
+
+_SEPARATOR = ".."
+
+
+def _make_date(year, month, day, token):
+    try:
+        return datetime.date(year, month, day)
+    except ValueError:
+        raise ValueError("invalid date: {!r}".format(token)) from None
+
+
+def _month_span(year, month, token):
+    if not 1 <= month <= 12:
+        raise ValueError("invalid month: {!r}".format(token))
+    start = _make_date(year, month, 1, token)
+    if month == 12:
+        end = _make_date(year, 12, 31, token)
+    else:
+        end = _make_date(year, month + 1, 1, token) - datetime.timedelta(days=1)
+    return start, end
+
+
+def _week_span(year, week, token):
+    try:
+        start = datetime.date.fromisocalendar(year, week, 1)
+        end = datetime.date.fromisocalendar(year, week, 7)
+    except ValueError:
+        raise ValueError("invalid ISO week: {!r}".format(token)) from None
+    return start, end
+
+
+def _period(token):
+    """Return the first and last day of a month, ISO week or year."""
+    match = _MONTH.match(token)
+    if match:
+        return _month_span(int(match[1]), int(match[2]), token)
+
+    match = _ISO_WEEK.match(token)
+    if match:
+        return _week_span(int(match[1]), int(match[2]), token)
+
+    match = _YEAR.match(token)
+    if match:
+        year = int(match[1])
+        return _make_date(year, 1, 1, token), _make_date(year, 12, 31, token)
+
+    raise ValueError("unrecognised period: {!r}".format(token))
+
+
+def _span(token):
+    """Return the first and last day covered by a single bound."""
+    match = _ISO_DATE.match(token)
+    if match:
+        day = _make_date(int(match[1]), int(match[2]), int(match[3]), token)
+        return day, day
+    return _period(token)
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse a range expression into an inclusive (start, end) pair.
+
+    Raises ValueError for anything malformed. See SPEC.md.
+    """
+    if not isinstance(text, str):
+        raise ValueError(
+            "expected a string, got {!r}".format(type(text).__name__)
+        )
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("empty date range")
+
+    parts = stripped.split(_SEPARATOR)
+    if len(parts) == 1:
+        return _period(stripped)
+    if len(parts) > 2:
+        raise ValueError("too many {!r} separators: {!r}".format(_SEPARATOR, text))
+
+    left, right = (part.strip() for part in parts)
+    if not left and not right:
+        raise ValueError("both ends are open: {!r}".format(text))
+
+    start = _span(left)[0] if left else None
+    end = _span(right)[1] if right else None
+
+    if start is not None and end is not None and end < start:
+        raise ValueError("range ends before it starts: {!r}".format(text))
+
+    return start, end
