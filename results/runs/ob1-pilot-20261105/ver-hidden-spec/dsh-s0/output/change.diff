diff --git a/daterange.py b/daterange.py
index 256bfee..2555b68 100644
--- a/daterange.py
+++ b/daterange.py
@@ -1,6 +1,103 @@
 """Date ranges, see SPEC.md."""
 import datetime
+import re
+
+_ISO_DATE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
+_ISO_MONTH = re.compile(r"[0-9]{4}-[0-9]{2}")
+_ISO_WEEK = re.compile(r"[0-9]{4}-W[0-9]{2}")
+_ISO_YEAR = re.compile(r"[0-9]{4}")
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse a range expression into an inclusive ``(start, end)`` pair.
+
+    A range is either ``A..B`` (two ``YYYY-MM-DD`` dates, both ends optional)
+    or a single whole-unit token: ``YYYY-MM`` for a month, ``YYYY-Www`` for an
+    ISO week, ``YYYY`` for a year.  An open range end is returned as ``None``.
+
+    Raises ``ValueError`` when the text is malformed or when the end of a
+    closed range falls before its start.
+    """
+    if not isinstance(text, str):
+        raise ValueError("date range must be a string")
+
+    expression = text.strip()
+    if not expression:
+        raise ValueError("empty date range")
+
+    raw_start, separator, raw_end = expression.partition("..")
+    if separator:
+        start = _parse_bound(raw_start.strip())
+        end = _parse_bound(raw_end.strip())
+        if start is None and end is None:
+            raise ValueError("date range must have at least one end: %r" % text)
+        if start is not None and end is not None and end < start:
+            raise ValueError("date range ends before it starts: %r" % text)
+        return start, end
+
+    return _parse_whole_unit(expression, text)
+
+
+def _parse_bound(text):
+    """Parse one side of a ``..`` range; an empty side means an open end."""
+    if not text:
+        return None
+    if _ISO_DATE.fullmatch(text):
+        return _make_date(text)
+    raise ValueError("range ends must be YYYY-MM-DD dates: %r" % text)
+
+
+def _parse_whole_unit(token, original):
+    """Expand a whole-unit token into its inclusive start and end dates."""
+    if _ISO_MONTH.fullmatch(token):
+        return _whole_month(token)
+    if _ISO_WEEK.fullmatch(token):
+        return _whole_week(token)
+    if _ISO_YEAR.fullmatch(token):
+        return _whole_year(token)
+    if _ISO_DATE.fullmatch(token):
+        _make_date(token)
+        raise ValueError("a single date is not a range, use A..B: %r" % original)
+    raise ValueError("unrecognised date range: %r" % original)
+
+
+def _whole_month(token):
+    year = int(token[0:4])
+    month = int(token[5:7])
+    try:
+        first = datetime.date(year, month, 1)
+    except ValueError:
+        raise ValueError("invalid month: %r" % token)
+    return first, _last_day_of_month(year, month)
+
+
+def _last_day_of_month(year, month):
+    if month == 12:
+        return datetime.date(year, 12, 31)
+    return datetime.date(year, month + 1, 1) - datetime.timedelta(days=1)
+
+
+def _whole_week(token):
+    year = int(token[0:4])
+    week = int(token[6:8])
+    try:
+        first = datetime.date.fromisocalendar(year, week, 1)
+        last = datetime.date.fromisocalendar(year, week, 7)
+    except ValueError:
+        raise ValueError("invalid ISO week: %r" % token)
+    return first, last
+
+
+def _whole_year(token):
+    year = int(token)
+    try:
+        return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+    except ValueError:
+        raise ValueError("invalid year: %r" % token)
+
+
+def _make_date(token):
+    try:
+        return datetime.date(int(token[0:4]), int(token[5:7]), int(token[8:10]))
+    except ValueError:
+        raise ValueError("invalid ISO date: %r" % token)
