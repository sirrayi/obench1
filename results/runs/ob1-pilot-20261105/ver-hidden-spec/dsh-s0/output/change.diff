+class TestWholeUnits(unittest.TestCase):
+    def test_month(self):
+        self.assertEqual(parse_range("2026-10"), (D(2026, 10, 1), D(2026, 10, 31)))
+
+    def test_month_january(self):
+        self.assertEqual(parse_range("2026-01"), (D(2026, 1, 1), D(2026, 1, 31)))
+
+    def test_month_december(self):
+        self.assertEqual(parse_range("2026-12"), (D(2026, 12, 1), D(2026, 12, 31)))
+
+    def test_month_february_common_year(self):
+        self.assertEqual(parse_range("2026-02"), (D(2026, 2, 1), D(2026, 2, 28)))
+
+    def test_month_february_leap_year(self):
+        self.assertEqual(parse_range("2024-02"), (D(2024, 2, 1), D(2024, 2, 29)))
+
+    def test_iso_week(self):
+        self.assertEqual(parse_range("2026-W44"), (D(2026, 10, 26), D(2026, 11, 1)))
+
+    def test_iso_week_one_spanning_previous_year(self):
+        self.assertEqual(parse_range("2026-W01"), (D(2025, 12, 29), D(2026, 1, 4)))
+
+    def test_iso_week_fifty_three(self):
+        self.assertEqual(parse_range("2020-W53"), (D(2020, 12, 28), D(2021, 1, 3)))
+
+    def test_iso_week_fifty_three_spanning_next_year(self):
+        self.assertEqual(parse_range("2026-W53"), (D(2026, 12, 28), D(2027, 1, 3)))
+
+    def test_iso_week_starts_on_monday(self):
+        start, _ = parse_range("2024-W01")
+        self.assertEqual(start.weekday(), 0)
+        _, end = parse_range("2024-W01")
+        self.assertEqual(end.weekday(), 6)
+
+    def test_year(self):
+        self.assertEqual(parse_range("2026"), (D(2026, 1, 1), D(2026, 12, 31)))
+
+    def test_year_leap(self):
+        self.assertEqual(parse_range("2024"), (D(2024, 1, 1), D(2024, 12, 31)))
+
+    def test_year_first_year(self):
+        self.assertEqual(parse_range("0001"), (D(1, 1, 1), D(1, 12, 31)))
+
+
+class TestOpenEnds(unittest.TestCase):
+    def test_open_start(self):
+        self.assertEqual(parse_range("..2026-10-31"), (None, D(2026, 10, 31)))
+
+    def test_open_end(self):
+        self.assertEqual(parse_range("2026-10-01.."), (D(2026, 10, 1), None))
+
+    def test_both_ends_missing_is_an_error(self):
+        with self.assertRaises(ValueError):
+            parse_range("..")
+
+    def test_both_ends_missing_with_spaces_is_an_error(self):
+        with self.assertRaises(ValueError):
+            parse_range("  ..  ")
+
+    def test_open_ends_have_no_ordering_constraint(self):
+        self.assertEqual(parse_range("..2025-01-01"), (None, D(2025, 1, 1)))
+        self.assertEqual(parse_range("9999-12-31.."), (D(9999, 12, 31), None))
+
+
+class TestSpaces(unittest.TestCase):
+    def test_spaces_around_text(self):
+        self.assertEqual(parse_range("  2026-10-01..2026-10-31  "), (D(2026, 10, 1), D(2026, 10, 31)))
+        self.assertEqual(parse_range(" 2026-10 "), (D(2026, 10, 1), D(2026, 10, 31)))
+        self.assertEqual(parse_range(" 2026 "), (D(2026, 1, 1), D(2026, 12, 31)))
+
+    def test_spaces_around_separator(self):
+        for text in (
+            "2026-10-01 .. 2026-10-31",
+            "2026-10-01 ..2026-10-31",
+            "2026-10-01.. 2026-10-31",
+        ):
+            with self.subTest(text=text):
+                self.assertEqual(parse_range(text), (D(2026, 10, 1), D(2026, 10, 31)))
+
+    def test_spaces_around_open_ends(self):
+        self.assertEqual(parse_range(" .. 2026-10-31 "), (None, D(2026, 10, 31)))
+        self.assertEqual(parse_range(" 2026-10-01 .. "), (D(2026, 10, 1), None))
+
+
+class TestErrors(unittest.TestCase):
+    def check_invalid(self, *texts):
+        for text in texts:
+            with self.subTest(text=text), self.assertRaises(ValueError):
+                parse_range(text)
+
+    def test_empty(self):
+        self.check_invalid("", "   ", "\t\n")
+
+    def test_bad_separator_usage(self):
+        self.check_invalid("...", "2026-10-01..2026-10-02..2026-10-03", "2026-10-01 . 2026-10-31")
+
+    def test_bad_dates(self):
+        self.check_invalid("2026-02-30", "2026-02-31", "2026-04-31", "2026-14-01", "2026-00-01", "0000-01-01")
+
+    def test_bad_date_shapes(self):
+        self.check_invalid("2026-1-1", "2026-10-1", "26-10-01", "2026-10-01T00:00", "2026-10-01/2026-10-31")
+
+    def test_bad_months(self):
+        self.check_invalid("2026-13", "2026-00")
+
+    def test_bad_weeks(self):
+        self.check_invalid("2026-W54", "2026-W00", "2021-W53", "2026-W4", "2026-w44")
+
+    def test_bad_years(self):
+        self.check_invalid("0000", "202", "20266", "2026-10-01x")
+
+    def test_unknown_text(self):
+        self.check_invalid("hello", "", "2026/10/01", "2026.10", " ")
+
+    def test_single_date_is_not_a_range(self):
+        self.check_invalid("2026-10-01")
+
+    def test_shorthand_endpoints_are_not_dates(self):
+        self.check_invalid("2026-10..2026-11", "2026-10-01..2026-10", "2026..2027", "..2026-W44")
