 """Date ranges, see SPEC.md."""
+import calendar
 import datetime
+import re
+
+_DATE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_WEEK = re.compile(r"([0-9]{4})-W([0-9]{2})")
+_MONTH = re.compile(r"([0-9]{4})-([0-9]{2})")
+_YEAR = re.compile(r"([0-9]{4})")
+
+
+def _period(text):
+    """Return the inclusive (first, last) days denoted by a single token."""
+    match = _DATE.fullmatch(text)
+    if match:
+        day = datetime.date(*map(int, match.groups()))
+        return day, day
+
+    match = _WEEK.fullmatch(text)
+    if match:
+        year, week = map(int, match.groups())
+        return (
+            datetime.date.fromisocalendar(year, week, 1),
+            datetime.date.fromisocalendar(year, week, 7),
+        )
+
+    match = _MONTH.fullmatch(text)
+    if match:
+        year, month = map(int, match.groups())
+        first = datetime.date(year, month, 1)
+        last = datetime.date(year, month, calendar.monthrange(year, month)[1])
+        return first, last
+
+    match = _YEAR.fullmatch(text)
+    if match:
+        year = int(match.group(1))
+        return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+
+    raise ValueError(f"malformed date token: {text!r}")
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse a range expression into an inclusive (start, end) date pair."""
+    if not isinstance(text, str):
+        raise ValueError(f"date range must be a string, got {type(text).__name__}")
+    body = text.strip()
+    if not body:
+        raise ValueError("empty date range")
+
+    halves = body.split("..")
+    if len(halves) == 1:
+        return _period(body)
+    if len(halves) != 2:
+        raise ValueError(f"malformed date range: {text!r}")
+
+    start_text, end_text = (half.strip() for half in halves)
+    if not start_text and not end_text:
+        raise ValueError(f"date range has no endpoints: {text!r}")
+
+    start = _period(start_text)[0] if start_text else None
+    end = _period(end_text)[1] if end_text else None
+    if start is not None and end is not None and end < start:
+        raise ValueError(f"date range ends before it starts: {text!r}")
+    return start, end
