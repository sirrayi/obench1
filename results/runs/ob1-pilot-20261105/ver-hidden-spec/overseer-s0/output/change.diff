 """Date ranges, see SPEC.md."""
+import calendar
 import datetime
+import re
+
+_FULL_DATE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_YEAR_MONTH = re.compile(r"([0-9]{4})-([0-9]{2})")
+_ISO_WEEK = re.compile(r"([0-9]{4})-W([0-9]{2})")
+_YEAR = re.compile(r"([0-9]{4})")
+
+
+def _term(text):
+    """Return the inclusive ``(first, last)`` day pair of one date term.
+
+    A full ISO date covers itself, a month covers the whole month, an ISO week
+    covers Monday to Sunday and a year covers the whole year. Anything else
+    raises ``ValueError``.
+    """
+    match = _FULL_DATE.fullmatch(text)
+    if match:
+        day = datetime.date(int(match.group(1)), int(match.group(2)), int(match.group(3)))
+        return day, day
+
+    match = _YEAR_MONTH.fullmatch(text)
+    if match:
+        first = datetime.date(int(match.group(1)), int(match.group(2)), 1)
+        length = calendar.monthrange(first.year, first.month)[1]
+        return first, first + datetime.timedelta(days=length - 1)
+
+    match = _ISO_WEEK.fullmatch(text)
+    if match:
+        monday = datetime.date.fromisocalendar(int(match.group(1)), int(match.group(2)), 1)
+        return monday, monday + datetime.timedelta(days=6)
+
+    match = _YEAR.fullmatch(text)
+    if match:
+        year = int(match.group(1))
+        return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+
+    raise ValueError(f"not a date, month, ISO week or year: {text!r}")
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse ``text`` into an inclusive ``(start, end)`` pair of dates.
+
+    ``A..B`` spans from the first day of A to the last day of B; either side
+    may be left open. A lone term is its own span, so ``"2026-10"`` is the
+    whole month. Errors raise ``ValueError``.
+    """
+    stripped = text.strip()
+    head, separator, tail = stripped.partition("..")
+    if not separator:
+        return _term(stripped)
+
+    head, tail = head.strip(), tail.strip()
+    if not head and not tail:
+        raise ValueError(f"both ends of the range are open: {text!r}")
+
+    start = _term(head)[0] if head else None
+    end = _term(tail)[1] if tail else None
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"range ends before it starts: {text!r}")
+    return start, end
diff --git a/tests/test_daterange.py b/tests/test_daterange.py
index 7018d91..641b8e5 100644
--- a/tests/test_daterange.py
+++ b/tests/test_daterange.py
@@ -4,6 +4,128 @@ import unittest
 from daterange import parse_range
 
 
+def date(year, month, day):
+    return datetime.date(year, month, day)
+
+
 class TestRange(unittest.TestCase):
     def test_two_dates(self):
         self.assertEqual(parse_range("2026-10-01..2026-10-31"), (datetime.date(2026, 10, 1), datetime.date(2026, 10, 31)))
+
+    def test_single_date_stands_alone(self):
+        self.assertEqual(parse_range("2026-10-01"), (date(2026, 10, 1), date(2026, 10, 1)))
+
+    def test_same_day(self):
+        self.assertEqual(parse_range("2026-10-01..2026-10-01"), (date(2026, 10, 1), date(2026, 10, 1)))
+
+    def test_month(self):
+        cases = [
+            ("2026-01", (date(2026, 1, 1), date(2026, 1, 31))),
+            ("2026-02", (date(2026, 2, 1), date(2026, 2, 28))),
+            ("2024-02", (date(2024, 2, 1), date(2024, 2, 29))),
+            ("2026-04", (date(2026, 4, 1), date(2026, 4, 30))),
+            ("2026-12", (date(2026, 12, 1), date(2026, 12, 31))),
+        ]
+        for text, expected in cases:
+            with self.subTest(text=text):
+                self.assertEqual(parse_range(text), expected)
+
+    def test_iso_week(self):
+        cases = [
+            ("2026-W44", (date(2026, 10, 26), date(2026, 11, 1))),
+            ("2026-W01", (date(2025, 12, 29), date(2026, 1, 4))),
+            ("2025-W01", (date(2024, 12, 30), date(2025, 1, 5))),
+            ("2026-W53", (date(2026, 12, 28), date(2027, 1, 3))),
+        ]
+        for text, expected in cases:
+            with self.subTest(text=text):
+                self.assertEqual(parse_range(text), expected)
+
+    def test_year(self):
+        self.assertEqual(parse_range("2026"), (date(2026, 1, 1), date(2026, 12, 31)))
+        self.assertEqual(parse_range("2024"), (date(2024, 1, 1), date(2024, 12, 31)))
+
+    def test_open_start(self):
+        self.assertEqual(parse_range("..2026-10-31"), (None, date(2026, 10, 31)))
+
+    def test_open_end(self):
+        self.assertEqual(parse_range("2026-10-01.."), (date(2026, 10, 1), None))
+
+    def test_open_end_of_month_week_and_year(self):
+        self.assertEqual(parse_range("..2026-10"), (None, date(2026, 10, 31)))
+        self.assertEqual(parse_range("..2026-W44"), (None, date(2026, 11, 1)))
+        self.assertEqual(parse_range("2026.."), (date(2026, 1, 1), None))
+
+    def test_month_week_and_year_as_range_ends(self):
+        self.assertEqual(parse_range("2026-09..2026-10"), (date(2026, 9, 1), date(2026, 10, 31)))
+        self.assertEqual(parse_range("2026-W44..2026-11-30"), (date(2026, 10, 26), date(2026, 11, 30)))
+        self.assertEqual(parse_range("2025..2026-01-15"), (date(2025, 1, 1), date(2026, 1, 15)))
+
+    def test_spaces(self):
+        cases = [
+            "  2026-10-01..2026-10-31  ",
+            "2026-10-01 ..2026-10-31",
+            "2026-10-01.. 2026-10-31",
+            "2026-10-01  ..  2026-10-31",
+            "\t2026-10-01..2026-10-31\n",
+        ]
+        expected = (date(2026, 10, 1), date(2026, 10, 31))
+        for text in cases:
+            with self.subTest(text=text):
+                self.assertEqual(parse_range(text), expected)
+
+    def test_spaces_around_single_terms(self):
+        self.assertEqual(parse_range(" 2026-10 "), (date(2026, 10, 1), date(2026, 10, 31)))
+        self.assertEqual(parse_range(" .. 2026-10-31 "), (None, date(2026, 10, 31)))
+        self.assertEqual(parse_range(" 2026-10-01 .. "), (date(2026, 10, 1), None))
+
+    def test_malformed(self):
+        cases = [
+            "",
+            "   ",
+            "..",
+            " .. ",
+            "2026-13",
+            "2026-00",
+            "2026-1-1",
+            "20261001",
+            "2026-02-30",
+            "2023-02-29",
+            "2026-10-00",
+            "2026-10-32",
+            "0000-01-01",
+            "0000",
+            "2026-W00",
+            "2026-W54",
+            "2026-W60",
+            "2026-W4",
+            "26",
+            "2026-10-01.2026-10-31",
+            "2026-10-01...2026-10-31",
+            "2026-10-01..2026-10-02..2026-10-03",
+            "2026-10-01..2026-10-31..",
+            "2026 -10-01",
+            "2026-10-01T00:00",
+            "not a date",
+            "2026-10-01..2026-13",
+        ]
+        for text in cases:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_range(text)
+
+    def test_backwards(self):
+        cases = [
+            "2026-10-31..2026-10-01",
+            "2026-11..2026-10",
+            "2026..2025",
+            "2026-W45..2026-W44",
+        ]
+        for text in cases:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_range(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
