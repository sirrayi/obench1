diff --git a/clients/_rules.py b/clients/_rules.py
new file mode 100644
index 0000000..4e7177f
--- /dev/null
+++ b/clients/_rules.py
@@ -0,0 +1,76 @@
+"""Ordered rule engine shared by the record normalizers."""
+
+from datetime import datetime
+from decimal import Decimal, ROUND_HALF_UP
+
+
+_TRUE = {"yes", "true", "1"}
+_FALSE = {"no", "false", "0"}
+
+
+def _apply_rule(record, rule):
+    op = rule[0]
+
+    if op == "require":
+        field = rule[1]
+        if field not in record:
+            raise ValueError("missing required field: %s" % field)
+        return
+
+    if op == "default":
+        field, value = rule[1], rule[2]
+        if field not in record:
+            record[field] = value
+        return
+
+    if op == "rename":
+        source, target = rule[1], rule[2]
+        if source in record:
+            record[target] = record.pop(source)
+        return
+
+    if op == "drop":
+        record.pop(rule[1], None)
+        return
+
+    field = rule[1]
+    if field not in record:
+        return
+
+    if op == "strip":
+        record[field] = record[field].strip()
+    elif op == "lower":
+        record[field] = record[field].lower()
+    elif op == "upper":
+        record[field] = record[field].upper()
+    elif op == "cents":
+        amount = Decimal(str(record[field]).strip()) * 100
+        record[field] = int(amount.quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+    elif op == "bool":
+        text = "".join(str(record[field]).split()).lower()
+        if text in _TRUE:
+            record[field] = True
+        elif text in _FALSE:
+            record[field] = False
+        else:
+            raise ValueError("invalid boolean value for %s: %r" % (field, record[field]))
+    elif op == "iso-date":
+        text = "".join(str(record[field]).split())
+        record[field] = datetime.strptime(text, "%d/%m/%Y").strftime("%Y-%m-%d")
+    elif op == "split":
+        separator = rule[2]
+        record[field] = [
+            piece.strip()
+            for piece in record[field].split(separator)
+            if piece.strip()
+        ]
+    else:
+        raise ValueError("unknown rule: %s" % op)
+
+
+def apply_rules(record, rules):
+    """Return a normalized copy of ``record`` after applying ``rules`` in order."""
+    result = dict(record)
+    for rule in rules:
+        _apply_rule(result, rule)
+    return result
