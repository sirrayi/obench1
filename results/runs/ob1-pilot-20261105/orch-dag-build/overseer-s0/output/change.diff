+"""Normalizer for raw accounts records."""
+
+from datetime import date
+from decimal import ROUND_HALF_UP, Decimal
+
+_TRUE = ("yes", "true", "1")
+_FALSE = ("no", "false", "0")
+
+
+def _require(rec, field):
+    if field not in rec:
+        raise ValueError("%s is missing" % field)
+
+
+def _default(rec, field, value):
+    if field not in rec:
+        rec[field] = value
+
+
+def _rename(rec, old, new):
+    if old in rec:
+        rec[new] = rec.pop(old)
+
+
+def _drop(rec, field):
+    rec.pop(field, None)
+
+
+def _string(rec, field, method):
+    if field in rec:
+        rec[field] = method(rec[field])
+
+
+def _strip(rec, field):
+    _string(rec, field, lambda value: value.strip())
+
+
+def _lower(rec, field):
+    _string(rec, field, lambda value: value.lower())
+
+
+def _upper(rec, field):
+    _string(rec, field, lambda value: value.upper())
+
+
+def _cents(rec, field):
+    if field not in rec:
+        return
+    value = rec[field]
+    if isinstance(value, bool):
+        raise ValueError("%s is not a number" % field)
+    if isinstance(value, str):
+        text = "".join(value.split())
+        if not text:
+            raise ValueError("%s is not a number" % field)
+        amount = Decimal(text)
+    elif isinstance(value, float):
+        amount = Decimal(repr(value))
+    else:
+        amount = Decimal(value)
+    rec[field] = int((amount * 100).quantize(Decimal(1), rounding=ROUND_HALF_UP))
+
+
+def _bool(rec, field):
+    if field not in rec:
+        return
+    text = "".join(str(rec[field]).split()).lower()
+    if text in _TRUE:
+        rec[field] = True
+    elif text in _FALSE:
+        rec[field] = False
+    else:
+        raise ValueError("%s is not a boolean" % field)
+
+
+def _iso_date(rec, field):
+    if field not in rec:
+        return
+    text = "".join(str(rec[field]).split())
+    parts = text.split("/")
+    if len(parts) != 3 or not all(part.isdigit() for part in parts) or len(parts[2]) != 4:
+        raise ValueError("%s is not a DD/MM/YYYY date" % field)
+    day, month, year = (int(part) for part in parts)
+    rec[field] = date(year, month, day).isoformat()
+
+
+def _split(rec, field, separator):
+    if field not in rec:
+        return
+    value = rec[field]
+    items = value if isinstance(value, list) else [value]
+    pieces = []
+    for item in items:
+        for piece in str(item).split(separator):
+            piece = piece.strip()
+            if piece:
+                pieces.append(piece)
+    rec[field] = pieces
+
+
+def normalize(record):
+    rec = dict(record)
+    _require(rec, "acc_ref")
+    _rename(rec, "acc_vip", "accounts_vip")
+    _strip(rec, "acc_owner")
+    _default(rec, "acc_label", "unknown")
+    _rename(rec, "acc_fee", "accounts_fee")
+    _lower(rec, "acc_label")
+    _default(rec, "acc_region", "unknown")
+    _default(rec, "acc_tier", "unknown")
+    _default(rec, "acc_amount", "0.00")
+    _bool(rec, "accounts_vip")
+    _cents(rec, "accounts_fee")
+    _lower(rec, "acc_tier")
+    _upper(rec, "acc_ref")
+    _lower(rec, "acc_city")
+    _rename(rec, "acc_city", "accounts_city")
+    _strip(rec, "acc_tier")
+    _strip(rec, "accounts_city")
+    _upper(rec, "accounts_city")
+    _cents(rec, "acc_amount")
+    _strip(rec, "acc_region")
+    _rename(rec, "acc_region", "accounts_region")
+    _upper(rec, "accounts_region")
+    _strip(rec, "acc_ref")
+    _rename(rec, "acc_amount", "accounts_amount")
+    _drop(rec, "acc_ref")
+    return rec
