diff --git a/run_examples.py b/run_examples.py
new file mode 100644
index 0000000..fa6dc1c
--- /dev/null
+++ b/run_examples.py
@@ -0,0 +1,46 @@
+"""Run every examples/*.json case against its normalizer."""
+
+import importlib
+import json
+import pathlib
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[0]
+
+
+def main():
+    failures = 0
+    total = 0
+    for path in sorted((ROOT / "examples").glob("*.json")):
+        name = path.stem
+        module = importlib.import_module("clients." + name)
+        cases = json.loads(path.read_text())
+        for index, case in enumerate(cases):
+            total += 1
+            expected = case["result"]
+            try:
+                actual = module.normalize(case["record"])
+            except ValueError:
+                if expected.get("err") != "ValueError":
+                    failures += 1
+                    print("FAIL %s[%d]: unexpected ValueError" % (name, index))
+                continue
+            except Exception as exc:  # noqa: BLE001
+                failures += 1
+                print("FAIL %s[%d]: %s: %s" % (name, index, type(exc).__name__, exc))
+                continue
+            if "ok" not in expected:
+                failures += 1
+                print("FAIL %s[%d]: expected ValueError, got %r" % (name, index, actual))
+            elif actual != expected["ok"]:
+                failures += 1
+                print("FAIL %s[%d]:" % (name, index))
+                for key in sorted(set(actual) | set(expected["ok"])):
+                    if actual.get(key, "<missing>") != expected["ok"].get(key, "<missing>"):
+                        print("   %s: got %r want %r" % (key, actual.get(key, "<missing>"), expected["ok"].get(key, "<missing>")))
+    print("%d/%d passed" % (total - failures, total))
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
