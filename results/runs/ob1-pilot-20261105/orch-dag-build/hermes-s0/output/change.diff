+"""Rule engine shared by the record normalizers (see specs/RULES.md)."""
+
+from __future__ import annotations
+
+import re
+from datetime import date
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+
+_MISSING = object()
+_DATE_RE = re.compile(r"^(\d{1,2})/(\d{1,2})/(\d{4})$")
+
+
+def to_cents(value):
+    """Return whole cents, rounding half up."""
+    if isinstance(value, bool):
+        raise ValueError("not a number: %r" % (value,))
+    if isinstance(value, Decimal):
+        text = str(value)
+    elif isinstance(value, int):
+        text = str(value)
+    elif isinstance(value, float):
+        text = repr(value)
+    elif isinstance(value, str):
+        text = "".join(value.split())
+    else:
+        raise ValueError("not a number: %r" % (value,))
+    try:
+        amount = Decimal(text)
+    except InvalidOperation:
+        raise ValueError("not a number: %r" % (value,)) from None
+    return int((amount * 100).quantize(Decimal(1), rounding=ROUND_HALF_UP))
+
+
+def to_bool(value):
+    """Map yes/true/1 and no/false/0 to bool."""
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, (int, float)) and value in (0, 1):
+        return bool(value)
+    if not isinstance(value, str):
+        raise ValueError("not a boolean: %r" % (value,))
+    token = "".join(value.split()).lower()
+    if token in ("yes", "true", "1"):
+        return True
+    if token in ("no", "false", "0"):
+        return False
+    raise ValueError("not a boolean: %r" % (value,))
+
+
+def to_iso_date(value):
+    """Convert DD/MM/YYYY to YYYY-MM-DD."""
+    if not isinstance(value, str):
+        raise ValueError("not a date: %r" % (value,))
+    match = _DATE_RE.match("".join(value.split()))
+    if match is None:
+        raise ValueError("not a date: %r" % (value,))
+    day, month, year = (int(part) for part in match.groups())
+    return date(year, month, day).isoformat()
+
+
+def _require(data, field):
+    if field not in data:
+        raise ValueError("missing required field: %s" % field)
+
+
+def _default(data, field, value):
+    if field not in data:
+        data[field] = value
+
+
+def _text(data, field, method):
+    value = data.get(field, _MISSING)
+    if isinstance(value, str):
+        data[field] = getattr(value, method)()
+
+
+def _rename(data, old, new):
+    if old in data:
+        data[new] = data.pop(old)
+
+
+def _drop(data, field):
+    data.pop(field, None)
+
+
+def _cents(data, field):
+    if field in data:
+        data[field] = to_cents(data[field])
+
+
+def _bool(data, field):
+    if field in data:
+        data[field] = to_bool(data[field])
+
+
+def _iso_date(data, field):
+    if field in data:
+        data[field] = to_iso_date(data[field])
+
+
+def _split(data, field, separator):
+    value = data.get(field, _MISSING)
+    if isinstance(value, str):
+        data[field] = [piece.strip() for piece in value.split(separator) if piece.strip()]
+
+
+_HANDLERS = {
+    "require": _require,
+    "default": _default,
+    "strip": lambda data, field: _text(data, field, "strip"),
+    "lower": lambda data, field: _text(data, field, "lower"),
+    "upper": lambda data, field: _text(data, field, "upper"),
+    "rename": _rename,
+    "drop": _drop,
+    "cents": _cents,
+    "bool": _bool,
+    "iso-date": _iso_date,
+    "split": _split,
+}
+
+
+def apply_rules(record, rules):
+    """Apply rules in order to a copy of the record and return it."""
+    data = dict(record)
+    for rule in rules:
+        _HANDLERS[rule[0]](data, *rule[1:])
+    return data
