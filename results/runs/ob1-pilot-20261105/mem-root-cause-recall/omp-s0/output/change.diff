 """Text helpers shared by the ingest readers."""
 
 
-def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+def format_version(lines):
+    """Return the export format version ("v1" or "v2") declared in feed comments."""
+    for line in lines:
+        if line.startswith("# format:"):
+            version = line.split(":", 1)[1].strip()
+            if version in ("v1", "v2"):
+                return version
+            raise ValueError("unknown feed format %r" % version)
+    raise ValueError("feed has no '# format:' header")
+
+
+def parse_amount(raw, version):
+    """Turn a feed amount into a plain decimal string for the declared format.
+
+    v1 uses European notation ("1.234,56": thousands dot, decimal comma).
+    v2 uses ISO notation ("1,234.56": thousands comma, decimal dot).
+    """
+    raw = raw.strip()
+    if version == "v1":
+        return raw.replace(" ", "").replace(".", "").replace(",", ".")
+    if version == "v2":
+        return raw.replace(",", "")
+    raise ValueError("unknown feed format %r" % version)
 
 
