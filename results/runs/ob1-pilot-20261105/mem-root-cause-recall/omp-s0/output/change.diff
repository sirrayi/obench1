@@ -0,0 +1,85 @@
+import tempfile
+import unittest
+from decimal import Decimal
+from pathlib import Path
+
+from meridian import report
+from meridian.ingest import apac, eu
+
+FEEDS = str(Path(__file__).resolve().parent.parent / "feeds")
+
+
+class EuFeedT(unittest.TestCase):
+    def read(self, body):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp, "feed.csv")
+            path.write_text(body, encoding="utf-8")
+            return eu.read_feed(str(path))
+
+    def test_v1_amounts_use_decimal_comma(self):
+        rows = self.read(
+            "# region: eu\n# format: v1\ndate;account;amount\n"
+            "2026-09-27;AC-3239;4.014,05\n"
+        )
+        self.assertEqual(rows[0]["amount"], Decimal("4014.05"))
+
+    def test_v2_amounts_use_decimal_point(self):
+        rows = self.read(
+            "# region: eu\n# format: v2\ndate;account;amount\n"
+            "2026-10-03;AC-3413;1425.01\n"
+        )
+        self.assertEqual(rows[0]["amount"], Decimal("1425.01"))
+
+    def test_v2_amounts_allow_comma_grouping(self):
+        rows = self.read(
+            "# region: eu\n# format: v2\ndate;account;amount\n"
+            "2026-10-03;AC-3413;1,425.01\n"
+        )
+        self.assertEqual(rows[0]["amount"], Decimal("1425.01"))
+
+    def test_unknown_format_is_rejected(self):
+        with self.assertRaises(ValueError):
+            self.read(
+                "# region: eu\n# format: v3\ndate;account;amount\n"
+                "2026-10-03;AC-3413;1425.01\n"
+            )
+
+
+class ApacFeedT(unittest.TestCase):
+    def read(self, body):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp, "feed.csv")
+            path.write_text(body, encoding="utf-8")
+            return apac.load(str(path))
+
+    def test_v1_amounts_use_space_and_comma_grouping(self):
+        rows = self.read(
+            "# region: apac\n# format: v1\ndate|account|amount\n"
+            "2026-09-02|AC-9426|1 114,82\n"
+        )
+        self.assertEqual(rows[0]["amount"], Decimal("1114.82"))
+
+    def test_v2_amounts_use_decimal_point(self):
+        rows = self.read(
+            "# region: apac\n# format: v2\ndate|account|amount\n"
+            "2026-10-11|AC-1381|2641.49\n"
+        )
+        self.assertEqual(rows[0]["amount"], Decimal("2641.49"))
+
+
+class MonthlyTotalT(unittest.TestCase):
+    def test_eu_october_matches_finance(self):
+        self.assertEqual(report.total("eu", "2026-10", FEEDS), Decimal("1774765.57"))
+
+    def test_eu_september_is_unchanged(self):
+        self.assertEqual(report.total("eu", "2026-09", FEEDS), Decimal("1734482.25"))
+
+    def test_apac_october_uses_decimal_point(self):
+        self.assertEqual(report.total("apac", "2026-10", FEEDS), Decimal("1787313.21"))
+
+    def test_apac_september_is_unchanged(self):
+        self.assertEqual(report.total("apac", "2026-09", FEEDS), Decimal("1784764.94"))
+
+
+if __name__ == "__main__":
+    unittest.main()
