diff --git a/meridian/text.py b/meridian/text.py
index 39ac75f..3fe8c51 100644
--- a/meridian/text.py
+++ b/meridian/text.py
@@ -2,8 +2,30 @@
 
 
 def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+    """Turn a v1 amount into a plain decimal string ("1.234,56" -> "1234.56")."""
+    return raw.strip().replace(" ", "").replace(".", "").replace(",", ".")
+
+
+def plain_number(raw):
+    """Turn a v2 amount into a plain decimal string ("1,425.01" -> "1425.01")."""
+    return raw.strip().replace(" ", "").replace(",", "")
+
+
+# The amount convention each export format uses, keyed by its "# format:" name.
+# v1 groups thousands with dots or spaces and ends with a decimal comma; v2
+# writes a plain decimal point and groups with commas.
+FORMATS = {"v1": clean_number, "v2": plain_number}
+
+
+def declared_format(lines, path):
+    """Name the amount convention an export declares in its "# format:" header."""
+    for line in lines:
+        if line.startswith("# format:"):
+            name = line.split(":", 1)[1].strip()
+            if name not in FORMATS:
+                raise ValueError("%s: unsupported export format %r" % (path, name))
+            return name
+    raise ValueError("%s: export declares no '# format:' header" % path)
 
 
