 """Text helpers shared by the ingest readers."""
+from decimal import Decimal
+
+SUPPORTED_FORMATS = ("v1", "v2")
 
 
 def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+    """Turn a v1 feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
+    return raw.strip().replace(" ", "").replace(".", "").replace(",", ".")
+
+
+def feed_format(lines):
+    """Return the format declared in a feed header, defaulting to v1."""
+    for line in lines:
+        line = line.strip()
+        if not line.startswith("#") or ":" not in line:
+            continue
+        key, value = line[1:].split(":", 1)
+        if key.strip() == "format":
+            fmt = value.strip()
+            if fmt not in SUPPORTED_FORMATS:
+                raise ValueError("unsupported feed format: %r" % (fmt,))
+            return fmt
+    return "v1"
 
 
-def squash(s):
-    """Collapse runs of whitespace."""
-    return " ".join(s.split())
+def parse_amount(raw, fmt):
+    """Parse a feed amount using its declared format."""
+    if fmt == "v1":
+        return Decimal(clean_number(raw))
+    if fmt == "v2":
+        return Decimal(raw.strip())
+    raise ValueError("unsupported feed format: %r" % (fmt,))
diff --git a/tests/test_ingest.py b/tests/test_ingest.py
