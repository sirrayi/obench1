index 0000000..6e3725b
--- /dev/null
+++ b/tests/test_ingest.py
@@ -0,0 +1,36 @@
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from meridian.ingest import apac, eu
+
+
+class FeedFormats(unittest.TestCase):
+    def _feed(self, content):
+        handle = tempfile.NamedTemporaryFile("w", suffix=".csv", delete=False, encoding="utf-8")
+        self.addCleanup(os.unlink, handle.name)
+        with handle:
+            handle.write(content)
+        return handle.name
+
+    def test_eu_v2_amounts_are_plain_decimals(self):
+        path = self._feed("# format: v2\ndate;account;amount\n2026-10-01;AC-1;1425.01\n")
+        self.assertEqual(eu.read_feed(path)[0]["amount"], Decimal("1425.01"))
+
+    def test_eu_v1_amounts_are_localized(self):
+        path = self._feed("# format: v1\ndate;account;amount\n2026-09-01;AC-1;1.425,01\n")
+        self.assertEqual(eu.read_feed(path)[0]["amount"], Decimal("1425.01"))
+
+    def test_apac_v2_amounts_are_plain_decimals(self):
+        path = self._feed("# format: v2\ndate|account|amount\n2026-10-01|AC-1|1425.01\n")
+        self.assertEqual(apac.load(path)[0]["amount"], Decimal("1425.01"))
+
+    def test_apac_v1_amounts_are_localized(self):
+        path = self._feed("# format: v1\ndate|account|amount\n2026-09-01|AC-1|1 425,01\n")
+        self.assertEqual(apac.load(path)[0]["amount"], Decimal("1425.01"))
+
+    def test_unknown_format_is_rejected(self):
+        path = self._feed("# format: v3\ndate;account;amount\n2026-10-01;AC-1;1.00\n")
+        with self.assertRaises(ValueError):
+            eu.read_feed(path)
