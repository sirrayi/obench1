@@ -0,0 +1,29 @@
+import contextlib
+import io
+import os
+import unittest
+from decimal import Decimal
+
+from meridian.report import main, total
+
+FEEDS = os.path.join(os.path.dirname(__file__), "..", "feeds")
+
+
+class ReportTotals(unittest.TestCase):
+    def test_eu_october_uses_v2_amounts(self):
+        self.assertEqual(total("eu", "2026-10", FEEDS), Decimal("1774765.57"))
+
+    def test_eu_september_uses_v1_amounts(self):
+        self.assertEqual(total("eu", "2026-09", FEEDS), Decimal("1734482.25"))
+
+    def test_apac_october_uses_v2_amounts(self):
+        self.assertEqual(total("apac", "2026-10", FEEDS), Decimal("1787313.21"))
+
+    def test_apac_september_uses_v1_amounts(self):
+        self.assertEqual(total("apac", "2026-09", FEEDS), Decimal("1784764.94"))
+
+    def test_apac_october_command_matches_finance(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            main(["--region", "apac", "--month", "2026-10", "--feeds", FEEDS])
+        self.assertEqual(out.getvalue(), "1787313.21 SGD\n")
