 def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+    """Turn a localized (v1) amount into a plain decimal string.
+
+    v1 amounts group thousands with dots or spaces and use a decimal comma:
+    "1.234,56" and "1 234,56" both become "1234.56".
+    """
+    plain = "".join(raw.split())
+    return plain.replace(".", "").replace(",", ".")
 
 
