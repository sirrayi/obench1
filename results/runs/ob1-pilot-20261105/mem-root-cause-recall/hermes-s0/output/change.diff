@@ -0,0 +1,88 @@
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from meridian import report
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+FEEDS = os.path.join(REPO_ROOT, "feeds")
+
+
+def write_feed(root, region, name, lines):
+    directory = os.path.join(root, region)
+    os.makedirs(directory, exist_ok=True)
+    path = os.path.join(directory, name)
+    with open(path, "w", encoding="utf-8") as f:
+        f.write("\n".join(lines) + "\n")
+
+
+class T(unittest.TestCase):
+    def test_eu_v2_total_is_not_scaled(self):
+        # Regression: v2 exports use a plain decimal point. Parsing "1425.01"
+        # as a v1 grouped amount reported 100x the real total.
+        with tempfile.TemporaryDirectory() as root:
+            write_feed(root, "eu", "2026-10.csv", [
+                "# region: eu",
+                "# format: v2",
+                "date;account;amount",
+                "2026-10-03;AC-3413;1425.01",
+                "2026-10-08;AC-1205;856.98",
+            ])
+            self.assertEqual(report.total("eu", "2026-10", root), Decimal("2281.99"))
+
+    def test_eu_v1_total_still_parses_decimal_comma(self):
+        with tempfile.TemporaryDirectory() as root:
+            write_feed(root, "eu", "2026-09.csv", [
+                "# region: eu",
+                "# format: v1",
+                "date;account;amount",
+                "2026-09-27;AC-3239;4.014,05",
+                "2026-09-28;AC-3238;945,48",
+            ])
+            self.assertEqual(report.total("eu", "2026-09", root), Decimal("4959.53"))
+
+    def test_apac_v2_total_is_not_scaled(self):
+        with tempfile.TemporaryDirectory() as root:
+            write_feed(root, "apac", "2026-10.csv", [
+                "# region: apac",
+                "# format: v2",
+                "date|account|amount",
+                "2026-10-11|AC-1381|2641.49",
+                "2026-10-21|AC-2684|4995.20",
+            ])
+            self.assertEqual(report.total("apac", "2026-10", root), Decimal("7636.69"))
+
+    def test_unknown_format_version_is_rejected(self):
+        with tempfile.TemporaryDirectory() as root:
+            write_feed(root, "eu", "2026-11.csv", [
+                "# region: eu",
+                "# format: v3",
+                "date;account;amount",
+                "2026-11-01;AC-1;10.00",
+            ])
+            with self.assertRaises(ValueError):
+                report.total("eu", "2026-11", root)
+
+    def test_missing_format_header_is_rejected(self):
+        with tempfile.TemporaryDirectory() as root:
+            write_feed(root, "eu", "2026-11.csv", [
+                "# region: eu",
+                "date;account;amount",
+                "2026-11-01;AC-1;10.00",
+            ])
+            with self.assertRaises(ValueError):
+                report.total("eu", "2026-11", root)
+
+
+class ShippedFeedTotals(unittest.TestCase):
+    """End-to-end totals for the feeds finance reconciles against."""
+
+    def test_apac_october_matches_finance(self):
+        # Regression: October switched to v2 ("2641.49"). The v1 rule read the
+        # dot as a thousands separator and reported 178731321.00 instead of
+        # 1787313.21.
+        self.assertEqual(report.total("apac", "2026-10", FEEDS), Decimal("1787313.21"))
+
+    def test_apac_september_still_parses_v1_amounts(self):
+        self.assertEqual(report.total("apac", "2026-09", FEEDS), Decimal("1784764.94"))
