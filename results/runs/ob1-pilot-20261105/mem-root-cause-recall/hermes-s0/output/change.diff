 """Text helpers shared by the ingest readers."""
+from decimal import Decimal
 
+FORMAT_HEADER = "# format:"
 
-def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+
+def format_version(lines, source):
+    """Return the export format version declared in a feed's header."""
+    for line in lines:
+        if line.startswith(FORMAT_HEADER):
+            return line[len(FORMAT_HEADER):].strip()
+    raise ValueError("%s: missing '%s' header" % (source, FORMAT_HEADER))
+
+
+def parse_amount(raw, version):
+    """Parse a feed amount with the number convention of its export version.
+
+    v1 exports use a decimal comma and group thousands with "." or spaces
+    ("4.014,05", "1 114,82"). v2 exports use a plain decimal point and no
+    grouping ("4014.05").
+    """
+    amount = raw.strip()
+    if version == "v1":
+        return Decimal(amount.replace(" ", "").replace(".", "").replace(",", "."))
+    if version == "v2":
+        return Decimal(amount)
+    raise ValueError("unsupported feed format version: %r" % (version,))
 
 
