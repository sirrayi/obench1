diff --git a/sync.py b/sync.py
index c480a8d..4c97295 100644
--- a/sync.py
+++ b/sync.py
@@ -15,11 +15,15 @@ def plan(src, dst):
 
 
 def main(argv=None):
-    ap = argparse.ArgumentParser(description="Sycn a directory tree into another.")
+    ap = argparse.ArgumentParser(description="Sync a directory tree into another.")
     ap.add_argument("src")
     ap.add_argument("dst")
+    ap.add_argument("--dry-run", action="store_true", help="Print files that would be copied without copying them.")
     a = ap.parse_args(argv)
     for rel in sorted(plan(a.src, a.dst)):
+        if a.dry_run:
+            print(f"would copy {rel}")
+            continue
         os.makedirs(os.path.dirname(os.path.join(a.dst, rel)) or a.dst, exist_ok=True)
         shutil.copy2(os.path.join(a.src, rel), os.path.join(a.dst, rel))
 
