+    def test_dry_run_reports_files_without_copying(self):
+        with tempfile.TemporaryDirectory() as s, tempfile.TemporaryDirectory() as d:
+            os.makedirs(os.path.join(s, "a"))
+            open(os.path.join(s, "a", "x.txt"), "w").write("x")
+            out = io.StringIO()
+            with redirect_stdout(out):
+                sync.main(["--dry-run", s, d])
+            self.assertEqual(out.getvalue(), "would copy a/x.txt\n")
+            self.assertFalse(os.path.exists(os.path.join(d, "a", "x.txt")))
