@@ -0,0 +1,24 @@
+"""CSV export for invoices."""
+import csv
+import io
+
+from invoicer.money import line_total
+
+HEADER = ["item", "qty", "unit_price", "line_total"]
+
+
+def to_csv(invoice):
+    """Render one invoice as CSV: a header row, then one row per line."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(HEADER)
+    for line in invoice["lines"]:
+        writer.writerow(
+            [
+                line["item"],
+                line["qty"],
+                line["unit_price"],
+                f"{line_total(line['qty'], line['unit_price']):.2f}",
+            ]
+        )
+    return buf.getvalue()
