@@ -0,0 +1,42 @@
+import csv
+import io
+import unittest
+
+from invoicer.export import to_csv
+
+INVOICE = {
+    "client": "Brightwell",
+    "lines": [
+        {"item": "Design, phase 2", "qty": "2", "unit_price": "410.125"},
+        {"item": 'Review "final"', "qty": "1", "unit_price": "99.995"},
+    ],
+}
+
+
+class TestExport(unittest.TestCase):
+    def test_header_and_rows(self):
+        rows = list(csv.reader(io.StringIO(to_csv(INVOICE))))
+        self.assertEqual(rows[0], ["item", "qty", "unit_price", "line_total"])
+        self.assertEqual(
+            rows[1], ["Design, phase 2", "2", "410.125", "820.25"]
+        )
+        self.assertEqual(
+            rows[2], ['Review "final"', "1", "99.995", "100.00"]
+        )
+
+    def test_two_decimals_on_line_total(self):
+        invoice = {
+            "client": "Corvid Ltd",
+            "lines": [{"item": "Licences", "qty": "12", "unit_price": "8.3333"}],
+        }
+        rows = list(csv.reader(io.StringIO(to_csv(invoice))))
+        self.assertEqual(rows[1], ["Licences", "12", "8.3333", "100.00"])
+
+    def test_returns_string_and_ends_with_newline(self):
+        out = to_csv(INVOICE)
+        self.assertIsInstance(out, str)
+        self.assertTrue(out.endswith("\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
