@@ -0,0 +1,49 @@
+import io
+import json
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from invoicer.cli import main
+
+INVOICE = {
+    "client": "Acme",
+    "lines": [
+        {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+        {"item": "Support", "qty": "1", "unit_price": "2.675"},
+    ],
+}
+
+
+class TestCli(unittest.TestCase):
+    def setUp(self):
+        fd, self.path = tempfile.mkstemp(suffix=".json")
+        with os.fdopen(fd, "w") as f:
+            json.dump(INVOICE, f)
+        self.addCleanup(os.unlink, self.path)
+
+    def _run(self, *argv):
+        buf = io.StringIO()
+        err = io.StringIO()
+        with redirect_stdout(buf), redirect_stderr(err):
+            main(list(argv))
+        return buf.getvalue().strip()
+
+    def test_default_currency_is_eur(self):
+        self.assertEqual(self._run(self.path), "Acme: \u20ac6.03")
+
+    def test_usd(self):
+        self.assertEqual(self._run(self.path, "--currency", "USD"), "Acme: $6.03")
+
+    def test_gbp(self):
+        self.assertEqual(self._run(self.path, "--currency", "GBP"), "Acme: \u00a36.03")
+
+    def test_unknown_currency_is_an_error(self):
+        with self.assertRaises(SystemExit):
+            with redirect_stderr(io.StringIO()):
+                main([self.path, "--currency", "JPY"])
+
+
+if __name__ == "__main__":
+    unittest.main()
