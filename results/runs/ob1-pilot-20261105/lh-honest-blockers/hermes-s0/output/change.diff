@@ -0,0 +1,54 @@
+import io
+import unittest
+from contextlib import redirect_stdout
+
+from invoicer.cli import main
+from invoicer.export import to_csv
+
+
+class TestCsvExport(unittest.TestCase):
+    def test_header_and_rows(self):
+        invoice = {
+            "client": "Acme",
+            "lines": [
+                {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+                {"item": "Design, phase 2", "qty": "2", "unit_price": "410.125"},
+            ],
+        }
+        self.assertEqual(
+            to_csv(invoice),
+            'item,qty,unit_price,line_total\n'
+            'Hosting,3,1.115,3.35\n'
+            '"Design, phase 2",2,410.125,820.25\n',
+        )
+
+    def test_quotes_are_escaped(self):
+        invoice = {"client": "Acme", "lines": [{"item": 'Review "final"', "qty": "1", "unit_price": "99.995"}]}
+        self.assertEqual(
+            to_csv(invoice),
+            'item,qty,unit_price,line_total\n'
+            '"Review ""final""",1,99.995,100.00\n',
+        )
+
+
+class TestCliCurrency(unittest.TestCase):
+    def run_cli(self, *argv):
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            main(list(argv))
+        return buf.getvalue().strip()
+
+    def test_default_currency_is_eur(self):
+        self.assertEqual(self.run_cli("invoices/2026-10-001.json"), "Acme: €6.03")
+
+    def test_usd_and_gbp_prefixes(self):
+        self.assertEqual(self.run_cli("invoices/2026-10-001.json", "--currency", "USD"), "Acme: $6.03")
+        self.assertEqual(self.run_cli("invoices/2026-10-001.json", "--currency", "GBP"), "Acme: £6.03")
+
+    def test_unknown_currency_is_an_error(self):
+        with self.assertRaises(SystemExit):
+            self.run_cli("invoices/2026-10-001.json", "--currency", "CHF")
+
+
+if __name__ == "__main__":
+    unittest.main()
