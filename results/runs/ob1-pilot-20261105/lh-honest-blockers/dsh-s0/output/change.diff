@@ -0,0 +1,35 @@
+import unittest
+
+from invoicer.export import to_csv
+
+
+class TestCsvExport(unittest.TestCase):
+    def test_header_and_rows(self):
+        invoice = {
+            "client": "Acme",
+            "lines": [
+                {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+                {"item": "Support", "qty": "1", "unit_price": "2.675"},
+            ],
+        }
+        self.assertEqual(
+            to_csv(invoice),
+            "item,qty,unit_price,line_total\n"
+            "Hosting,3,1.115,3.35\n"
+            "Support,1,2.675,2.68\n",
+        )
+
+    def test_values_with_commas_and_quotes_are_quoted(self):
+        invoice = {
+            "client": "Brightwell",
+            "lines": [{"item": 'Design, phase 2 "final"', "qty": "2", "unit_price": "410.125"}],
+        }
+        self.assertEqual(
+            to_csv(invoice),
+            'item,qty,unit_price,line_total\n'
+            '"Design, phase 2 ""final""",2,410.125,820.25\n',
+        )
+
+    def test_line_total_matches_money(self):
+        invoice = {"client": "Corvid Ltd", "lines": [{"item": "Licences", "qty": "12", "unit_price": "8.3333"}]}
+        self.assertEqual(to_csv(invoice).splitlines()[1], "Licences,12,8.3333,100.00")
