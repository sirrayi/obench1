+import io
+import json
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+
+from invoicer.cli import main
+
+
+def _invoice_file(lines):
+    fd, path = tempfile.mkstemp(suffix=".json")
+    with os.fdopen(fd, "w") as f:
+        json.dump({"client": "Acme", "lines": lines}, f)
+    return path
+
+
+class TestCliCurrency(unittest.TestCase):
+    def setUp(self):
+        self.path = _invoice_file([{"item": "Hosting", "qty": "3", "unit_price": "1.115"}])
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def _run(self, *argv):
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            main(list(argv))
+        return buf.getvalue().strip()
+
+    def test_default_is_euro(self):
+        self.assertEqual(self._run(self.path), "Acme: €3.35")
+
+    def test_usd_and_gbp(self):
+        self.assertEqual(self._run(self.path, "--currency", "USD"), "Acme: $3.35")
+        self.assertEqual(self._run(self.path, "--currency", "GBP"), "Acme: £3.35")
+
+    def test_unknown_currency_is_an_error(self):
+        with self.assertRaises(SystemExit) as ctx:
+            self._run(self.path, "--currency", "JPY")
+        self.assertNotEqual(ctx.exception.code, 0)
