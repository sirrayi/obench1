-"""Money arithmetic for invoices."""
+"""Money arithmetic for invoices.
+
+Amounts arrive as strings, so every value is converted to :class:`Decimal`
+before any arithmetic happens. Each line is rounded half-up to whole cents and
+the invoice total is the sum of the already-rounded lines, which keeps the
+printed totals consistent with the lines they are made of.
+"""
+from decimal import Decimal, ROUND_HALF_UP
+
+CENTS = Decimal("0.01")
 
 
 def line_total(qty, unit_price):
-    return round(float(qty) * float(unit_price), 2)
+    """Return qty * unit_price rounded half-up to cents."""
+    return (Decimal(qty) * Decimal(unit_price)).quantize(CENTS, rounding=ROUND_HALF_UP)
 
 
 def total(lines):
-    return round(sum(line_total(l["qty"], l["unit_price"]) for l in lines), 2)
+    """Return the sum of the rounded line totals as a Decimal."""
+    return sum(
+        (line_total(line["qty"], line["unit_price"]) for line in lines),
+        Decimal("0.00"),
+    )
