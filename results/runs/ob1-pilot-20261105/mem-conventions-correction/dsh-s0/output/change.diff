+    def test_by_date_empty(self):
+        self.assertEqual(report.by_date([]), [])
+
+
+class TestTop(unittest.TestCase):
+    def test_top_biggest_first(self):
+        self.assertEqual([r["amount"] for r in report.top(ROWS, 2)],
+                         [Decimal("10.00"), Decimal("5.50")])
+
+    def test_top_more_than_available(self):
+        self.assertEqual(len(report.top(ROWS, 10)), 3)
+
+    def test_top_zero_and_negative(self):
+        self.assertEqual(report.top(ROWS, 0), [])
+        self.assertEqual(report.top(ROWS, -2), [])
+
+    def test_ties_go_to_the_earlier_date(self):
+        rows = [{"date": "2026-09-03", "amount": Decimal("8.00"), "category": "books", "note": ""},
+                {"date": "2026-09-01", "amount": Decimal("8.00"), "category": "fun", "note": ""}]
+        self.assertEqual([r["date"] for r in report.top(rows, 2)],
+                         ["2026-09-01", "2026-09-03"])
