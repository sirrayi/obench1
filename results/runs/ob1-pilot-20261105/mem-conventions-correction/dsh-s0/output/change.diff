+    def test_by_date_keeps_file_order_on_one_date(self):
+        rows = [{"date": "2026-09-01", "amount": Decimal("10.00"), "category": "food", "note": ""},
+                {"date": "2026-09-01", "amount": Decimal("2.25"), "category": "books", "note": ""},
+                {"date": "2026-09-01", "amount": Decimal("5.50"), "category": "travel", "note": ""}]
