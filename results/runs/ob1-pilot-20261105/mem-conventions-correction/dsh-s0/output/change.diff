+
+
+def by_date(rows):
+    """Every expense, oldest first; same-date expenses keep their file order."""
+    return sorted(rows, key=lambda r: r["date"])
+
+
+def top(rows, n):
+    """The n largest expenses, biggest first; ties go to the earlier date."""
+    if n <= 0:
+        return []
+    return sorted(rows, key=lambda r: (-r["amount"], r["date"]))[:n]
