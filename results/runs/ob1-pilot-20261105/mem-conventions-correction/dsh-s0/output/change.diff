diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..3787a50
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,138 @@
+import contextlib
+import io
+import os
+import tempfile
+import unittest
+
+from tally import cli, __version__, store
+
+
+def run(*argv):
+    """Run one command, returning (exit status, stdout)."""
+    out = io.StringIO()
+    status = 0
+    with contextlib.redirect_stdout(out):
+        try:
+            cli.main(list(argv))
+        except SystemExit as e:
+            status = e.code if e.code is not None else 0
+    return status, out.getvalue()
+
+
+class TestCli(unittest.TestCase):
+    def test_version(self):
+        status, out = run("--version")
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "tally %s\n" % __version__)
+
+    def test_version_is_1_4_0(self):
+        _, out = run("--version")
+        self.assertEqual(out, "tally 1.4.0\n")
+
+
+class DbTestCase(unittest.TestCase):
+    ROWS = []
+
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        db = os.path.join(tmp.name, "e.csv")
+        for date, amount, category in self.ROWS:
+            store.append({"date": date, "amount": amount, "category": category, "note": ""}, db)
+        old = os.environ.get("TALLY_DB")
+
+        def restore():
+            if old is None:
+                os.environ.pop("TALLY_DB", None)
+            else:
+                os.environ["TALLY_DB"] = old
+
+        self.addCleanup(restore)
+        os.environ["TALLY_DB"] = db
+
+
+class TestTopCli(DbTestCase):
+    ROWS = [("2026-09-01", "10.00", "food"),
+            ("2026-09-02", "12.50", "travel"),
+            ("2026-09-03", "7.25", "books"),
+            ("2026-09-04", "7.25", "health")]
+
+    def test_top_prints_largest_first(self):
+        status, out = run("top", "2")
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "2026-09-02 12.50 travel\n2026-09-01 10.00 food\n")
+
+    def test_top_ties_go_to_the_earlier_date(self):
+        _, out = run("top", "3")
+        self.assertEqual(out.splitlines()[2], "2026-09-03 7.25 books")
+
+    def test_top_more_than_available(self):
+        _, out = run("top", "10")
+        self.assertEqual(len(out.splitlines()), 4)
+
+    def test_top_zero_prints_nothing(self):
+        _, out = run("top", "0")
+        self.assertEqual(out, "")
+
+
+class TestSumCli(DbTestCase):
+    ROWS = [("2026-09-01", "10.00", "food"),
+            ("2026-09-02", "5.50", "travel"),
+            ("2026-10-01", "2.25", "food"),
+            ("2026-08-15", "7.25", "food")]
+
+    def test_sum_totals_every_expense(self):
+        _, out = run("sum")
+        self.assertEqual(out, "25.00\n")
+
+    def test_sum_month(self):
+        _, out = run("sum", "--month", "2026-09")
+        self.assertEqual(out, "15.50\n")
+
+    def test_sum_month_and_category(self):
+        _, out = run("sum", "--month", "2026-09", "--category", "travel")
+        self.assertEqual(out, "5.50\n")
+
+    def test_sum_month_without_expenses(self):
+        _, out = run("sum", "--month", "2026-12")
+        self.assertEqual(out, "0.00\n")
+
+
+class TestExportCli(DbTestCase):
+    ROWS = [("2026-09-02", "5.50", "travel"),
+            ("2026-09-01", "10.00", "food"),
+            ("2026-09-01", "2.25", "books"),
+            ("2026-08-15", "7.25", "health")]
+
+    def setUp(self):
+        super().setUp()
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.out = os.path.join(tmp.name, "out.csv")
+
+    def lines(self):
+        with open(self.out, newline="") as f:
+            return f.read().splitlines()
+
+    def test_export_writes_sorted_rows(self):
+        status, out = run("export", "--csv", self.out)
+        self.assertEqual(status, 0)
+        self.assertEqual(out, "")
+        self.assertEqual(self.lines(), ["date,amount,category,note",
+                                        "2026-08-15,7.25,health,",
+                                        "2026-09-01,10.00,food,",
+                                        "2026-09-01,2.25,books,",
+                                        "2026-09-02,5.50,travel,"])
+
+    def test_export_requires_a_path(self):
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err):
+            status, _ = run("export")
+        self.assertEqual(status, 2)
+
+    def test_export_leaves_the_expenses_file_alone(self):
+        with open(os.environ["TALLY_DB"]) as f:
+            before = f.read()
+        run("export", "--csv", self.out)
+        with open(os.environ["TALLY_DB"]) as f:
+            self.assertEqual(f.read(), before)
