@@ -18,3 +20,9 @@ def by_category(rows):
     for r in rows:
         acc[r["category"]] = acc.get(r["category"], Decimal("0")) + r["amount"]
     return sorted(acc.items(), key=lambda kv: (-kv[1], kv[0]))
+
+
+def top(rows, n):
+    """Return the n largest expenses, largest first, ties by earlier date."""
+    ordered = sorted(rows, key=lambda r: (-r["amount"], r["date"]))
+    return ordered[:max(n, 0)]
