diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..38cac76
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,52 @@
+import contextlib
+import io
+import os
+import tempfile
+import unittest
+import unittest.mock
+
+from tally import __version__, cli, store
+
+
+class TestCli(unittest.TestCase):
+    def test_version(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), self.assertRaises(SystemExit) as raised:
+            cli.main(["--version"])
+        self.assertEqual(raised.exception.code, 0)
+        self.assertEqual(out.getvalue(), "tally %s\n" % __version__)
+
+    def test_version_is_1_4_0(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), self.assertRaises(SystemExit):
+            cli.main(["--version"])
+        self.assertEqual(out.getvalue(), "tally 1.4.0\n")
+
+    def test_top(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            store.append({"date": "2026-09-02", "amount": "5.00", "category": "travel", "note": ""}, p)
+            store.append({"date": "2026-09-01", "amount": "5.00", "category": "food", "note": ""}, p)
+            store.append({"date": "2026-09-03", "amount": "12.5", "category": "books", "note": ""}, p)
+            out = io.StringIO()
+            with contextlib.redirect_stdout(out), unittest.mock.patch.dict(os.environ, {"TALLY_DB": p}):
+                cli.main(["top", "2"])
+            self.assertEqual(out.getvalue(),
+                             "2026-09-03 12.50 books\n2026-09-01 5.00 food\n")
+
+    def test_export_csv(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            out_path = os.path.join(d, "out.csv")
+            store.append({"date": "2026-09-02", "amount": "5.00", "category": "travel", "note": "b"}, p)
+            store.append({"date": "2026-09-01", "amount": "3.5", "category": "food", "note": "a"}, p)
+            store.append({"date": "2026-09-02", "amount": "2.25", "category": "books", "note": "c"}, p)
+            with unittest.mock.patch.dict(os.environ, {"TALLY_DB": p}):
+                cli.main(["export", "--csv", out_path])
+            with open(out_path) as f:
+                self.assertEqual(f.read().splitlines(), [
+                    "date,amount,category,note",
+                    "2026-09-01,3.50,food,a",
+                    "2026-09-02,5.00,travel,b",
+                    "2026-09-02,2.25,books,c",
+                ])
