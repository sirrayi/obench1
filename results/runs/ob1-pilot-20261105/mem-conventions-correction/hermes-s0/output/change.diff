@@ -0,0 +1,83 @@
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+
+from tally import cli
+
+
+class TestCli(unittest.TestCase):
+    def test_version_flag(self):
+        out = io.StringIO()
+        with redirect_stdout(out), self.assertRaises(SystemExit) as raised:
+            cli.main(["--version"])
+        self.assertEqual(raised.exception.code, 0)
+        self.assertEqual(out.getvalue(), "tally 1.4.0\n")
+
+    def test_top_prints_largest_first(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            with open(p, "w") as f:
+                f.write("date,amount,category,note\n"
+                        "2026-09-02,5.50,travel,\n"
+                        "2026-09-01,12.00,food,\n"
+                        "2026-09-03,12.00,rent,\n")
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                out = io.StringIO()
+                with redirect_stdout(out):
+                    cli.main(["top", "2"])
+            finally:
+                if old is None:
+                    os.environ.pop("TALLY_DB", None)
+                else:
+                    os.environ["TALLY_DB"] = old
+        self.assertEqual(out.getvalue(), "2026-09-01 12.00 food\n2026-09-03 12.00 rent\n")
+
+    def test_sum_month_only_counts_that_month(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            with open(p, "w") as f:
+                f.write("date,amount,category,note\n"
+                        "2026-09-02,5.50,travel,\n"
+                        "2026-09-01,12.00,food,\n"
+                        "2026-10-01,2.25,food,\n")
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                out = io.StringIO()
+                with redirect_stdout(out):
+                    cli.main(["sum", "--month", "2026-09"])
+            finally:
+                if old is None:
+                    os.environ.pop("TALLY_DB", None)
+                else:
+                    os.environ["TALLY_DB"] = old
+        self.assertEqual(out.getvalue(), "17.50\n")
+
+    def test_export_writes_dated_csv_to_path(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            out_path = os.path.join(d, "out.csv")
+            with open(p, "w") as f:
+                f.write("date,amount,category,note\n"
+                        "2026-09-02,5.5,travel,\n"
+                        "2026-09-01,12,food,first\n"
+                        "2026-09-02,1.25,travel,second\n")
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                cli.main(["export", "--csv", out_path])
+            finally:
+                if old is None:
+                    os.environ.pop("TALLY_DB", None)
+                else:
+                    os.environ["TALLY_DB"] = old
+            with open(out_path, newline="") as f:
+                text = f.read()
+        self.assertEqual(text, "date,amount,category,note\r\n"
+                               "2026-09-01,12.00,food,first\r\n"
+                               "2026-09-02,5.50,travel,\r\n"
+                               "2026-09-02,1.25,travel,second\r\n")
