 """Totals and breakdowns."""
+import csv
 from decimal import Decimal
 
+from tally.store import FIELDS
+
 
 def total(rows, month=None, category=None):
     """Sum the amounts, optionally for one month (YYYY-MM) and one category."""
     out = Decimal("0")
     for r in rows:
+        if month and r["date"][:7] != month:
+            continue
         if category and r["category"] != category:
             continue
         out += r["amount"]
     return out
 
 
+def top(rows, n):
+    """Return the n largest expenses, largest first, earlier date breaking ties."""
+    return sorted(rows, key=lambda r: (-r["amount"], r["date"]))[:max(n, 0)]
+
+
+def export_csv(rows, path):
+    """Write expenses to path, sorted by date, with amounts to 2 decimals."""
+    with open(path, "w", newline="") as f:
+        w = csv.DictWriter(f, FIELDS)
+        w.writeheader()
+        for r in sorted(rows, key=lambda r: r["date"]):
+            w.writerow({"date": r["date"], "amount": "%.2f" % r["amount"],
+                        "category": r["category"], "note": r["note"]})
+
+
