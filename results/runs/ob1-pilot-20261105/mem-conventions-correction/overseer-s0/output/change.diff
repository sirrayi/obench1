+                {"date": "2026-08-31", "amount": Decimal("1.00"), "category": "a", "note": ""},
+                {"date": "2026-09-01", "amount": Decimal("3.00"), "category": "c", "note": ""}]
+        self.assertEqual([r["category"] for r in report.by_date(rows)], ["a", "b", "c"])
+
+    def test_by_date_does_not_mutate(self):
+        rows = list(reversed(ROWS))
