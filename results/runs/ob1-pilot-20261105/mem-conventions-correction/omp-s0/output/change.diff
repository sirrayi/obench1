@@ -0,0 +1,14 @@
+"""Export expenses to other formats."""
+import csv
+from decimal import Decimal
+
+from tally import store
+
+
+def write_csv(rows, path):
+    """Write the expenses to path sorted by date, keeping file order for equal dates."""
+    with open(path, "w", newline="") as f:
+        w = csv.DictWriter(f, store.FIELDS)
+        w.writeheader()
+        for r in sorted(rows, key=lambda r: r["date"]):
+            w.writerow(dict(r, amount="{:.2f}".format(Decimal(r["amount"]))))
