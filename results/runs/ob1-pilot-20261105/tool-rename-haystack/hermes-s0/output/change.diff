diff --git a/RENAME-ADDENDUM.md b/RENAME-ADDENDUM.md
new file mode 100644
index 0000000..39840e8
--- /dev/null
+++ b/RENAME-ADDENDUM.md
@@ -0,0 +1,8 @@
+# Rename addendum (agreed in review)
+
+While we're in there: `load_account`'s keyword `include_deleted` becomes `with_deleted`.
+
+- Every call site passes `with_deleted` (that includes partials and keyword dicts).
+- `load_account` doesn't accept `include_deleted` at all.
+- The deprecated `fetch_user` wrapper keeps accepting `include_deleted` and passes it on as `with_deleted`.
+- docs/API.md shows the new keyword.
diff --git a/docs/API.md b/docs/API.md
index 3b5c6c5..8199c42 100644
--- a/docs/API.md
+++ b/docs/API.md
@@ -1,9 +1,9 @@
 # harbor API
 
-### accounts.fetch_user(user_id, *, include_deleted=False)
+### accounts.load_account(user_id, *, with_deleted=False)
 
 The account for `user_id` as a dict (`id`, `name`, `tier`, `deleted`), or `None` if the account was deleted and
-`include_deleted` is false. Raises `ValueError` for ids that aren't positive integers.
+`with_deleted` is false. Raises `ValueError` for ids that aren't positive integers.
 
 ### accounts.fetch_user_count()
 
diff --git a/harbor/accounts/__init__.py b/harbor/accounts/__init__.py
index bf65805..0a88a09 100644
--- a/harbor/accounts/__init__.py
+++ b/harbor/accounts/__init__.py
@@ -1,20 +1,28 @@
 """Accounts: the account store."""
 
-__all__ = ["fetch_user", "fetch_user_count", "account_tiers"]
+import warnings
+
+__all__ = ["load_account", "fetch_user_count", "account_tiers"]
 
 TIERS = ("free", "pro", "team")
 
 
-def fetch_user(user_id, *, include_deleted=False):
+def load_account(user_id, *, with_deleted=False):
     """The account for user_id, or None if it was deleted (unless deleted ones are asked for)."""
     if not isinstance(user_id, int) or isinstance(user_id, bool) or user_id <= 0:
         raise ValueError(f"bad user id: {user_id!r}")
     deleted = user_id % 7 == 0
-    if deleted and not include_deleted:
+    if deleted and not with_deleted:
         return None
     return {"id": user_id, "name": f"user{user_id}", "tier": TIERS[user_id % 3], "deleted": deleted}
 
 
+def fetch_user(user_id, *, include_deleted=False):
+    """Deprecated alias for load_account; removal in 4.0."""
+    warnings.warn("fetch_user is deprecated, use load_account (removal in 4.0)", DeprecationWarning, stacklevel=2)
+    return load_account(user_id, with_deleted=include_deleted)
+
+
 def fetch_user_count():
     """How many accounts exist."""
     return 4242
