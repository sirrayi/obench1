diff --git a/tests/test_edge.py b/tests/test_edge.py
index 6432c82..b4bbab1 100644
--- a/tests/test_edge.py
+++ b/tests/test_edge.py
@@ -1,11 +1,52 @@
 import json
 import unittest
+from typing import Dict, Optional
 
 from edge import uploader
 
 
+def _reading(ts: str, sensor: str, temp: Optional[float]) -> Dict:
+    return {"ts": ts, "sensor": sensor, "temp": temp}
+
+
 class TestUploader(unittest.TestCase):
     def test_upload(self):
         out = uploader.upload([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
         self.assertEqual(out["sent"], 1)
         self.assertEqual(json.loads(out["payload"])["readings"][0][1], "a1")
+
+    def test_skips_missing_temperature(self):
+        out = uploader.upload([
+            _reading("2026-10-01T09:00:00", "a1", 20.0),
+            _reading("2026-10-01T10:00:00", "a2", None),
+        ])
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(
+            json.loads(out["payload"])["readings"],
+            [["2026-10-01T09:00:00", "a1", 20.0]],
+        )
+
+    def test_no_skips(self):
+        out = uploader.upload([_reading("2026-10-01T09:00:00", "a1", 20.0)])
+        self.assertEqual(out["skipped"], 0)
+
+    def test_since_drops_earlier_days(self):
+        out = uploader.upload([
+            _reading("2026-09-30T23:59:59", "a1", 19.0),
+            _reading("2026-10-01T00:00:00", "a2", 20.0),
+        ], since="2026-10-01")
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(json.loads(out["payload"])["readings"][0][1], "a2")
+
+    def test_dropped_readings_are_not_skipped(self):
+        out = uploader.upload([
+            _reading("2026-09-30T23:59:59", "a1", None),
+            _reading("2026-10-01T09:00:00", "a2", 20.0),
+        ], since="2026-10-01")
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 0)
+
+    def test_since_must_be_a_day(self):
+        with self.assertRaises(ValueError):
+            uploader.upload([], since="2026-10")
