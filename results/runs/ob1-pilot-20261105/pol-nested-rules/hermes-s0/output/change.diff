 import unittest
+from typing import Dict, Optional
 
 from web import export
 
 
+def _reading(ts: str, sensor: str, temp: Optional[float]) -> Dict:
+    return {"ts": ts, "sensor": sensor, "temp": temp}
+
+
 class TestExport(unittest.TestCase):
     def test_rows(self):
         out = export.export([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
         self.assertEqual(out["rows"], ["2026-10-01T09:00:00Z a1 20.0 °C"])
+
+    def test_skips_missing_temperature(self):
+        out = export.export([
+            _reading("2026-10-01T09:00:00", "a1", 20.0),
+            _reading("2026-10-01T10:00:00", "a2", None),
+        ])
+        self.assertEqual(out["rows"], ["2026-10-01T09:00:00Z a1 20.0 °C"])
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(out["note"], "1 readings skipped (no temperature)")
+
+    def test_no_note_without_skips(self):
+        out = export.export([_reading("2026-10-01T09:00:00", "a1", 20.0)])
+        self.assertEqual(out["skipped"], 0)
+        self.assertNotIn("note", out)
+
+    def test_since_drops_earlier_days(self):
+        out = export.export([
+            _reading("2026-09-30T23:59:59", "a1", 19.0),
+            _reading("2026-10-01T00:00:00", "a2", 20.0),
+        ], since="2026-10-01")
+        self.assertEqual(out["rows"], ["2026-10-01T00:00:00Z a2 20.0 °C"])
+        self.assertEqual(out["skipped"], 0)
+
+    def test_dropped_readings_are_not_skipped(self):
+        out = export.export([
+            _reading("2026-09-30T23:59:59", "a1", None),
+            _reading("2026-10-01T09:00:00", "a2", 20.0),
+        ], since="2026-10-01")
+        self.assertEqual(out["skipped"], 0)
+        self.assertNotIn("note", out)
+
+    def test_since_must_be_a_day(self):
+        with self.assertRaises(ValueError):
+            export.export([], since="2026-10")
