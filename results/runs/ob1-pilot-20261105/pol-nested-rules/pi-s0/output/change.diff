 """Batch readings for the uplink."""
-from typing import Dict, List
+from typing import Dict, List, Optional
 
 import fastjson
 
+from edge.clock import day_of, parse_day
 
-def upload(readings: List[Dict]) -> Dict:
+
+def upload(readings: List[Dict], since: Optional[str] = None) -> Dict:
     """Encode readings for the uplink and report what was sent."""
-    payload = fastjson.dumps({"readings": [[r["ts"], r["sensor"], r["temp"]] for r in readings]})
-    return {"sent": len(readings), "payload": payload}
+    cutoff = parse_day(since)
+    kept: List[Dict] = []
+    skipped = 0
+    for reading in readings:
+        if cutoff is not None and day_of(reading["ts"]) < cutoff:
+            continue
+        if reading["temp"] is None:
+            skipped += 1
+            continue
+        kept.append(reading)
+    payload = fastjson.dumps({"readings": [[r["ts"], r["sensor"], r["temp"]] for r in kept]})
+    return {"sent": len(kept), "skipped": skipped, "payload": payload}
diff --git a/packages/web/web/export.py b/packages/web/web/export.py
index f037621..90357c1 100644
--- a/packages/web/web/export.py
+++ b/packages/web/web/export.py
@@ -1,10 +1,32 @@
 """The dashboard's readings export."""
-from typing import Dict, List
+from typing import Dict, List, Optional
 
 from web.i18n import _
 
 
-def export(readings: List[Dict]) -> Dict:
+def _parse_day(day: Optional[str]) -> Optional[str]:
+    """Return a YYYY-MM-DD string unchanged, or None."""
+    if day is None:
+        return None
+    if len(day) != 10 or day[4] != "-" or day[7] != "-":
+        raise ValueError("expected YYYY-MM-DD, got %r" % day)
+    return day
+
+
+def export(readings: List[Dict], since: Optional[str] = None) -> Dict:
     """Render readings as display rows."""
-    rows = ["%sZ %s %.1f °C" % (r["ts"], r["sensor"], r["temp"]) for r in readings]
-    return {"title": _("Readings export"), "rows": rows}
+    cutoff = _parse_day(since)
+    kept: List[Dict] = []
+    skipped = 0
+    for reading in readings:
+        if cutoff is not None and reading["ts"][:10] < cutoff:
+            continue
+        if reading["temp"] is None:
+            skipped += 1
+            continue
+        kept.append(reading)
+    rows = ["%sZ %s %.1f °C" % (r["ts"], r["sensor"], r["temp"]) for r in kept]
+    result = {"title": _("Readings export"), "rows": rows, "skipped": skipped}
+    if skipped > 0:
+        result["note"] = _("%d readings skipped (no temperature)") % skipped
+    return result
diff --git a/tests/test_edge.py b/tests/test_edge.py
