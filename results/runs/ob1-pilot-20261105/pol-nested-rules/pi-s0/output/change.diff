@@ -5,7 +5,29 @@ from edge import uploader
 
 
 class TestUploader(unittest.TestCase):
-    def test_upload(self):
+    def test_upload(self) -> None:
         out = uploader.upload([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
         self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 0)
         self.assertEqual(json.loads(out["payload"])["readings"][0][1], "a1")
+
+    def test_upload_skips_missing_temperature(self) -> None:
+        out = uploader.upload([
+            {"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": None},
+            {"ts": "2026-10-01T10:00:00", "sensor": "a2", "temp": 21.0},
+        ])
+        expected = [["2026-10-01T10:00:00", "a2", 21.0]]
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(json.loads(out["payload"])["readings"], expected)
+
+    def test_upload_since_drops_old_readings_before_counting_skips(self) -> None:
+        out = uploader.upload([
+            {"ts": "2026-09-30T09:00:00", "sensor": "a1", "temp": None},
+            {"ts": "2026-10-01T09:00:00", "sensor": "a2", "temp": None},
+            {"ts": "2026-10-02T09:00:00", "sensor": "a3", "temp": 22.0},
+        ], since="2026-10-01")
+        expected = [["2026-10-02T09:00:00", "a3", 22.0]]
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(json.loads(out["payload"])["readings"], expected)
