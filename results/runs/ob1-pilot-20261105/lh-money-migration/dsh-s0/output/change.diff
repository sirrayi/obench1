diff --git a/tools/migrate_packages.py b/tools/migrate_packages.py
new file mode 100644
index 0000000..25ebed0
--- /dev/null
+++ b/tools/migrate_packages.py
@@ -0,0 +1,108 @@
+"""One-shot codemod: move ledgerly package modules from float money to Money."""
+import pathlib
+import re
+
+MODES = {
+    "billing": "ROUND_HALF_UP",
+    "export": "ROUND_HALF_UP",
+    "fx": "ROUND_HALF_EVEN",
+    "interest": "ROUND_HALF_EVEN",
+    "invoices": "ROUND_HALF_UP",
+    "payouts": "ROUND_HALF_EVEN",
+    "refunds": "ROUND_DOWN",
+    "reports": "ROUND_HALF_UP",
+    "tax": "ROUND_HALF_UP",
+}
+
+DOC_OLD = "Money amounts are floats for now (see MIGRATION.md)."
+DOC_NEW = "Money amounts are exact `Money` values; rates are `Decimal`."
+
+SUBS = [
+    ("return round_money(amount * RATES[(src, dst)], dst)",
+     "return (amount * RATES[(src, dst)]).round({mode})"),
+    ("return round_money(amount * RATES[(src, dst)] * (1 - spread_bp / 10000), dst)",
+     "return (amount * RATES[(src, dst)] * (Decimal(1) - Decimal(spread_bp) / Decimal(10000))).round({mode})"),
+    ("return round_money(balance * annual_rate / 100 * days / 365, currency)",
+     "return (balance * annual_rate / 100 * days / 365).round({mode})"),
+    ("return round_money(amount * factor, currency)",
+     "return (amount * factor).round({mode})"),
+    ("return round_money(amount * pct / 100, currency)",
+     "return (amount * pct / 100).round({mode})"),
+    ("return gross - round_money(gross * pct / 100, currency)",
+     "return gross - (gross * pct / 100).round({mode})"),
+    ("return min(round_money(amount * pct / 100, currency), cap)",
+     "return min((amount * pct / 100).round({mode}), cap)"),
+    ("share = round_money(amount / parts, currency)",
+     "share = (amount / parts).round({mode})"),
+    ("return [share] * (parts - 1) + [round_money(amount - share * (parts - 1), currency)]",
+     "return [share] * (parts - 1) + [(amount - share * (parts - 1)).round({mode})]"),
+    ("return round_money(sum(amounts), currency)",
+     "return Money.sum(amounts, currency).round({mode})"),
+    ("return abs(paid - due) < 0.005",
+     "return paid == due"),
+    ('return "%.*f %s" % (EXPONENT[currency], amount, currency)',
+     'return "%s %s" % (format(amount.round({mode}).amount, ".%df" % EXPONENT[currency]), currency)'),
+    ('out.append("%s,%s,%.*f,%s\\n" % (day, memo, EXPONENT[currency], amount, currency))',
+     'out.append("%s,%s,%s,%s\\n" % (day, memo, format(amount.round({mode}).amount, ".%df" % EXPONENT[currency]), currency))'),
+    ("total = round_money(sum(a for _, a in lines), currency)",
+     "total = Money.sum((a for _, a in lines), currency).round({mode})"),
+    ('"lines": [{"sku": s, "amount": round_money(a, currency)} for s, a in lines],',
+     '"lines": [{"sku": s, "amount": a.round({mode}).to_json()} for s, a in lines],'),
+    ('"total": total}',
+     '"total": total.to_json()}'),
+    ("return round(amount * RATES[(src, dst)], EXPONENT[dst])",
+     "return round(amount * float(RATES[(src, dst)]), EXPONENT[dst])"),
+]
+
+
+def rebuild_header(lines, mode, has_rates, needs_decimal, has_exponent):
+    if lines[0].count('"""') >= 2:
+        doc_end = 0
+    else:
+        doc_end = 1
+        while '"""' not in lines[doc_end]:
+            doc_end += 1
+    log_i = next(i for i, l in enumerate(lines) if l.startswith("log = logging.getLogger"))
+    old = lines[doc_end + 1:log_i]
+    stdlib = [l for l in old if re.match(r"^import ", l)]
+    block = "".join(stdlib)
+    if needs_decimal:
+        block += "from decimal import Decimal, %s\n" % mode
+    else:
+        block += "from decimal import %s\n" % mode
+    block += "\n"
+    if has_rates:
+        block += "from ledgerly._gen.rates_table import RATES\n"
+    block += "from ledgerly.money import Money\n"
+    if has_exponent:
+        block += "from ledgerly.util import EXPONENT\n"
+    block += "\n"
+    return lines[:doc_end + 1] + [block] + lines[log_i:]
+
+
+def main():
+    for path in sorted(pathlib.Path("ledgerly").glob("*/*.py")):
+        package = path.parent.name
+        if package == "_gen":
+            continue
+        src = path.read_text(encoding="utf-8")
+        if "MoneyF" not in src:
+            continue
+        mode = MODES[package]
+        src = src.replace(DOC_OLD, DOC_NEW)
+        for old, new in SUBS:
+            src = src.replace(old, new.replace("{mode}", mode))
+        src = src.replace("MoneyF", "Money").replace("Rate", "Decimal")
+        lines = src.splitlines(keepends=True)
+        needs_decimal = bool(re.search(r"Decimal\(", src)) or ": Decimal" in src or "-> Decimal" in src
+        lines = rebuild_header(lines, mode, "RATES" in src, needs_decimal, "EXPONENT" in src)
+        src = "".join(lines)
+        if "round_money" in src:
+            raise SystemExit("leftover round_money in %s" % path)
+        if "0.005" in src:
+            raise SystemExit("leftover tolerance in %s" % path)
+        path.write_text(src, encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
