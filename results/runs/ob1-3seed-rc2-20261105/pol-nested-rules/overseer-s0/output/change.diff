+        ], since="2026-10-01")
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 0)
diff --git a/tests/test_web.py b/tests/test_web.py
index fb32a8b..68d888e 100644
--- a/tests/test_web.py
+++ b/tests/test_web.py
@@ -7,3 +7,26 @@ class TestExport(unittest.TestCase):
     def test_rows(self):
         out = export.export([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
         self.assertEqual(out["rows"], ["2026-10-01T09:00:00Z a1 20.0 °C"])
+
+    def test_skips_readings_without_temperature(self) -> None:
+        out = export.export([
+            {"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0},
+            {"ts": "2026-10-01T09:05:00", "sensor": "a2", "temp": None},
+        ])
+        self.assertEqual(out["rows"], ["2026-10-01T09:00:00Z a1 20.0 °C"])
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(out["note"], "1 readings skipped (no temperature)")
+
+    def test_no_note_when_nothing_is_skipped(self) -> None:
+        out = export.export([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
+        self.assertEqual(out["skipped"], 0)
