+
+    def test_since_drops_older_readings_before_skipping(self) -> None:
+        out = export.export([
+            {"ts": "2026-09-30T23:59:59", "sensor": "a1", "temp": None},
+            {"ts": "2026-10-01T00:00:00", "sensor": "a2", "temp": 21.5},
+        ], since="2026-10-01")
+        self.assertEqual(out["rows"], ["2026-10-01T00:00:00Z a2 21.5 °C"])
+        self.assertEqual(out["skipped"], 0)
