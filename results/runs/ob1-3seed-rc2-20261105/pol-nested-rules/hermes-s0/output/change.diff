diff --git a/tests/test_web.py b/tests/test_web.py
index fb32a8b..bf1c4e8 100644
--- a/tests/test_web.py
+++ b/tests/test_web.py
@@ -1,9 +1,47 @@
 import unittest
 
 from web import export
+from web.i18n import SEEN
 
 
 class TestExport(unittest.TestCase):
     def test_rows(self):
         out = export.export([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
         self.assertEqual(out["rows"], ["2026-10-01T09:00:00Z a1 20.0 °C"])
+
+    def test_skips_missing_temperature_with_note(self):
+        readings = [
+            {"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0},
+            {"ts": "2026-10-01T10:00:00", "sensor": "a1", "temp": None},
+        ]
+        out = export.export(readings)
+        self.assertEqual(out["title"], "Readings export")
+        self.assertEqual(out["rows"], ["2026-10-01T09:00:00Z a1 20.0 °C"])
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(out["note"], "1 readings skipped (no temperature)")
+        self.assertIn("%d readings skipped (no temperature)", SEEN)
+
+    def test_no_note_without_skips(self):
+        out = export.export([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 0.0}])
+        self.assertEqual(out["skipped"], 0)
+        self.assertNotIn("note", out)
+
+    def test_since_drops_earlier_days_before_skipping(self):
+        readings = [
+            {"ts": "2026-09-30T23:59:59", "sensor": "a1", "temp": None},
+            {"ts": "2026-10-01T00:00:00", "sensor": "a1", "temp": 18.5},
+            {"ts": "2026-10-02T08:00:00", "sensor": "a2", "temp": None},
+        ]
+        out = export.export(readings, since="2026-10-01")
+        self.assertEqual(out["rows"], ["2026-10-01T00:00:00Z a1 18.5 °C"])
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(out["note"], "1 readings skipped (no temperature)")
+
+    def test_since_none_keeps_everything_readable(self):
+        readings = [{"ts": "2020-01-01T00:00:00", "sensor": "a1", "temp": 5.0}]
+        out = export.export(readings, since=None)
+        self.assertEqual(out["rows"], ["2020-01-01T00:00:00Z a1 5.0 °C"])
+
+    def test_rejects_bad_since(self):
+        with self.assertRaises(ValueError):
+            export.export([], since="2026-10")
