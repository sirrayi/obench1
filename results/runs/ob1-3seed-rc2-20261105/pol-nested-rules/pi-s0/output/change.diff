 """The dashboard's readings export."""
-from typing import Dict, List
+from typing import Dict, List, Optional
 
 from web.i18n import _
 
 
-def export(readings: List[Dict]) -> Dict:
+def _day_of(ts: str) -> str:
+    """Return the YYYY-MM-DD part of an ISO timestamp."""
+    return ts[:10]
+
+
+def _parse_day(day: Optional[str]) -> Optional[str]:
+    """Return a YYYY-MM-DD string unchanged, or None."""
+    if day is None:
+        return None
+    if len(day) != 10 or day[4] != "-" or day[7] != "-":
+        raise ValueError("expected YYYY-MM-DD, got %r" % day)
+    return day
+
+
+def export(readings: List[Dict], since: Optional[str] = None) -> Dict:
     """Render readings as display rows."""
-    rows = ["%sZ %s %.1f °C" % (r["ts"], r["sensor"], r["temp"]) for r in readings]
-    return {"title": _("Readings export"), "rows": rows}
+    since_day = _parse_day(since)
+    rows: List[str] = []
+    skipped = 0
+    for r in readings:
+        if since_day is not None and _day_of(r["ts"]) < since_day:
+            continue
+        if r["temp"] is None:
+            skipped += 1
+            continue
+        rows.append("%sZ %s %.1f °C" % (r["ts"], r["sensor"], r["temp"]))
+    result: Dict = {"title": _("Readings export"), "rows": rows, "skipped": skipped}
+    if skipped > 0:
+        result["note"] = _("%d readings skipped (no temperature)") % skipped
+    return result
diff --git a/tests/test_edge.py b/tests/test_edge.py
index 6432c82..95c41c1 100644
--- a/tests/test_edge.py
+++ b/tests/test_edge.py
@@ -1,11 +1,38 @@
 import json
 import unittest
+from typing import Dict, Optional
 
 from edge import uploader
 
 
+def reading(ts: str, sensor: str = "a1", temp: Optional[float] = 20.0) -> Dict:
+    return {"ts": ts, "sensor": sensor, "temp": temp}
+
+
 class TestUploader(unittest.TestCase):
-    def test_upload(self):
+    def test_upload(self) -> None:
         out = uploader.upload([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
         self.assertEqual(out["sent"], 1)
         self.assertEqual(json.loads(out["payload"])["readings"][0][1], "a1")
+
+    def test_skips_missing_temperature(self) -> None:
+        out = uploader.upload([
+            reading("2026-10-01T09:00:00"),
+            reading("2026-10-01T10:00:00", temp=None),
+        ])
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(len(json.loads(out["payload"])["readings"]), 1)
+
+    def test_since_drops_old_readings_without_counting_them_skipped(self) -> None:
+        out = uploader.upload([
+            reading("2026-09-30T23:59:59", temp=None),
+            reading("2026-10-01T00:00:00", temp=None),
+            reading("2026-10-02T00:00:00"),
+        ], since="2026-10-01")
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 1)
+
+    def test_rejects_bad_since(self) -> None:
+        with self.assertRaises(ValueError):
+            uploader.upload([], since="2026/10/01")
