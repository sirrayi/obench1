diff --git a/packages/web/web/export.py b/packages/web/web/export.py
index f037621..bf0ecee 100644
--- a/packages/web/web/export.py
+++ b/packages/web/web/export.py
@@ -1,10 +1,31 @@
 """The dashboard's readings export."""
-from typing import Dict, List
+from typing import Any, Dict, List, Optional
 
 from web.i18n import _
 
 
-def export(readings: List[Dict]) -> Dict:
+def _parse_day(day: Optional[str]) -> Optional[str]:
+    """Return a YYYY-MM-DD string unchanged, or None."""
+    if day is None:
+        return None
+    if len(day) != 10 or day[4] != "-" or day[7] != "-":
+        raise ValueError("expected YYYY-MM-DD, got %r" % day)
+    return day
+
+
+def _on_or_after(reading: Dict[str, Any], since: Optional[str]) -> bool:
+    """Return whether a reading falls on or after the since day."""
+    return since is None or reading["ts"][:10] >= since
+
+
+def export(readings: List[Dict[str, Any]], since: Optional[str] = None) -> Dict[str, Any]:
     """Render readings as display rows."""
-    rows = ["%sZ %s %.1f °C" % (r["ts"], r["sensor"], r["temp"]) for r in readings]
-    return {"title": _("Readings export"), "rows": rows}
+    since_day = _parse_day(since)
+    kept = [r for r in readings if _on_or_after(r, since_day)]
+    ready = [r for r in kept if r["temp"] is not None]
+    skipped = len(kept) - len(ready)
+    rows = ["%sZ %s %.1f °C" % (r["ts"], r["sensor"], r["temp"]) for r in ready]
+    result: Dict[str, Any] = {"title": _("Readings export"), "rows": rows, "skipped": skipped}
+    if skipped > 0:
+        result["note"] = _("%d readings skipped (no temperature)") % skipped
+    return result
