diff --git a/packages/web/web/clock.py b/packages/web/web/clock.py
new file mode 100644
index 0000000..6ba911d
--- /dev/null
+++ b/packages/web/web/clock.py
@@ -0,0 +1,16 @@
+"""Timestamps on the dashboard."""
+from typing import Optional
+
+
+def day_of(ts: str) -> str:
+    """Return the YYYY-MM-DD part of an ISO timestamp."""
+    return ts[:10]
+
+
+def parse_day(day: Optional[str]) -> Optional[str]:
+    """Return a YYYY-MM-DD string unchanged, or None."""
+    if day is None:
+        return None
+    if len(day) != 10 or day[4] != "-" or day[7] != "-":
+        raise ValueError("expected YYYY-MM-DD, got %r" % day)
+    return day
