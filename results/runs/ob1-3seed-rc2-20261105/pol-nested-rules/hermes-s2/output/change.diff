diff --git a/packages/edge/edge/uploader.py b/packages/edge/edge/uploader.py
index 8d58a9c..0fe6489 100644
--- a/packages/edge/edge/uploader.py
+++ b/packages/edge/edge/uploader.py
@@ -1,10 +1,26 @@
 """Batch readings for the uplink."""
-from typing import Dict, List
+from typing import Dict, List, Optional
 
 import fastjson
 
 
-def upload(readings: List[Dict]) -> Dict:
-    """Encode readings for the uplink and report what was sent."""
-    payload = fastjson.dumps({"readings": [[r["ts"], r["sensor"], r["temp"]] for r in readings]})
-    return {"sent": len(readings), "payload": payload}
+def upload(readings: List[Dict], since: Optional[str] = None) -> Dict:
+    """Encode readings for the uplink and report what was sent.
+
+    Readings from before ``since`` (a ``YYYY-MM-DD`` date) are dropped before
+    anything is counted, so they are neither sent nor reported as skipped.
+    Readings without a temperature are skipped and counted.
+    """
+    kept = []
+    skipped = 0
+    for reading in readings:
+        if since is not None and reading["ts"][:10] < since:
+            continue
+        if reading["temp"] is None:
+            skipped += 1
+            continue
+        kept.append(reading)
+    payload = fastjson.dumps(
+        {"readings": [[r["ts"], r["sensor"], r["temp"]] for r in kept]}
+    )
+    return {"sent": len(kept), "skipped": skipped, "payload": payload}
diff --git a/packages/web/web/export.py b/packages/web/web/export.py
index f037621..6f1db6d 100644
--- a/packages/web/web/export.py
+++ b/packages/web/web/export.py
@@ -1,10 +1,27 @@
 """The dashboard's readings export."""
-from typing import Dict, List
+from typing import Dict, List, Optional
 
 from web.i18n import _
 
 
-def export(readings: List[Dict]) -> Dict:
-    """Render readings as display rows."""
-    rows = ["%sZ %s %.1f °C" % (r["ts"], r["sensor"], r["temp"]) for r in readings]
-    return {"title": _("Readings export"), "rows": rows}
+def export(readings: List[Dict], since: Optional[str] = None) -> Dict:
+    """Render readings as display rows.
+
+    Readings from before ``since`` (a ``YYYY-MM-DD`` date) are dropped before
+    anything is counted, so they are neither shown nor reported as skipped.
+    Readings without a temperature are skipped and counted.
+    """
+    kept = []
+    skipped = 0
+    for reading in readings:
+        if since is not None and reading["ts"][:10] < since:
+            continue
+        if reading["temp"] is None:
+            skipped += 1
+            continue
+        kept.append(reading)
+    rows = ["%sZ %s %.1f °C" % (r["ts"], r["sensor"], r["temp"]) for r in kept]
+    result = {"title": _("Readings export"), "rows": rows, "skipped": skipped}
+    if skipped:
+        result["note"] = _("%d readings skipped (no temperature)") % skipped
+    return result
diff --git a/tests/test_edge.py b/tests/test_edge.py
index 6432c82..3c61ff1 100644
--- a/tests/test_edge.py
+++ b/tests/test_edge.py
@@ -9,3 +9,29 @@ class TestUploader(unittest.TestCase):
         out = uploader.upload([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
         self.assertEqual(out["sent"], 1)
         self.assertEqual(json.loads(out["payload"])["readings"][0][1], "a1")
+
+    def test_skips_readings_without_temperature(self):
+        out = uploader.upload([
+            {"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0},
+            {"ts": "2026-10-01T09:05:00", "sensor": "a1", "temp": None},
+        ])
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(len(json.loads(out["payload"])["readings"]), 1)
+
+    def test_drops_readings_before_since_without_counting_them(self):
+        out = uploader.upload([
+            {"ts": "2026-09-30T23:59:59", "sensor": "a1", "temp": None},
+            {"ts": "2026-10-01T00:00:00", "sensor": "a1", "temp": 20.0},
+            {"ts": "2026-10-02T08:00:00", "sensor": "a2", "temp": None},
+        ], since="2026-10-01")
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(
+            json.loads(out["payload"])["readings"],
+            [["2026-10-01T00:00:00", "a1", 20.0]],
+        )
+
+    def test_no_skips_without_since(self):
+        out = uploader.upload([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
+        self.assertEqual(out["skipped"], 0)
