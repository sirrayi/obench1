--- a/tests/test_web.py
+++ b/tests/test_web.py
@@ -7,3 +7,41 @@ class TestExport(unittest.TestCase):
     def test_rows(self):
         out = export.export([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0}])
         self.assertEqual(out["rows"], ["2026-10-01T09:00:00Z a1 20.0 °C"])
+
+    def test_skips_readings_without_temperature(self):
+        out = export.export([
+            {"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 20.0},
+            {"ts": "2026-10-01T10:00:00", "sensor": "a2", "temp": None},
+        ])
+        self.assertEqual(out["rows"], ["2026-10-01T09:00:00Z a1 20.0 °C"])
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(out["note"], "1 readings skipped (no temperature)")
+
+    def test_no_note_when_nothing_is_skipped(self):
+        out = export.export([{"ts": "2026-10-01T09:00:00", "sensor": "a1", "temp": 0.0}])
+        self.assertEqual(out["skipped"], 0)
+        self.assertNotIn("note", out)
+
+    def test_since_drops_older_readings_without_counting_them(self):
+        out = export.export([
+            {"ts": "2026-09-30T23:00:00", "sensor": "a1", "temp": None},
+            {"ts": "2026-10-01T09:00:00", "sensor": "a2", "temp": 20.0},
+        ], since="2026-10-01")
+        self.assertEqual(out["rows"], ["2026-10-01T09:00:00Z a2 20.0 °C"])
+        self.assertEqual(out["skipped"], 0)
+        self.assertNotIn("note", out)
+
+    def test_note_counts_only_recent_readings(self):
+        out = export.export([
+            {"ts": "2026-09-30T23:00:00", "sensor": "a1", "temp": None},
+            {"ts": "2026-10-01T09:00:00", "sensor": "a2", "temp": None},
+            {"ts": "2026-10-01T10:00:00", "sensor": "a3", "temp": 20.0},
+        ], since="2026-10-01")
+        self.assertEqual(out["skipped"], 1)
+        self.assertEqual(out["note"], "1 readings skipped (no temperature)")
+
+    def test_title_is_kept(self):
+        out = export.export([])
+        self.assertEqual(out["title"], "Readings export")
+        self.assertEqual(out["rows"], [])
+        self.assertEqual(out["skipped"], 0)
