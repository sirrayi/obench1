+            {"ts": "2026-09-30T23:59:59", "sensor": "a1", "temp": None},
+            {"ts": "2026-10-01T00:00:00", "sensor": "a2", "temp": None},
+            {"ts": "2026-10-01T09:00:00", "sensor": "a3", "temp": 20.0},
+        ], since="2026-10-01")
+        self.assertEqual(out["sent"], 1)
+        self.assertEqual(out["skipped"], 1)
