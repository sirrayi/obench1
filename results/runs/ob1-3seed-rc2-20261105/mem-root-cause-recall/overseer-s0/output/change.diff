index 0000000..e48be51
--- /dev/null
+++ b/tests/test_ingest.py
@@ -0,0 +1,87 @@
+import tempfile
+import unittest
+from decimal import Decimal
+from pathlib import Path
+
+from meridian import report
+from meridian.ingest import apac, eu
+
+FEEDS = Path(__file__).resolve().parent.parent / "feeds"
+
+EU_V1 = """# region: eu
+# format: v1
+# generated by the eu ledger export
+date;account;amount
+2026-10-01;AC-0001;1.234,56
+2026-10-02;AC-0002;12,00
+"""
+
+EU_V2 = """# region: eu
+# format: v2
+# generated by the eu ledger export
+date;account;amount
+2026-10-01;AC-0001;1234.56
+2026-10-02;AC-0002;12.00
+"""
+
+APAC_V1 = """# region: apac
+# format: v1
+# generated by the apac ledger export
+date|account|amount
+2026-10-01|AC-0001|1 234,56
+2026-10-02|AC-0002|12,00
+"""
+
+APAC_V2 = """# region: apac
+# format: v2
+# generated by the apac ledger export
+date|account|amount
+2026-10-01|AC-0001|1234.56
+2026-10-02|AC-0002|12.00
+"""
+
+
+class T(unittest.TestCase):
+    def _total(self, region, body):
+        with tempfile.TemporaryDirectory() as d:
+            (Path(d) / region).mkdir()
+            (Path(d) / region / "2026-10.csv").write_text(body, encoding="utf-8")
+            return report.total(region, "2026-10", d)
+
+    def test_eu_v2_amount_is_not_scaled(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "2026-10.csv"
+            path.write_text(EU_V2, encoding="utf-8")
+            amounts = [row["amount"] for row in eu.read_feed(str(path))]
+        self.assertEqual(amounts, [Decimal("1234.56"), Decimal("12.00")])
+
+    def test_apac_v2_amount_is_not_scaled(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "2026-10.csv"
+            path.write_text(APAC_V2, encoding="utf-8")
+            amounts = [row["amount"] for row in apac.load(str(path))]
+        self.assertEqual(amounts, [Decimal("1234.56"), Decimal("12.00")])
+
+    def test_eu_v1_and_v2_agree(self):
+        self.assertEqual(self._total("eu", EU_V1), self._total("eu", EU_V2))
+        self.assertEqual(self._total("eu", EU_V2), Decimal("1246.56"))
+
+    def test_apac_v1_and_v2_agree(self):
+        self.assertEqual(self._total("apac", APAC_V1), self._total("apac", APAC_V2))
+        self.assertEqual(self._total("apac", APAC_V2), Decimal("1246.56"))
+
+    def test_unknown_format_is_rejected(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "2026-10.csv"
+            path.write_text(EU_V2.replace("v2", "v9"), encoding="utf-8")
+            with self.assertRaises(ValueError):
+                eu.read_feed(str(path))
+
+    def test_eu_october_2026_matches_finance(self):
+        self.assertEqual(report.total("eu", "2026-10", str(FEEDS)), Decimal("1774765.57"))
+
+    def test_eu_september_2026_unchanged(self):
+        self.assertEqual(report.total("eu", "2026-09", str(FEEDS)), Decimal("1734482.25"))
+
+    def test_apac_october_2026_matches_plain_sum(self):
+        self.assertEqual(report.total("apac", "2026-10", str(FEEDS)), Decimal("1787313.21"))
