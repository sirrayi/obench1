diff --git a/meridian/text.py b/meridian/text.py
index 39ac75f..9add3a6 100644
--- a/meridian/text.py
+++ b/meridian/text.py
@@ -1,11 +1,34 @@
 """Text helpers shared by the ingest readers."""
 
+FORMAT_TAG = "# format:"
+
 
 def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
+    """Turn a v1 feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
     return raw.strip().replace(".", "").replace(",", ".")
 
 
+def plain_number(raw):
+    """Turn a v2 feed amount into a plain decimal string ("1234.56" -> "1234.56").
+
+    v2 exports drop thousands grouping and always use "." as the decimal mark,
+    so the amount is already plain: stripping separators here would scale it.
+    """
+    return raw.strip()
+
+
 def squash(s):
     """Collapse runs of whitespace."""
     return " ".join(s.split())
+
+
+def feed_lines(text):
+    """Split a feed body into (declared format, data lines)."""
+    version = None
+    lines = []
+    for line in text.splitlines():
+        if line.startswith(FORMAT_TAG):
+            version = line[len(FORMAT_TAG):].strip()
+        elif line and not line.startswith("#"):
+            lines.append(line)
+    return version, lines
diff --git a/tests/test_ingest.py b/tests/test_ingest.py
