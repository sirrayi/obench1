@@ -0,0 +1,43 @@
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from meridian import report
+from meridian.ingest import apac
+
+
+class FeedFormatTests(unittest.TestCase):
+    def _load(self, reader, header, row):
+        fd, path = tempfile.mkstemp(suffix=".csv")
+        self.addCleanup(os.remove, path)
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            f.write(header + "\n" + row + "\n")
+        return reader(path)
+
+    def test_apac_v1_amounts_keep_decimal_comma(self):
+        rows = self._load(
+            apac.load,
+            "# format: v1\ndate|account|amount",
+            "2026-09-02|AC-1|1 114,82",
+        )
+        self.assertEqual(rows[0]["amount"], Decimal("1114.82"))
+
+    def test_apac_v2_amounts_keep_decimal_point(self):
+        rows = self._load(
+            apac.load,
+            "# format: v2\ndate|account|amount",
+            "2026-10-11|AC-1|2641.49",
+        )
+        self.assertEqual(rows[0]["amount"], Decimal("2641.49"))
+
+    def test_apac_october_total_matches_finance(self):
+        feeds = os.path.join(os.path.dirname(os.path.dirname(__file__)), "feeds")
+        self.assertEqual(
+            report.total("apac", "2026-10", feeds),
+            Decimal("1787313.21"),
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
