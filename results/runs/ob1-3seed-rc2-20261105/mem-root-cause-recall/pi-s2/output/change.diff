 """Text helpers shared by the ingest readers."""
 
 
-def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+def clean_number(raw, version="v1"):
+    """Turn a feed amount into a plain decimal string.
+
+    v1 exports use grouping separators and a decimal comma ("1.234,56");
+    v2 exports use a plain decimal point ("1234.56").
+    """
+    raw = raw.strip()
+    if version == "v2":
+        return raw
+    if version != "v1":
+        raise ValueError("unsupported feed format: %s" % version)
+    return raw.replace(" ", "").replace(".", "").replace(",", ".")
 
 
