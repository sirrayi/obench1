 """Text helpers shared by the ingest readers."""
 
+# Feeds declare their number format in a "# format: vN" comment line.
+# Each entry is (thousands separator, decimal separator); an empty thousands
+# separator means the feed does not group thousands.
+# v1: "1.234,56", v2: "1,234.56" or "1234.56".
+NUMBER_FORMATS = {
+    "v1": (".", ","),
+    "v2": (",", "."),
+}
+DEFAULT_FORMAT = "v1"
 
-def clean_number(raw):
+
+def clean_number(raw, fmt=DEFAULT_FORMAT):
     """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+    if fmt not in NUMBER_FORMATS:
+        raise ValueError("unknown feed number format: %r" % (fmt,))
+    thousands, decimal = NUMBER_FORMATS[fmt]
+    s = raw.strip().replace(" ", "")
+    if thousands:
+        s = s.replace(thousands, "")
+    return s.replace(decimal, ".")
+
+
+def feed_format(lines, default=DEFAULT_FORMAT):
+    """The number format a feed declares in its "# format:" header."""
+    for line in lines:
+        line = line.strip()
+        if not line.startswith("#"):
+            continue
+        key, _, value = line.partition(":")
+        if key.strip() == "# format":
+            return value.strip()
+    return default
 
 
