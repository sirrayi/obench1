@@ -0,0 +1,102 @@
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from meridian import report, text
+from meridian.ingest import apac, eu
+
+FEEDS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "feeds")
+
+EU_V1 = """# region: eu
+# format: v1
+date;account;amount
+2026-09-27;AC-3239;4.014,05
+2026-09-26;AC-1682;988,92
+"""
+
+EU_V2 = """# region: eu
+# format: v2
+date;account;amount
+2026-10-03;AC-3413;1425.01
+2026-10-08;AC-1205;856.98
+"""
+
+APAC_V1 = """# region: apac
+# format: v1
+date|account|amount
+2026-09-02|AC-9426|1 114,82
+2026-09-02|AC-3223|426,66
+"""
+
+APAC_V2 = """# region: apac
+# format: v2
+date|account|amount
+2026-10-11|AC-1381|2641.49
+2026-10-21|AC-2684|4995.20
+"""
+
+
+def write_feed(root, region, name, content):
+    directory = os.path.join(root, region)
+    os.makedirs(directory, exist_ok=True)
+    path = os.path.join(directory, name)
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(content)
+    return path
+
+
+class ParseAmountTest(unittest.TestCase):
+    def test_v1_decimal_comma_with_dot_grouping(self):
+        self.assertEqual(text.parse_amount("1.234,56", "v1"), Decimal("1234.56"))
+
+    def test_v1_decimal_comma_with_space_grouping(self):
+        self.assertEqual(text.parse_amount("1 114,82", "v1"), Decimal("1114.82"))
+
+    def test_v2_plain_decimal_point(self):
+        self.assertEqual(text.parse_amount("1425.01", "v2"), Decimal("1425.01"))
+
+    def test_unknown_format_is_rejected(self):
+        with self.assertRaises(ValueError):
+            text.parse_amount("1.00", "v3")
+
+
+class FeedReaderTest(unittest.TestCase):
+    def test_eu_reads_both_formats(self):
+        with tempfile.TemporaryDirectory() as root:
+            v1 = eu.read_feed(write_feed(root, "eu", "2026-09.csv", EU_V1))
+            v2 = eu.read_feed(write_feed(root, "eu", "2026-10.csv", EU_V2))
+        self.assertEqual([r["amount"] for r in v1], [Decimal("4014.05"), Decimal("988.92")])
+        self.assertEqual([r["amount"] for r in v2], [Decimal("1425.01"), Decimal("856.98")])
+
+    def test_apac_reads_both_formats(self):
+        with tempfile.TemporaryDirectory() as root:
+            v1 = apac.load(write_feed(root, "apac", "2026-09.csv", APAC_V1))
+            v2 = apac.load(write_feed(root, "apac", "2026-10.csv", APAC_V2))
+        self.assertEqual([r["amount"] for r in v1], [Decimal("1114.82"), Decimal("426.66")])
+        self.assertEqual([r["amount"] for r in v2], [Decimal("2641.49"), Decimal("4995.20")])
+
+    def test_feed_without_format_header_is_rejected(self):
+        with tempfile.TemporaryDirectory() as root:
+            path = write_feed(root, "eu", "2026-10.csv", "date;account;amount\n2026-10-03;AC-1;1425.01\n")
+            with self.assertRaises(ValueError):
+                eu.read_feed(path)
+
+
+class ReportRegressionTest(unittest.TestCase):
+    def test_v2_amounts_are_not_rescaled(self):
+        with tempfile.TemporaryDirectory() as root:
+            write_feed(root, "eu", "2026-10.csv", EU_V2)
+            self.assertEqual(report.total("eu", "2026-10", root), Decimal("2281.99"))
+
+    def test_eu_october_matches_finance(self):
+        self.assertEqual(report.total("eu", "2026-10", FEEDS), Decimal("1774765.57"))
+
+    def test_eu_september_still_matches(self):
+        self.assertEqual(report.total("eu", "2026-09", FEEDS), Decimal("1734482.25"))
+
+    def test_apac_october_matches_finance(self):
+        self.assertEqual(report.total("apac", "2026-10", FEEDS), Decimal("1787313.21"))
+
+    def test_apac_september_still_matches(self):
+        self.assertEqual(report.total("apac", "2026-09", FEEDS), Decimal("1784764.94"))
