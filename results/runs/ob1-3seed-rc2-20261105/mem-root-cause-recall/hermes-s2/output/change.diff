 """Text helpers shared by the ingest readers."""
+from decimal import Decimal
 
+FORMAT_V1 = "v1"
+FORMAT_V2 = "v2"
 
-def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+
+def feed_format(lines):
+    """Return the export format declared in a feed's comment header."""
+    for line in lines:
+        if not line.startswith("#"):
+            continue
+        key, _, value = line[1:].partition(":")
+        if key.strip() == "format":
+            return value.strip()
+    raise ValueError("feed has no '# format:' header")
+
+
+def parse_amount(raw, fmt):
+    """Parse a feed amount according to its declared export format.
+
+    v1 groups thousands with "." or a space and uses a decimal comma;
+    v2 uses a plain "." decimal point with no grouping.
+    """
+    value = raw.strip().replace(" ", "")
+    if fmt == FORMAT_V1:
+        return Decimal(value.replace(".", "").replace(",", "."))
+    if fmt == FORMAT_V2:
+        return Decimal(value)
+    raise ValueError("unsupported feed format: %r" % (fmt,))
 
 
