 """Text helpers shared by the ingest readers."""
+from decimal import Decimal
+
+FORMAT_V1 = "v1"
+FORMAT_V2 = "v2"
 
 
 def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+    """Turn a v1 feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
+    return raw.strip().replace(" ", "").replace(".", "").replace(",", ".")
+
+
+def feed_format(lines):
+    """Return the format version declared in a feed's comment header."""
+    for line in lines:
+        if not line.strip():
+            continue
+        if not line.startswith("#"):
+            break
+        key, _, value = line[1:].partition(":")
+        if key.strip() == "format":
+            return value.strip()
+    raise ValueError("feed has no '# format:' header")
+
+
+def parse_amount(raw, version):
+    """Parse a feed amount using the rules of its declared format version."""
+    if version == FORMAT_V1:
+        return Decimal(clean_number(raw))
+    if version == FORMAT_V2:
+        return Decimal(raw.strip())
+    raise ValueError("unsupported feed format: %s" % (version,))
 
 
