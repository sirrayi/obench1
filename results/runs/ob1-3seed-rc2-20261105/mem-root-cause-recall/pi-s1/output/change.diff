+++ b/tests/test_feeds.py
@@ -0,0 +1,44 @@
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from meridian import report
+from meridian.ingest import apac, eu
+
+
+class FeedFormatTest(unittest.TestCase):
+    def reader(self, reader, body):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "feed.csv")
+            with open(path, "w", encoding="utf-8") as f:
+                f.write(body)
+            return reader(path)
+
+    def test_eu_v1_number_format(self):
+        rows = self.reader(eu.read_feed, "# format: v1\ndate;account;amount\n2026-09-27;AC-3239;4.014,05\n")
+        self.assertEqual(rows[0]["amount"], Decimal("4014.05"))
+
+    def test_eu_v2_number_format(self):
+        rows = self.reader(eu.read_feed, "# format: v2\ndate;account;amount\n2026-10-03;AC-3413;1425.01\n")
+        self.assertEqual(rows[0]["amount"], Decimal("1425.01"))
+
+    def test_apac_v1_number_format(self):
+        rows = self.reader(apac.load, "# format: v1\ndate|account|amount\n2026-09-02|AC-9426|1 114,82\n")
+        self.assertEqual(rows[0]["amount"], Decimal("1114.82"))
+
+    def test_apac_v2_number_format(self):
+        rows = self.reader(apac.load, "# format: v2\ndate|account|amount\n2026-10-11|AC-1381|2641.49\n")
+        self.assertEqual(rows[0]["amount"], Decimal("2641.49"))
+
+    def test_unknown_format_is_rejected(self):
+        with self.assertRaises(ValueError):
+            self.reader(eu.read_feed, "# format: v3\ndate;account;amount\n2026-10-03;AC-3413;1.00\n")
+
+
+class OctoberTotalsTest(unittest.TestCase):
+    def test_eu_october_total(self):
+        self.assertEqual(report.total("eu", "2026-10"), Decimal("1774765.57"))
+
+    def test_apac_october_total(self):
+        self.assertEqual(report.total("apac", "2026-10"), Decimal("1787313.21"))
