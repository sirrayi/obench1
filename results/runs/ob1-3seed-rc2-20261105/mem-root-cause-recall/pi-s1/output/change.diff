@@ -0,0 +1,38 @@
+import contextlib
+import io
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from meridian import report
+
+
+class ApacOctoberReportTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        region = os.path.join(self._tmp.name, "apac")
+        os.mkdir(region)
+        with open(os.path.join(region, "2026-10.csv"), "w", encoding="utf-8") as f:
+            f.write(
+                "# region: apac\n"
+                "# format: v2\n"
+                "date|account|amount\n"
+                "2026-10-11|AC-1381|1787313.21\n"
+            )
+
+    def test_total_uses_point_decimal_amounts(self):
+        self.assertEqual(
+            report.total("apac", "2026-10", self._tmp.name),
+            Decimal("1787313.21"),
+        )
+
+    def test_cli_prints_finance_total(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            code = report.main(
+                ["--region", "apac", "--month", "2026-10", "--feeds", self._tmp.name]
+            )
+        self.assertEqual(code, 0)
+        self.assertEqual(out.getvalue().strip(), "1787313.21 SGD")
