@@ -0,0 +1,20 @@
+"""Readers for the regional ledger exports."""
+from meridian import text
+
+COLUMNS = ("date", "account", "amount")
+
+
+def read_rows(path, delimiter):
+    """Read a delimited feed export: a list of {date, account, amount} rows."""
+    with open(path, encoding="utf-8") as f:
+        lines = f.read().splitlines()
+    fmt = text.feed_format(lines)
+    column_header = delimiter.join(COLUMNS)
+    rows = []
+    for line in lines:
+        if not line or line.startswith("#") or line == column_header:
+            continue
+        date, account, amount = line.split(delimiter)
+        value = text.parse_amount(amount, fmt, where="%s:%s" % (path, date))
+        rows.append({"date": date, "account": account, "amount": value})
+    return rows
