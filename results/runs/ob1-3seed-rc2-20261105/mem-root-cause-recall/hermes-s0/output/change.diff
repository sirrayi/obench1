@@ -0,0 +1,103 @@
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from meridian import report
+from meridian.ingest import apac, eu, formats
+
+FEEDS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "feeds")
+
+
+def _write_feed(directory, name, header, lines):
+    path = os.path.join(directory, name)
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(header)
+        f.write("\n".join(lines) + "\n")
+    return path
+
+
+class TestFormats(unittest.TestCase):
+    def test_v1_amounts(self):
+        self.assertEqual(formats.parse_amount("1.425,01", "v1"), Decimal("1425.01"))
+        self.assertEqual(formats.parse_amount("988,92", "v1"), Decimal("988.92"))
+        self.assertEqual(formats.parse_amount("1 234,56", "v1"), Decimal("1234.56"))
+        self.assertEqual(formats.parse_amount("1.234.567,89", "v1"), Decimal("1234567.89"))
+
+    def test_v2_amounts(self):
+        self.assertEqual(formats.parse_amount("1425.01", "v2"), Decimal("1425.01"))
+        self.assertEqual(formats.parse_amount("1,234.56", "v2"), Decimal("1234.56"))
+
+    def test_declared_format_governs_parsing(self):
+        # The same text means different things under each version; a reader
+        # that ignores the header inflates every v2 amount by 100.
+        self.assertEqual(formats.parse_amount("1425.01", "v2"), Decimal("1425.01"))
+        with self.assertRaises(ValueError):
+            formats.parse_amount("1425.01", "v1")
+        with self.assertRaises(ValueError):
+            formats.parse_amount("1.425,01", "v2")
+
+    def test_read_format(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = _write_feed(directory, "v2.csv", "# region: eu\n# format: v2\n", ["date;account;amount"])
+            self.assertEqual(formats.read_format(path), "v2")
+            path = _write_feed(directory, "none.csv", "# region: eu\n", ["date;account;amount"])
+            with self.assertRaises(ValueError):
+                formats.read_format(path)
+            path = _write_feed(directory, "future.csv", "# format: v9\n", ["date;account;amount"])
+            with self.assertRaises(ValueError):
+                formats.read_format(path)
+
+
+class TestReadersAgreeAcrossFormats(unittest.TestCase):
+    def test_same_amounts_same_total(self):
+        with tempfile.TemporaryDirectory() as directory:
+            eu_v1 = _write_feed(directory, "eu1.csv", "# format: v1\n", [
+                "date;account;amount",
+                "2026-10-01;AC-1;1.425,01",
+                "2026-10-02;AC-2;988,92",
+            ])
+            eu_v2 = _write_feed(directory, "eu2.csv", "# format: v2\n", [
+                "date;account;amount",
+                "2026-10-01;AC-1;1425.01",
+                "2026-10-02;AC-2;988.92",
+            ])
+            self.assertEqual([r["amount"] for r in eu.read_feed(eu_v1)], [Decimal("1425.01"), Decimal("988.92")])
+            self.assertEqual([r["amount"] for r in eu.read_feed(eu_v2)], [Decimal("1425.01"), Decimal("988.92")])
+
+            apac_v1 = _write_feed(directory, "a1.csv", "# format: v1\n", [
+                "date|account|amount",
+                "2026-10-01|AC-1|1 425,01",
+            ])
+            apac_v2 = _write_feed(directory, "a2.csv", "# format: v2\n", [
+                "date|account|amount",
+                "2026-10-01|AC-1|1425.01",
+            ])
+            self.assertEqual(apac.load(apac_v1)[0]["amount"], Decimal("1425.01"))
+            self.assertEqual(apac.load(apac_v2)[0]["amount"], Decimal("1425.01"))
+
+    def test_bad_amount_names_the_row(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = _write_feed(directory, "bad.csv", "# format: v2\n", [
+                "date;account;amount",
+                "2026-10-01;AC-1;1.425,01",
+            ])
+            with self.assertRaises(ValueError) as caught:
+                eu.read_feed(path)
+            self.assertIn("2026-10-01", str(caught.exception))
+
+
+class TestOctoberTotals(unittest.TestCase):
+    """Regression: v2 feeds are dot-decimal, so October totals stay in thousands."""
+
+    def test_eu_october(self):
+        self.assertEqual(report.total("eu", "2026-10", FEEDS), Decimal("1774765.57"))
+
+    def test_eu_september_unchanged(self):
+        self.assertEqual(report.total("eu", "2026-09", FEEDS), Decimal("1734482.25"))
+
+    def test_apac_october(self):
+        self.assertEqual(report.total("apac", "2026-10", FEEDS), Decimal("1787313.21"))
+
+    def test_apac_september_unchanged(self):
+        self.assertEqual(report.total("apac", "2026-09", FEEDS), Decimal("1784764.94"))
