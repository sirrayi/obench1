index 0000000..604f44c
--- /dev/null
+++ b/meridian/ingest/formats.py
@@ -0,0 +1,65 @@
+"""Feed formats: the version a feed declares and the amount syntax it implies.
+
+Every export starts with a ``# format: vN`` comment. The amount syntax is not
+stable across versions, so the declared version decides how a number is read:
+
+    v1  1.234,56   thousands dot, decimal comma (also 1 234,56)
+    v2  1234.56    decimal dot, optional comma thousands
+
+Guessing from the text instead of the header turns "1425.01" into 142501.
+"""
+import re
+from decimal import Decimal, InvalidOperation
+
+_V1 = re.compile(r"^-?\d{1,3}(?:\.\d{3})*(?:,\d+)?$|^-?\d+(?:,\d+)?$")
+_V2 = re.compile(r"^-?\d{1,3}(?:,\d{3})*(?:\.\d+)?$|^-?\d+(?:\.\d+)?$")
+_FORMAT_LINE = re.compile(r"^#\s*format\s*:\s*(\S+)$")
+
+
+def _parse_v1(raw):
+    text = raw.strip().replace(" ", "")
+    if not _V1.match(text):
+        raise ValueError(text)
+    return Decimal(text.replace(".", "").replace(",", "."))
+
+
+def _parse_v2(raw):
+    text = raw.strip().replace(" ", "")
+    if not _V2.match(text):
+        raise ValueError(text)
+    return Decimal(text.replace(",", ""))
+
+
+_PARSERS = {"v1": _parse_v1, "v2": _parse_v2}
+
+
+def read_format(path):
+    """Return the format version a feed declares in its header, e.g. "v2"."""
+    fmt = None
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            if not line.startswith("#"):
+                break
+            match = _FORMAT_LINE.match(line.strip())
+            if match:
+                fmt = match.group(1)
+                break
+    if fmt is None:
+        raise ValueError("%s: no '# format:' header" % path)
+    if fmt not in _PARSERS:
+        raise ValueError("%s: unsupported feed format %r" % (path, fmt))
+    return fmt
+
+
+def parse_amount(raw, fmt, where=None):
+    """Parse one amount according to the feed's declared format."""
+    try:
+        parser = _PARSERS[fmt]
+    except KeyError:
+        raise ValueError("%s: unsupported feed format %r" % (where or "feed", fmt))
+    try:
+        return parser(raw)
+    except (ValueError, InvalidOperation):
+        raise ValueError(
+            "%s: %r is not a valid %s amount" % (where or "feed", raw.strip(), fmt)
+        )
