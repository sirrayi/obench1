@@ -0,0 +1,23 @@
+"""Monthly totals from the checked-in ledger exports."""
+import os
+import unittest
+from decimal import Decimal
+
+from meridian import report
+
+FEEDS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "feeds")
+
+
+class ApacOctoberRegressionTest(unittest.TestCase):
+    """ISSUE-2: APAC October 2026 printed 178731321.00 SGD, 100x finance's figure.
+
+    The October export declares `# format: v2` (plain decimal point, no
+    grouping), so "2641.49" has to stay 2641.49 instead of losing its point as
+    a thousands separator. These run against the real exports, not fixtures.
+    """
+
+    def test_october_matches_finance(self):
+        self.assertEqual(report.total("apac", "2026-10", FEEDS), Decimal("1787313.21"))
+
+    def test_september_v1_export_still_reads(self):
+        self.assertEqual(report.total("apac", "2026-09", FEEDS), Decimal("1784764.94"))
