 """Text helpers shared by the ingest readers."""
 
+from decimal import Decimal, InvalidOperation
 
-def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+# Amount layouts a ledger export may declare in its `# format:` header.
+#   v1  locale style, grouping plus decimal comma: "1.234,56", "1 234,56"
+#   v2  plain style, decimal point and no grouping: "1234.56"
+FORMATS = ("v1", "v2")
+
+
+class FeedFormatError(ValueError):
+    """A feed's declared format is missing, unknown, or doesn't match its numbers."""
+
+
+def feed_format(comment_lines, path):
+    """Return the format version declared by a feed's `# format:` header."""
+    for line in comment_lines:
+        key, _, value = line.lstrip("#").partition(":")
+        if key.strip() == "format":
+            version = value.strip()
+            if version not in FORMATS:
+                raise FeedFormatError(
+                    "%s: unknown feed format %r, known formats are %s"
+                    % (path, version, ", ".join(FORMATS))
+                )
+            return version
+    raise FeedFormatError("%s: no '# format:' header, refusing to guess the amount layout" % path)
+
+
+def parse_amount(raw, version):
+    """Read one feed amount as a Decimal, following the feed's declared format."""
+    s = raw.strip()
+    if version == "v1":
+        s = s.replace(" ", "").replace(".", "").replace(",", ".")
+    try:
+        return Decimal(s)
+    except InvalidOperation:
+        raise FeedFormatError(
+            "amount %r does not match feed format %s" % (raw, version)
+        ) from None
 
 
