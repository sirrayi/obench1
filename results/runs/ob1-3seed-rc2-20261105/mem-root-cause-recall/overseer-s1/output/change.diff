@@ -0,0 +1,93 @@
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from meridian import report, text
+from meridian.ingest import apac, eu
+
+
+class ParseAmountTest(unittest.TestCase):
+    def test_v1_reads_grouping_and_decimal_comma(self):
+        self.assertEqual(text.parse_amount("1.234,56", "v1"), Decimal("1234.56"))
+        self.assertEqual(text.parse_amount("1 234,56", "v1"), Decimal("1234.56"))
+
+    def test_v2_reads_plain_decimal_point(self):
+        self.assertEqual(text.parse_amount("1234.56", "v2"), Decimal("1234.56"))
+
+    def test_v2_point_is_not_a_thousands_separator(self):
+        self.assertEqual(text.parse_amount("1425.01", "v2"), Decimal("1425.01"))
+
+    def test_amount_can_lie_about_the_format(self):
+        with self.assertRaises(text.FeedFormatError):
+            text.parse_amount("1.234,56", "v2")
+
+    def test_unknown_format_is_rejected(self):
+        with self.assertRaises(text.FeedFormatError):
+            text.feed_format(["# region: eu", "# format: v3"], "eu.csv")
+
+    def test_missing_format_is_rejected(self):
+        with self.assertRaises(text.FeedFormatError):
+            text.feed_format(["# region: eu"], "eu.csv")
+
+
+class FeedFormatRegressionTest(unittest.TestCase):
+    """EU October 2026 was reported 100x high after the export moved to format v2."""
+
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.feeds = os.path.join(self._tmp.name, "feeds")
+
+    def _write(self, region, name, body):
+        folder = os.path.join(self.feeds, region)
+        os.makedirs(folder, exist_ok=True)
+        with open(os.path.join(folder, name), "w", encoding="utf-8") as f:
+            f.write(body)
+
+    def test_eu_v2_month_totals_at_face_value(self):
+        self._write("eu", "2026-10.csv",
+                    "# region: eu\n# format: v2\n# generated by the eu ledger export\n"
+                    "date;account;amount\n"
+                    "2026-10-01;AC-3413;1774765.00\n"
+                    "2026-10-02;AC-1205;0.57\n")
+        self.assertEqual(report.total("eu", "2026-10", self.feeds), Decimal("1774765.57"))
+
+    def test_v1_and_v2_months_read_side_by_side(self):
+        self._write("eu", "2026-09.csv",
+                    "# region: eu\n# format: v1\n# generated by the eu ledger export\n"
+                    "date;account;amount\n"
+                    "2026-09-27;AC-3239;1.000,25\n"
+                    "2026-09-26;AC-1682;0,32\n")
+        self._write("eu", "2026-10.csv",
+                    "# region: eu\n# format: v2\n# generated by the eu ledger export\n"
+                    "date;account;amount\n"
+                    "2026-10-03;AC-3413;1425.01\n")
+        self.assertEqual(report.total("eu", "2026-09", self.feeds), Decimal("1000.57"))
+        self.assertEqual(report.total("eu", "2026-10", self.feeds), Decimal("1425.01"))
+
+    def test_apac_v1_space_grouping_still_read(self):
+        self._write("apac", "2026-09.csv",
+                    "# region: apac\n# format: v1\n# generated by the apac ledger export\n"
+                    "date|account|amount\n"
+                    "2026-09-02|AC-9426|1 114,82\n")
+        self.assertEqual(report.total("apac", "2026-09", self.feeds), Decimal("1114.82"))
+
+    def test_apac_v2_month_totals_at_face_value(self):
+        self._write("apac", "2026-10.csv",
+                    "# region: apac\n# format: v2\n# generated by the apac ledger export\n"
+                    "date|account|amount\n"
+                    "2026-10-11|AC-1381|2641.49\n")
+        self.assertEqual(report.total("apac", "2026-10", self.feeds), Decimal("2641.49"))
+
+    def test_readers_keep_date_and_account(self):
+        self._write("eu", "2026-10.csv",
+                    "# region: eu\n# format: v2\ndate;account;amount\n"
+                    "2026-10-03;AC-3413;1425.01\n")
+        self._write("apac", "2026-10.csv",
+                    "# region: apac\n# format: v2\ndate|account|amount\n"
+                    "2026-10-11|AC-1381|2641.49\n")
+        eu_rows = eu.read_feed(os.path.join(self.feeds, "eu", "2026-10.csv"))
+        apac_rows = apac.load(os.path.join(self.feeds, "apac", "2026-10.csv"))
+        self.assertEqual(eu_rows, [{"date": "2026-10-03", "account": "AC-3413", "amount": Decimal("1425.01")}])
+        self.assertEqual(apac_rows, [{"date": "2026-10-11", "account": "AC-1381", "amount": Decimal("2641.49")}])
