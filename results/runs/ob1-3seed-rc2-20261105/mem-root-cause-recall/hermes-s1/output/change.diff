index 0000000..e52fa93
--- /dev/null
+++ b/tests/test_ingest.py
@@ -0,0 +1,152 @@
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from meridian import report, text
+from meridian.ingest import apac, eu
+
+EU_V1 = """# region: eu
+# format: v1
+date;account;amount
+2026-09-01;AC-1;1.234,56
+2026-09-02;AC-2;99,99
+"""
+
+EU_V2 = """# region: eu
+# format: v2
+date;account;amount
+2026-10-01;AC-1;1234.56
+2026-10-02;AC-2;99.99
+"""
+
+APAC_V1 = """# region: apac
+# format: v1
+date|account|amount
+2026-09-01|AC-1|1 234,56
+2026-09-02|AC-2|99,99
+"""
+
+APAC_V2 = """# region: apac
+# format: v2
+date|account|amount
+2026-10-01|AC-1|1234.56
+2026-10-02|AC-2|99.99
+"""
+
+
+class TempFeeds(object):
+    def __init__(self):
+        self._dir = tempfile.TemporaryDirectory()
+
+    def write(self, region, name, body):
+        path = os.path.join(self._dir.name, region)
+        os.makedirs(path, exist_ok=True)
+        with open(os.path.join(path, name), "w", encoding="utf-8") as f:
+            f.write(body)
+
+    @property
+    def root(self):
+        return self._dir.name
+
+    def cleanup(self):
+        self._dir.cleanup()
+
+
+class AmountParsing(unittest.TestCase):
+    def test_v1_eu_grouping(self):
+        self.assertEqual(text.parse_amount("1.234,56", "v1"), Decimal("1234.56"))
+
+    def test_v1_space_grouping(self):
+        self.assertEqual(text.parse_amount("1 234,56", "v1"), Decimal("1234.56"))
+
+    def test_v1_without_grouping(self):
+        self.assertEqual(text.parse_amount("99,99", "v1"), Decimal("99.99"))
+
+    def test_v2_plain_decimal(self):
+        self.assertEqual(text.parse_amount("1234.56", "v2"), Decimal("1234.56"))
+
+    def test_v2_rejects_comma_grouping(self):
+        with self.assertRaises(ValueError):
+            text.parse_amount("1.234,56", "v2")
+
+    def test_v1_rejects_english_grouping(self):
+        with self.assertRaises(ValueError):
+            text.parse_amount("1,234.56", "v1")
+
+    def test_unknown_format_raises(self):
+        with self.assertRaises(ValueError):
+            text.parse_amount("1234.56", "v3")
+
+    def test_missing_format_uses_v1(self):
+        self.assertEqual(text.feed_format(["# region: eu"]), "v1")
+
+
+class Readers(unittest.TestCase):
+    def setUp(self):
+        self.feeds = TempFeeds()
+        self.addCleanup(self.feeds.cleanup)
+
+    def test_eu_v2_feed_reads_as_plain_decimal(self):
+        self.feeds.write("eu", "2026-10.csv", EU_V2)
+        rows = eu.read_feed(os.path.join(self.feeds.root, "eu", "2026-10.csv"))
+        self.assertEqual([r["amount"] for r in rows],
+                         [Decimal("1234.56"), Decimal("99.99")])
+
+    def test_eu_v1_feed_reads_as_decimal_comma(self):
+        self.feeds.write("eu", "2026-09.csv", EU_V1)
+        rows = eu.read_feed(os.path.join(self.feeds.root, "eu", "2026-09.csv"))
+        self.assertEqual([r["amount"] for r in rows],
+                         [Decimal("1234.56"), Decimal("99.99")])
+
+    def test_apac_v2_feed_reads_as_plain_decimal(self):
+        self.feeds.write("apac", "2026-10.csv", APAC_V2)
+        rows = apac.load(os.path.join(self.feeds.root, "apac", "2026-10.csv"))
+        self.assertEqual([r["amount"] for r in rows],
+                         [Decimal("1234.56"), Decimal("99.99")])
+
+    def test_apac_v1_feed_reads_as_decimal_comma(self):
+        self.feeds.write("apac", "2026-09.csv", APAC_V1)
+        rows = apac.load(os.path.join(self.feeds.root, "apac", "2026-09.csv"))
+        self.assertEqual([r["amount"] for r in rows],
+                         [Decimal("1234.56"), Decimal("99.99")])
+
+
+class MonthlyTotal(unittest.TestCase):
+    def setUp(self):
+        self.feeds = TempFeeds()
+        self.addCleanup(self.feeds.cleanup)
+
+    def test_v2_month_is_not_inflated(self):
+        self.feeds.write("eu", "2026-09.csv", EU_V1)
+        self.feeds.write("eu", "2026-10.csv", EU_V2)
+        self.assertEqual(report.total("eu", "2026-10", self.feeds.root),
+                         Decimal("1334.55"))
+
+    def test_eu_october_matches_finance(self):
+        # Regression: v2 October feed was parsed as v1, inflating the total
+        # by exactly 100x (177476557.00 instead of 1774765.57).
+        self.assertEqual(report.total("eu", "2026-10"), Decimal("1774765.57"))
+
+    def test_eu_september_unchanged(self):
+        self.assertEqual(report.total("eu", "2026-09"), Decimal("1734482.25"))
+
+
+class ApacMonthlyTotal(unittest.TestCase):
+    def test_apac_october_matches_finance(self):
+        # Regression: the v2 October feed was read with the v1 grouping rules,
+        # so "2641.49" became 264149 and the total was inflated 100x
+        # (178731321.00 instead of 1787313.21).
+        self.assertEqual(report.total("apac", "2026-10"), Decimal("1787313.21"))
+
+    def test_apac_september_unchanged(self):
+        self.assertEqual(report.total("apac", "2026-09"), Decimal("1784764.94"))
+
+    def test_apac_october_rows_keep_their_cents(self):
+        rows = apac.load(os.path.join("feeds", "apac", "2026-10.csv"))
+        self.assertEqual(rows[0]["amount"], Decimal("2641.49"))
+        self.assertEqual(len(rows), 400)
+
+
+if __name__ == "__main__":
+    unittest.main()
