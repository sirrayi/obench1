 """Text helpers shared by the ingest readers."""
+import re
+from decimal import Decimal, InvalidOperation
 
+#: Format a feed uses when its header omits a "# format:" line. v1 is the
+#: historical layout, so older exports keep working unchanged.
+DEFAULT_FORMAT = "v1"
 
-def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+#: Plain decimal amounts, e.g. "1234.56" or "-89.00". No grouping allowed.
+_PLAIN_AMOUNT = re.compile(r"^-?[0-9]+(\.[0-9]+)?$")
+
+
+def feed_format(lines):
+    """Return the format version declared by a feed's "# format:" header."""
+    for line in lines:
+        if not line.startswith("#") or ":" not in line:
+            continue
+        key, _, value = line[1:].partition(":")
+        if key.strip().lower() == "format":
+            return value.strip()
+    return DEFAULT_FORMAT
+
+
+def parse_amount(raw, fmt=DEFAULT_FORMAT):
+    """Parse one feed amount according to its declared format version.
+
+    v1 groups thousands with "." or any whitespace and marks decimals with
+    "," ("1.234,56", "1 234,56"); v2 is a plain "." decimal ("1234.56").
+
+    Raises ValueError on an unsupported format or an amount that does not
+    match it, rather than guessing and silently mispricing the number.
+    """
+    value = raw.strip()
+    if fmt == "v1":
+        value = "".join(value.split())
+        if "," in value and "." in value and value.rfind(".") > value.rfind(","):
+            raise ValueError("amount %r is not in v1 format" % (raw,))
+        value = value.replace(".", "").replace(",", ".")
+    elif fmt == "v2":
+        value = "".join(value.split())
+        if not _PLAIN_AMOUNT.match(value):
+            raise ValueError("amount %r is not in v2 format" % (raw,))
+    else:
+        raise ValueError("unsupported feed format: %r" % (fmt,))
+    try:
+        return Decimal(value)
+    except InvalidOperation:
+        raise ValueError("cannot parse amount %r as %s" % (raw, fmt))
 
 
