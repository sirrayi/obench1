diff --git a/meridian/text.py b/meridian/text.py
index 39ac75f..c3ba53f 100644
--- a/meridian/text.py
+++ b/meridian/text.py
@@ -1,11 +1,33 @@
 """Text helpers shared by the ingest readers."""
 
-
-def clean_number(raw):
-    """Turn a feed amount into a plain decimal string ("1.234,56" -> "1234.56")."""
-    return raw.strip().replace(".", "").replace(",", ".")
+FORMATS = ("v1", "v2")
 
 
 def squash(s):
     """Collapse runs of whitespace."""
     return " ".join(s.split())
+
+
+def read_format(lines, source):
+    """Return the feed format version declared in its '# format:' header."""
+    for line in lines:
+        if line.startswith("# format:"):
+            fmt = line.split(":", 1)[1].strip()
+            if fmt not in FORMATS:
+                raise ValueError("%s: unsupported feed format %r" % (source, fmt))
+            return fmt
+    raise ValueError("%s: missing '# format:' header" % source)
+
+
+def clean_number(raw, fmt):
+    """Turn a feed amount into a plain decimal string, per its format version.
+
+    v1 groups thousands with dots and uses a decimal comma: "1.234,56" -> "1234.56".
+    v2 uses a plain decimal point: "1234.56" -> "1234.56".
+    """
+    raw = raw.strip()
+    if fmt == "v1":
+        return raw.replace(".", "").replace(" ", "").replace(",", ".")
+    if fmt == "v2":
+        return raw.replace(" ", "")
+    raise ValueError("unsupported feed format %r" % (fmt,))
