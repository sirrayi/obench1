@@ -0,0 +1,23 @@
+"""Command line interface: python3 -m units <value> <src> <dst>."""
+
+import sys
+
+from units import convert
+
+
+def main(argv):
+    if len(argv) != 3:
+        print("usage: python3 -m units <value> <src> <dst>", file=sys.stderr)
+        return 2
+    value, src, dst = argv
+    try:
+        result = convert(float(value), src, dst)
+    except ValueError as exc:
+        print("error: %s" % (exc,), file=sys.stderr)
+        return 2
+    print("%.6g" % (result,))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
