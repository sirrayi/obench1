 """Unit conversion, see README.md."""
 
+# Factors to the base unit of each dimension. Unit names are case-sensitive.
+_FACTORS = {
+    "length": {"m": 1.0, "km": 1000.0, "cm": 0.01,
+               "mi": 1609.344, "ft": 0.3048, "in": 0.0254},
+    "mass": {"kg": 1.0, "g": 0.001,
+             "lb": 0.45359237, "oz": 0.45359237 / 16},
+    "temperature": {"C": 1.0, "F": 1.0, "K": 1.0},
+}
+
+_UNITS = {unit: dimension
+          for dimension, units in _FACTORS.items()
+          for unit in units}
+
+ABSOLUTE_ZERO_K = -1e-9
+
+
+def _to_kelvin(value, unit):
+    if unit == "C":
+        return value + 273.15
+    if unit == "F":
+        return (value - 32.0) * 5.0 / 9.0 + 273.15
+    return float(value)
+
+
+def _from_kelvin(kelvin, unit):
+    if unit == "C":
+        return kelvin - 273.15
+    if unit == "F":
+        return (kelvin - 273.15) * 9.0 / 5.0 + 32.0
+    return kelvin
+
 
 def convert(value, src, dst):
-    raise NotImplementedError
+    """Convert ``value`` from unit ``src`` to unit ``dst``, returning a float."""
+    try:
+        src_dimension = _UNITS[src]
+    except KeyError:
+        raise ValueError("unknown unit: %r" % (src,)) from None
+    try:
+        dst_dimension = _UNITS[dst]
+    except KeyError:
+        raise ValueError("unknown unit: %r" % (dst,)) from None
+    if src_dimension != dst_dimension:
+        raise ValueError(
+            "cannot convert %s to %s: different dimensions" % (src, dst))
+
+    value = float(value)
+
+    if src_dimension == "temperature":
+        kelvin = _to_kelvin(value, src)
+        if kelvin < ABSOLUTE_ZERO_K:
+            raise ValueError("temperature below absolute zero: %r %s"
+                             % (value, src))
+        return _from_kelvin(kelvin, dst)
+
+    return value * _FACTORS[src_dimension][src] / _FACTORS[src_dimension][dst]
