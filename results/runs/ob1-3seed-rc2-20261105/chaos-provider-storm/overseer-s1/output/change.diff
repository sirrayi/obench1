+"""Command line interface: python3 -m units <value> <src> <dst>."""
+
+import sys
+
+from units import convert
+
+
+def main(argv=None):
+    args = sys.argv[1:] if argv is None else argv
+    if len(args) != 3:
+        print("usage: python3 -m units <value> <src> <dst>", file=sys.stderr)
+        return 2
+    raw_value, src, dst = args
+    try:
+        value = float(raw_value)
+        result = convert(value, src, dst)
+    except ValueError as exc:
+        print("error: %s" % (exc,), file=sys.stderr)
+        return 2
+    print("%.6g" % result)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
