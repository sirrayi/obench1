+"""CLI: python3 -m units <value> <src> <dst>."""
+
+import sys
+
+from . import convert
+
+_USAGE = "usage: python3 -m units <value> <src> <dst>"
+
+
+def main(argv=None):
+    args = sys.argv[1:] if argv is None else list(argv)
+    if len(args) != 3:
+        print(_USAGE, file=sys.stderr)
+        return 2
+    value_text, src, dst = args
+    try:
+        result = convert(float(value_text), src, dst)
+    except (ValueError, OverflowError) as error:
+        print("error: %s" % error, file=sys.stderr)
+        return 2
+    print("%.6g" % result)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
