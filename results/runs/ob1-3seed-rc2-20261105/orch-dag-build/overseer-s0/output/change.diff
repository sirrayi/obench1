+    ("lower", "acc_city"),
+    ("rename", "acc_city", "accounts_city"),
+    ("strip", "acc_tier"),
+    ("strip", "accounts_city"),
+    ("upper", "accounts_city"),
+    ("cents", "acc_amount"),
+    ("strip", "acc_region"),
