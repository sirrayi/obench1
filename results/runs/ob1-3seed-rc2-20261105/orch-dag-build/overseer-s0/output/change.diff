diff --git a/clients/_rules.py b/clients/_rules.py
new file mode 100644
index 0000000..28e94af
--- /dev/null
+++ b/clients/_rules.py
@@ -0,0 +1,101 @@
+"""Primitive record rules shared by the client normalizers."""
+
+from datetime import date
+from decimal import Decimal, ROUND_HALF_UP
+
+TRUE_VALUES = ("yes", "true", "1")
+FALSE_VALUES = ("no", "false", "0")
+
+
+def _require(record, field):
+    if field not in record:
+        raise ValueError("missing required field: %s" % field)
+
+
+def _default(record, field, value):
+    record.setdefault(field, value)
+
+
+def _strip(record, field):
+    if field in record:
+        record[field] = record[field].strip()
+
+
+def _lower(record, field):
+    if field in record:
+        record[field] = record[field].lower()
+
+
+def _upper(record, field):
+    if field in record:
+        record[field] = record[field].upper()
+
+
+def _rename(record, source, target):
+    if source in record:
+        record[target] = record.pop(source)
+
+
+def _drop(record, field):
+    record.pop(field, None)
+
+
+def _cents(record, field):
+    if field in record:
+        value = Decimal(str(record[field]).strip()) * 100
+        record[field] = int(value.quantize(Decimal(1), rounding=ROUND_HALF_UP))
+
+
+def _bool(record, field):
+    if field in record:
+        value = record[field]
+        if isinstance(value, bool):
+            return
+        key = "".join(str(value).split()).lower()
+        if key in TRUE_VALUES:
+            record[field] = True
+        elif key in FALSE_VALUES:
+            record[field] = False
+        else:
+            raise ValueError("not a boolean: %r" % (value,))
+
+
+def _iso_date(record, field):
+    if field in record:
+        raw = "".join(str(record[field]).split())
+        parts = raw.split("/")
+        if len(parts) != 3 or not all(part.isdigit() for part in parts):
+            raise ValueError("not a DD/MM/YYYY date: %r" % (record[field],))
+        day, month, year = (int(part) for part in parts)
+        record[field] = date(year, month, day).isoformat()
+
+
+def _split(record, field, separator):
+    if field in record:
+        record[field] = [
+            piece.strip()
+            for piece in str(record[field]).split(separator)
+            if piece.strip()
+        ]
+
+
+OPS = {
+    "require": _require,
+    "default": _default,
+    "strip": _strip,
+    "lower": _lower,
+    "upper": _upper,
+    "rename": _rename,
+    "drop": _drop,
+    "cents": _cents,
+    "bool": _bool,
+    "iso-date": _iso_date,
+    "split": _split,
+}
+
+
+def run(record, rules):
+    result = dict(record)
+    for rule in rules:
+        OPS[rule[0]](result, *rule[1:])
+    return result
