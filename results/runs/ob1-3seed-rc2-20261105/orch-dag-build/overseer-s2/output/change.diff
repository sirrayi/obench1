diff --git a/clients/_engine.py b/clients/_engine.py
new file mode 100644
index 0000000..15eb159
--- /dev/null
+++ b/clients/_engine.py
@@ -0,0 +1,90 @@
+"""Rule engine shared by the record normalizers. See specs/RULES.md."""
+
+from datetime import date
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+
+TRUE_WORDS = ("yes", "true", "1")
+FALSE_WORDS = ("no", "false", "0")
+
+
+def _compact(value):
+    """The value as text with every whitespace character removed."""
+    return "".join(str(value).split())
+
+
+def to_cents(value):
+    try:
+        amount = Decimal(_compact(value)) * 100
+        return int(amount.quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+    except (InvalidOperation, ValueError) as exc:
+        raise ValueError("not an amount: {!r}".format(value)) from exc
+
+
+def to_bool(value):
+    if isinstance(value, bool):
+        return value
+    word = _compact(value).lower()
+    if word in TRUE_WORDS:
+        return True
+    if word in FALSE_WORDS:
+        return False
+    raise ValueError("not a boolean: {!r}".format(value))
+
+
+def to_iso_date(value):
+    parts = _compact(value).split("/")
+    if len(parts) != 3:
+        raise ValueError("not a DD/MM/YYYY date: {!r}".format(value))
+    try:
+        day, month, year = (int(part) for part in parts)
+        return date(year, month, day).isoformat()
+    except ValueError as exc:
+        raise ValueError("invalid date: {!r}".format(value)) from exc
+
+
+def split_on(value, separator):
+    pieces = (piece.strip() for piece in str(value).split(separator))
+    return [piece for piece in pieces if piece]
+
+
+def _string_method(data, field, method):
+    value = data[field]
+    if isinstance(value, str):
+        data[field] = getattr(value, method)()
+
+
+def apply_rules(record, rules, depends=None):
+    """Return a normalized copy of record with rules applied in order."""
+    data = dict(record)
+    if depends is not None:
+        data = dict(depends(data))
+    for rule in rules:
+        op = rule[0]
+        field = rule[1] if len(rule) > 1 else None
+        if op == "require":
+            if field not in data:
+                raise ValueError("missing required field: {}".format(field))
+            continue
+        if op == "default":
+            if field not in data:
+                data[field] = rule[2]
+            continue
+        if field not in data:
+            continue
+        if op in ("strip", "lower", "upper"):
+            _string_method(data, field, op)
+        elif op == "rename":
+            data[rule[2]] = data.pop(field)
+        elif op == "drop":
+            del data[field]
+        elif op == "cents":
+            data[field] = to_cents(data[field])
+        elif op == "bool":
+            data[field] = to_bool(data[field])
+        elif op == "iso-date":
+            data[field] = to_iso_date(data[field])
+        elif op == "split":
+            data[field] = split_on(data[field], rule[2])
+        else:
+            raise ValueError("unknown rule: {}".format(op))
+    return data
