diff --git a/clients/_rules.py b/clients/_rules.py
new file mode 100644
index 0000000..59b1501
--- /dev/null
+++ b/clients/_rules.py
@@ -0,0 +1,74 @@
+"""Shared rule engine implementing specs/RULES.md."""
+
+from datetime import date
+from decimal import Decimal, ROUND_HALF_UP
+
+_TRUE = {"yes", "true", "1"}
+_FALSE = {"no", "false", "0"}
+
+
+def _iso_date(value):
+    text = "".join(str(value).split())
+    day, month, year = text.split("/")
+    return date(int(year), int(month), int(day)).isoformat()
+
+
+def _cents(value):
+    text = "".join(str(value).split())
+    amount = Decimal(text) * 100
+    return int(amount.quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+
+
+def _bool(value):
+    text = "".join(str(value).split()).lower()
+    if text in _TRUE:
+        return True
+    if text in _FALSE:
+        return False
+    raise ValueError(f"invalid bool value: {value!r}")
+
+
+def apply_rules(record, rules):
+    """Apply ordered rules to a copy of record and return it."""
+    result = dict(record)
+    for rule in rules:
+        op, field, *args = rule
+        if op == "require":
+            if field not in result:
+                raise ValueError(f"missing required field: {field}")
+        elif op == "default":
+            if field not in result:
+                result[field] = args[0]
+        elif op == "strip":
+            if field in result:
+                result[field] = result[field].strip()
+        elif op == "lower":
+            if field in result:
+                result[field] = result[field].lower()
+        elif op == "upper":
+            if field in result:
+                result[field] = result[field].upper()
+        elif op == "rename":
+            if field in result:
+                result[args[0]] = result.pop(field)
+        elif op == "drop":
+            result.pop(field, None)
+        elif op == "cents":
+            if field in result:
+                result[field] = _cents(result[field])
+        elif op == "bool":
+            if field in result:
+                result[field] = _bool(result[field])
+        elif op == "iso-date":
+            if field in result:
+                result[field] = _iso_date(result[field])
+        elif op == "split":
+            if field in result:
+                result[field] = [
+                    piece.strip()
+                    for piece in result[field].split(args[0])
+                    if piece.strip()
+                ]
+        else:
+            raise ValueError(f"unknown rule: {op}")
+    return result
