diff --git a/clients/_rules.py b/clients/_rules.py
new file mode 100644
index 0000000..c7a7a1d
--- /dev/null
+++ b/clients/_rules.py
@@ -0,0 +1,130 @@
+"""Shared rule engine for the record normalizers described in specs/RULES.md."""
+
+import datetime
+import re
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+
+_DATE_RE = re.compile(r"(\d{1,2})/(\d{1,2})/(\d{4})", re.ASCII)
+
+
+def _squash(value):
+    """Return the value as a string with all whitespace removed."""
+    return "".join(str(value).split())
+
+
+def _as_text(value):
+    return value if isinstance(value, str) else str(value)
+
+
+def _require(rec, field):
+    if field not in rec:
+        raise ValueError(f"missing required field: {field}")
+
+
+def _default(rec, field, value):
+    if field not in rec:
+        rec[field] = value
+
+
+def _strip(rec, field):
+    if field in rec:
+        rec[field] = _as_text(rec[field]).strip()
+
+
+def _lower(rec, field):
+    if field in rec:
+        rec[field] = _as_text(rec[field]).lower()
+
+
+def _upper(rec, field):
+    if field in rec:
+        rec[field] = _as_text(rec[field]).upper()
+
+
+def _rename(rec, old, new):
+    if old in rec:
+        rec[new] = rec.pop(old)
+
+
+def _drop(rec, field):
+    if field in rec:
+        del rec[field]
+
+
+def _cents(rec, field):
+    if field not in rec:
+        return
+    value = rec[field]
+    if isinstance(value, str):
+        try:
+            amount = Decimal(_squash(value))
+        except InvalidOperation:
+            raise ValueError(f"{field}: not a number") from None
+    elif isinstance(value, bool):
+        amount = Decimal(int(value))
+    elif isinstance(value, int):
+        amount = Decimal(value)
+    elif isinstance(value, float):
+        amount = Decimal(str(value))
+    elif isinstance(value, Decimal):
+        amount = value
+    else:
+        raise ValueError(f"{field}: not a number")
+    rec[field] = int(
+        (amount * 100).quantize(Decimal(1), rounding=ROUND_HALF_UP)
+    )
+
+
+def _bool(rec, field):
+    if field not in rec:
+        return
+    value = rec[field]
+    if isinstance(value, bool):
+        return
+    token = _squash(value).lower()
+    if token in ("yes", "true", "1"):
+        rec[field] = True
+    elif token in ("no", "false", "0"):
+        rec[field] = False
+    else:
+        raise ValueError(f"{field}: not a boolean")
+
+
+def _iso_date(rec, field):
+    if field not in rec:
+        return
+    match = _DATE_RE.fullmatch(_squash(rec[field]))
+    if match is None:
+        raise ValueError(f"{field}: not a date")
+    day, month, year = (int(part) for part in match.groups())
+    rec[field] = datetime.date(year, month, day).isoformat()
+
+
+def _split(rec, field, separator):
+    if field not in rec:
+        return
+    pieces = (piece.strip() for piece in _as_text(rec[field]).split(separator))
+    rec[field] = [piece for piece in pieces if piece]
+
+
+_RULES = {
+    "require": _require,
+    "default": _default,
+    "strip": _strip,
+    "lower": _lower,
+    "upper": _upper,
+    "rename": _rename,
+    "drop": _drop,
+    "cents": _cents,
+    "bool": _bool,
+    "iso-date": _iso_date,
+    "split": _split,
+}
+
+
+def run(rules, record: dict) -> dict:
+    """Apply an ordered rule tuple to a copy of the record."""
+    rec = dict(record)
+    for rule in rules:
+        _RULES[rule[0]](rec, *rule[1:])
+    return rec
