+"""Normalizer for accounts records."""
+
+from ._rules import run
+
+RULES = (
+    ("require", "acc_ref"),
+    ("rename", "acc_vip", "accounts_vip"),
+    ("strip", "acc_owner"),
+    ("default", "acc_label", "unknown"),
+    ("rename", "acc_fee", "accounts_fee"),
+    ("lower", "acc_label"),
+    ("default", "acc_region", "unknown"),
+    ("default", "acc_tier", "unknown"),
+    ("default", "acc_amount", "0.00"),
+    ("bool", "accounts_vip"),
+    ("cents", "accounts_fee"),
+    ("lower", "acc_tier"),
+    ("upper", "acc_ref"),
+    ("lower", "acc_city"),
+    ("rename", "acc_city", "accounts_city"),
+    ("strip", "acc_tier"),
+    ("strip", "accounts_city"),
+    ("upper", "accounts_city"),
+    ("cents", "acc_amount"),
+    ("strip", "acc_region"),
+    ("rename", "acc_region", "accounts_region"),
+    ("upper", "accounts_region"),
+    ("strip", "acc_ref"),
+    ("rename", "acc_amount", "accounts_amount"),
+    ("drop", "acc_ref"),
+)
+
+
+def normalize(record: dict) -> dict:
+    return run(RULES, record)
