diff --git a/clients/_rules.py b/clients/_rules.py
new file mode 100644
index 0000000..e312188
--- /dev/null
+++ b/clients/_rules.py
@@ -0,0 +1,100 @@
+"""Rule engine shared by the per-service normalizers.
+
+The rules and their meanings are described in specs/RULES.md.  ``apply_rules``
+works on a copy of the record, applying each rule in order; a rule naming a
+field that is absent does nothing, except ``require`` and ``default``.
+"""
+
+from datetime import date
+from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
+
+_TRUE = frozenset({"yes", "true", "1"})
+_FALSE = frozenset({"no", "false", "0"})
+
+
+def _squash(value):
+    """Return ``value`` as text with every whitespace character removed."""
+    return "".join(str(value).split())
+
+
+def _cents(value):
+    """Value (number or numeric string) as integer cents, rounded half up."""
+    text = value.strip() if isinstance(value, str) else str(value)
+    try:
+        amount = Decimal(text)
+    except InvalidOperation:
+        raise ValueError("not a number: %r" % (value,)) from None
+    if not amount.is_finite():
+        raise ValueError("not a number: %r" % (value,))
+    return int((amount * 100).quantize(Decimal(1), rounding=ROUND_HALF_UP))
+
+
+def _bool(value):
+    """yes/true/1 -> True, no/false/0 -> False, anything else is an error."""
+    if isinstance(value, bool):
+        return value
+    text = _squash(value).lower()
+    if text in _TRUE:
+        return True
+    if text in _FALSE:
+        return False
+    raise ValueError("not a boolean: %r" % (value,))
+
+
+def _iso_date(value):
+    """DD/MM/YYYY (whitespace ignored) -> YYYY-MM-DD."""
+    parts = _squash(value).split("/")
+    if len(parts) != 3:
+        raise ValueError("not a date: %r" % (value,))
+    day, month, year = (int(piece) for piece in parts)
+    return date(year, month, day).isoformat()
+
+
+def _split(value, separator):
+    """Split on ``separator``, stripping pieces and dropping empty ones."""
+    if not isinstance(value, str):
+        value = str(value)
+    return [piece.strip() for piece in value.split(separator) if piece.strip()]
+
+
+def _text_rule(record, field, transform):
+    if field in record and isinstance(record[field], str):
+        record[field] = transform(record[field])
+
+
+def apply_rules(record, rules):
+    """Return a normalized copy of ``record`` with ``rules`` applied in order."""
+    out = dict(record)
+    for rule in rules:
+        op = rule[0]
+        if op == "require":
+            if rule[1] not in out:
+                raise ValueError("missing field: %s" % rule[1])
+        elif op == "default":
+            out.setdefault(rule[1], rule[2])
+        elif op == "rename":
+            if rule[1] in out:
+                out[rule[2]] = out.pop(rule[1])
+        elif op == "drop":
+            out.pop(rule[1], None)
+        elif op == "strip":
+            _text_rule(out, rule[1], str.strip)
+        elif op == "lower":
+            _text_rule(out, rule[1], str.lower)
+        elif op == "upper":
+            _text_rule(out, rule[1], str.upper)
+        elif op == "cents":
+            if rule[1] in out:
+                out[rule[1]] = _cents(out[rule[1]])
+        elif op == "bool":
+            if rule[1] in out:
+                out[rule[1]] = _bool(out[rule[1]])
+        elif op == "iso-date":
+            if rule[1] in out:
+                out[rule[1]] = _iso_date(out[rule[1]])
+        elif op == "split":
+            if rule[1] in out:
+                out[rule[1]] = _split(out[rule[1]], rule[2])
+        else:
+            raise ValueError("unknown rule: %r" % (rule,))
+    return out
