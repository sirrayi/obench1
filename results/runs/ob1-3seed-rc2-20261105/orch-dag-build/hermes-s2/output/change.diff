@@ -0,0 +1,43 @@
+"""Normalizer for raw contacts records."""
+
+from ._rules import apply_rules
+try:
+    from .customers import normalize as _normalize_customers
+except ImportError:  # pragma: no cover - allows importing the module standalone
+    from clients.customers import normalize as _normalize_customers
+
+
+
+RULES = [
+    "require con_code",
+    "require con_tags",
+    "iso-date con_due",
+    "upper con_code",
+    "default con_country = unknown",
+    "strip con_name",
+    "upper con_country",
+    "rename con_due -> contacts_due",
+    "default con_vip = no",
+    "strip con_code",
+    "lower con_name",
+    "require con_email",
+    "split con_tags on ;",
+    "default con_amount = 0.00",
+    "rename con_amount -> contacts_amount",
+    "upper con_name",
+    "cents contacts_amount",
+    "strip con_email",
+    "bool con_vip",
+    "rename con_name -> contacts_name",
+    "require con_city",
+    "upper con_city",
+    "lower con_city",
+    "rename con_city -> contacts_city",
+    "strip contacts_city",
+]
+
+
+def normalize(record: dict) -> dict:
+    """Return a normalized copy of one raw contacts record."""
+    record = _normalize_customers(record)
+    return apply_rules(record, RULES)
