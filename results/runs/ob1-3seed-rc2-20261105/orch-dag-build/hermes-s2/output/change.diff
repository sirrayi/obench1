diff --git a/clients/_rules.py b/clients/_rules.py
new file mode 100644
index 0000000..6380540
--- /dev/null
+++ b/clients/_rules.py
@@ -0,0 +1,107 @@
+"""Small rule engine shared by the record normalizers.
+
+A rule is a short string such as "strip acc_owner" or "rename acc_fee ->
+accounts_fee"; see specs/RULES.md for the meaning of each rule.
+"""
+
+import re
+from datetime import datetime
+from decimal import Decimal, ROUND_HALF_UP
+
+_ABSENT = object()
+
+_TRUE = {"yes", "true", "1"}
+_FALSE = {"no", "false", "0"}
+
+
+def _bool_value(value):
+    if isinstance(value, bool):
+        return value
+    text = re.sub(r"\s+", "", str(value)).lower()
+    if text in _TRUE:
+        return True
+    if text in _FALSE:
+        return False
+    raise ValueError("not a boolean: %r" % (value,))
+
+
+def _cents(value):
+    text = re.sub(r"\s+", "", str(value))
+    amount = Decimal(text) * 100
+    return int(amount.quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+
+
+def _iso_date(value):
+    text = re.sub(r"\s+", "", str(value))
+    parsed = datetime.strptime(text, "%d/%m/%Y")
+    return parsed.strftime("%Y-%m-%d")
+
+
+def _split(value, separator):
+    return [piece.strip() for piece in str(value).split(separator) if piece.strip()]
+
+
+_RENAME = re.compile(r"^rename (\S+) -> (\S+)$")
+_DEFAULT = re.compile(r"^default (\S+) = ?(.*)$")
+_SPLIT = re.compile(r"^split (\S+) on (\S)$")
+_SIMPLE = re.compile(r"^(require|strip|lower|upper|drop|cents|bool|iso-date) (\S+)$")
+
+
+def apply_rules(record, rules):
+    data = dict(record)
+
+    for rule in rules:
+        rule = rule.strip()
+
+        match = _RENAME.match(rule)
+        if match:
+            source, target = match.groups()
+            if source in data:
+                data[target] = data.pop(source)
+            continue
+
+        match = _DEFAULT.match(rule)
+        if match:
+            field, value = match.groups()
+            if field not in data:
+                data[field] = value
+            continue
+
+        match = _SPLIT.match(rule)
+        if match:
+            field, separator = match.groups()
+            if field in data:
+                data[field] = _split(data[field], separator)
+            continue
+
+        match = _SIMPLE.match(rule)
+        if not match:
+            raise ValueError("bad rule: %r" % (rule,))
+        operation, field = match.groups()
+
+        if operation == "require":
+            if field not in data:
+                raise ValueError("missing required field: %s" % (field,))
+            continue
+        if operation == "drop":
+            data.pop(field, None)
+            continue
+
+        if field not in data:
+            continue
+        value = data[field]
+
+        if operation == "strip":
+            data[field] = str(value).strip()
+        elif operation == "lower":
+            data[field] = str(value).lower()
+        elif operation == "upper":
+            data[field] = str(value).upper()
+        elif operation == "cents":
+            data[field] = _cents(value)
+        elif operation == "bool":
+            data[field] = _bool_value(value)
+        elif operation == "iso-date":
+            data[field] = _iso_date(value)
+
+    return data
diff --git a/clients/accounts.py b/clients/accounts.py
new file mode 100644
index 0000000..8b3a9dc
--- /dev/null
+++ b/clients/accounts.py
@@ -0,0 +1,36 @@
+"""Normalizer for raw accounts records."""
+
+from ._rules import apply_rules
+
+RULES = [
+    "require acc_ref",
+    "rename acc_vip -> accounts_vip",
+    "strip acc_owner",
+    "default acc_label = unknown",
+    "rename acc_fee -> accounts_fee",
+    "lower acc_label",
+    "default acc_region = unknown",
+    "default acc_tier = unknown",
+    "default acc_amount = 0.00",
+    "bool accounts_vip",
+    "cents accounts_fee",
+    "lower acc_tier",
+    "upper acc_ref",
+    "lower acc_city",
+    "rename acc_city -> accounts_city",
+    "strip acc_tier",
+    "strip accounts_city",
+    "upper accounts_city",
+    "cents acc_amount",
+    "strip acc_region",
+    "rename acc_region -> accounts_region",
+    "upper accounts_region",
+    "strip acc_ref",
+    "rename acc_amount -> accounts_amount",
+    "drop acc_ref",
+]
+
+
+def normalize(record: dict) -> dict:
+    """Return a normalized copy of one raw accounts record."""
+    return apply_rules(record, RULES)
