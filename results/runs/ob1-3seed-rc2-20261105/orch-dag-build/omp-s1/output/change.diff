index 0000000..b3e8f0c
--- /dev/null
+++ b/clients/_rules.py
@@ -0,0 +1,80 @@
+"""Rule primitives shared by the service normalizers."""
+
+from datetime import datetime
+from decimal import ROUND_HALF_UP, Decimal
+
+_TRUE = {"yes", "true", "1"}
+_FALSE = {"no", "false", "0"}
+
+
+def require(record, field):
+    if field not in record:
+        raise ValueError(f"missing required field: {field}")
+
+
+def default(record, field, value):
+    record.setdefault(field, value)
+
+
+def strip(record, field):
+    if field in record:
+        record[field] = record[field].strip()
+
+
+def lower(record, field):
+    if field in record:
+        record[field] = record[field].lower()
+
+
+def upper(record, field):
+    if field in record:
+        record[field] = record[field].upper()
+
+
+def rename(record, old, new):
+    if old in record:
+        record[new] = record.pop(old)
+
+
+def drop(record, field):
+    record.pop(field, None)
+
+
+def cents(record, field):
+    if field in record:
+        amount = Decimal(str(record[field]).strip()) * 100
+        record[field] = int(amount.to_integral_value(rounding=ROUND_HALF_UP))
+
+
+def to_bool(record, field):
+    if field not in record:
+        return
+    token = "".join(str(record[field]).split()).lower()
+    if token in _TRUE:
+        record[field] = True
+    elif token in _FALSE:
+        record[field] = False
+    else:
+        raise ValueError(f"invalid boolean for {field}: {record[field]!r}")
+
+
+def iso_date(record, field):
+    if field not in record:
+        return
+    text = "".join(str(record[field]).split())
+    try:
+        parsed = datetime.strptime(text, "%d/%m/%Y")
+    except ValueError as exc:
+        raise ValueError(f"invalid date for {field}: {record[field]!r}") from exc
+    record[field] = parsed.date().isoformat()
+
+
+def split_field(record, field, separator):
+    if field not in record:
+        return
+    pieces = []
+    for piece in record[field].split(separator):
+        piece = piece.strip()
+        if piece:
+            pieces.append(piece)
+    record[field] = pieces
