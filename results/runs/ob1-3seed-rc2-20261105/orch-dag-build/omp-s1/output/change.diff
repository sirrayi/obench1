@@ -0,0 +1,43 @@
+"""Accounts record normalizer."""
+
+from ._rules import (
+    cents,
+    default,
+    drop,
+    lower,
+    rename,
+    require,
+    strip,
+    to_bool,
+    upper,
+)
+
+
+def normalize(record: dict) -> dict:
+    result = dict(record)
+    require(result, "acc_ref")
+    rename(result, "acc_vip", "accounts_vip")
+    strip(result, "acc_owner")
+    default(result, "acc_label", "unknown")
+    rename(result, "acc_fee", "accounts_fee")
+    lower(result, "acc_label")
+    default(result, "acc_region", "unknown")
+    default(result, "acc_tier", "unknown")
+    default(result, "acc_amount", "0.00")
+    to_bool(result, "accounts_vip")
+    cents(result, "accounts_fee")
+    lower(result, "acc_tier")
+    upper(result, "acc_ref")
+    lower(result, "acc_city")
+    rename(result, "acc_city", "accounts_city")
+    strip(result, "acc_tier")
+    strip(result, "accounts_city")
+    upper(result, "accounts_city")
+    cents(result, "acc_amount")
+    strip(result, "acc_region")
+    rename(result, "acc_region", "accounts_region")
+    upper(result, "accounts_region")
+    strip(result, "acc_ref")
+    rename(result, "acc_amount", "accounts_amount")
+    drop(result, "acc_ref")
+    return result
