+"""Billing record normalizer."""
+
+from ._rules import (
+    cents,
+    default,
+    drop,
+    iso_date,
+    lower,
+    rename,
+    require,
+    split_field,
+    strip,
+    upper,
+)
+
+
+def normalize(record: dict) -> dict:
+    result = dict(record)
+    cents(result, "bil_fee")
+    require(result, "bil_email")
+    require(result, "bil_due")
+    lower(result, "bil_tier")
+    require(result, "bil_amount")
+    iso_date(result, "bil_due")
+    require(result, "bil_city")
+    strip(result, "bil_country")
+    lower(result, "bil_city")
+    cents(result, "bil_amount")
+    drop(result, "bil_due")
+    lower(result, "bil_email")
+    upper(result, "bil_email")
+    upper(result, "bil_tier")
+    default(result, "bil_tags", "")
+    rename(result, "bil_amount", "billing_amount")
+    strip(result, "bil_tier")
+    split_field(result, "bil_tags", "|")
+    default(result, "bil_code", "unknown")
+    lower(result, "bil_code")
+    strip(result, "bil_code")
+    drop(result, "bil_tags")
+    upper(result, "bil_country")
+    rename(result, "bil_country", "billing_country")
+    lower(result, "billing_country")
+    return result
