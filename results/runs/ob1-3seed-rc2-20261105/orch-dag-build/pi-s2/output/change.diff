diff --git a/clients/_rules.py b/clients/_rules.py
new file mode 100644
index 0000000..e53ae7e
--- /dev/null
+++ b/clients/_rules.py
@@ -0,0 +1,66 @@
+from decimal import Decimal, ROUND_HALF_UP
+from datetime import datetime
+
+_TRUE = {"yes", "true", "1"}
+_FALSE = {"no", "false", "0"}
+
+
+def _has(record, field):
+    return field in record
+
+
+def apply_rules(record, rules):
+    result = dict(record)
+    for rule in rules:
+        op = rule[0]
+        if op == "require":
+            field = rule[1]
+            if not _has(result, field):
+                raise ValueError("missing required field: " + field)
+        elif op == "default":
+            field, value = rule[1], rule[2]
+            if not _has(result, field):
+                result[field] = value
+        elif op in ("strip", "lower", "upper"):
+            field = rule[1]
+            if _has(result, field):
+                result[field] = getattr(result[field], op)()
+        elif op == "rename":
+            source, target = rule[1], rule[2]
+            if _has(result, source):
+                result[target] = result.pop(source)
+        elif op == "drop":
+            field = rule[1]
+            if _has(result, field):
+                del result[field]
+        elif op == "cents":
+            field = rule[1]
+            if _has(result, field):
+                value = Decimal("".join(str(result[field]).split()))
+                result[field] = int((value * 100).quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+        elif op == "bool":
+            field = rule[1]
+            if _has(result, field):
+                value = "".join(str(result[field]).split()).lower()
+                if value in _TRUE:
+                    result[field] = True
+                elif value in _FALSE:
+                    result[field] = False
+                else:
+                    raise ValueError("invalid boolean: " + field)
+        elif op == "iso-date":
+            field = rule[1]
+            if _has(result, field):
+                value = "".join(str(result[field]).split())
+                try:
+                    result[field] = datetime.strptime(value, "%d/%m/%Y").strftime("%Y-%m-%d")
+                except ValueError:
+                    raise ValueError("invalid date: " + field)
+        elif op == "split":
+            field, separator = rule[1], rule[2]
+            if _has(result, field):
+                pieces = [piece.strip() for piece in str(result[field]).split(separator)]
+                result[field] = [piece for piece in pieces if piece]
+        else:
+            raise ValueError("unknown rule: " + op)
+    return result
