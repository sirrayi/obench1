diff --git a/clients/_rules.py b/clients/_rules.py
new file mode 100644
index 0000000..663ddb0
--- /dev/null
+++ b/clients/_rules.py
@@ -0,0 +1,73 @@
+import re
+from datetime import date
+from decimal import Decimal, ROUND_HALF_UP
+
+
+_TRUE = {"yes", "true", "1"}
+_FALSE = {"no", "false", "0"}
+_DATE_RE = re.compile(r"(\d{2})/(\d{2})/(\d{4})")
+
+
+def _cents(value):
+    if isinstance(value, str):
+        value = value.strip()
+    amount = Decimal(str(value)) * 100
+    return int(amount.quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+
+
+def _bool(value):
+    text = "".join(str(value).split()).lower()
+    if text in _TRUE:
+        return True
+    if text in _FALSE:
+        return False
+    raise ValueError("invalid boolean: {!r}".format(value))
+
+
+def _iso_date(value):
+    text = "".join(str(value).split())
+    match = _DATE_RE.fullmatch(text)
+    if not match:
+        raise ValueError("invalid date: {!r}".format(value))
+    day, month, year = (int(part) for part in match.groups())
+    return date(year, month, day).isoformat()
+
+
+def _split(value, separator):
+    return [part.strip() for part in value.split(separator) if part.strip()]
+
+
+def apply_rules(record, rules):
+    result = dict(record)
+    for rule in rules:
+        op = rule[0]
+        field = rule[1]
+        if op == "require":
+            if field not in result:
+                raise ValueError("missing required field: {}".format(field))
+        elif op == "default":
+            if field not in result:
+                result[field] = rule[2]
+        elif op in ("strip", "lower", "upper"):
+            if field in result:
+                result[field] = getattr(result[field], op)()
+        elif op == "rename":
+            if field in result:
+                result[rule[2]] = result.pop(field)
+        elif op == "drop":
+            result.pop(field, None)
+        elif op == "cents":
+            if field in result:
+                result[field] = _cents(result[field])
+        elif op == "bool":
+            if field in result:
+                result[field] = _bool(result[field])
+        elif op == "iso-date":
+            if field in result:
+                result[field] = _iso_date(result[field])
+        elif op == "split":
+            if field in result:
+                result[field] = _split(result[field], rule[2])
+        else:
+            raise ValueError("unknown rule: {}".format(op))
+    return result
