@@ -1,6 +1,90 @@
 """Date ranges, see SPEC.md."""
+import calendar
 import datetime
+import re
+
+_DATE_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_MONTH_RE = re.compile(r"([0-9]{4})-([0-9]{2})")
+_WEEK_RE = re.compile(r"([0-9]{4})-W([0-9]{2})")
+_YEAR_RE = re.compile(r"([0-9]{4})")
+
+
+def _invalid(text):
+    raise ValueError("invalid date range component: {!r}".format(text))
+
+
+def _parse_unit(text):
+    """Parse one date unit into its first and last inclusive day."""
+    match = _DATE_RE.fullmatch(text)
+    if match:
+        year, month, day = (int(part) for part in match.groups())
+        try:
+            date = datetime.date(year, month, day)
+        except ValueError:
+            _invalid(text)
+        return date, date
+
+    match = _MONTH_RE.fullmatch(text)
+    if match:
+        year, month = (int(part) for part in match.groups())
+        if not 1 <= month <= 12:
+            _invalid(text)
+        try:
+            first = datetime.date(year, month, 1)
+        except ValueError:
+            _invalid(text)
+        last = first.replace(day=calendar.monthrange(year, month)[1])
+        return first, last
+
+    match = _WEEK_RE.fullmatch(text)
+    if match:
+        year, week = (int(part) for part in match.groups())
+        if not 1 <= week <= 53:
+            _invalid(text)
+        try:
+            monday = datetime.date.fromisocalendar(year, week, 1)
+            sunday = monday + datetime.timedelta(days=6)
+        except (ValueError, OverflowError):
+            _invalid(text)
+        return monday, sunday
+
+    match = _YEAR_RE.fullmatch(text)
+    if match:
+        year = int(match.group(1))
+        try:
+            return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+        except ValueError:
+            _invalid(text)
+
+    _invalid(text)
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Return the inclusive (start, end) dates described by *text*.
+
+    A missing end is represented by None. Malformed input raises ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError("date range must be a string")
+
+    text = text.strip()
+    if not text:
+        raise ValueError("empty date range")
+
+    if text.count("..") > 1:
+        raise ValueError("invalid date range: {!r}".format(text))
+
+    if ".." in text:
+        start_text, end_text = (part.strip() for part in text.split(".."))
+        if not start_text and not end_text:
+            raise ValueError("date range must have at least one end")
+
+        start = _parse_unit(start_text)[0] if start_text else None
+        end = _parse_unit(end_text)[1] if end_text else None
+        if start is not None and end is not None and end < start:
+            raise ValueError(
+                "date range ends before it starts: {!r}".format(text)
+            )
+        return start, end
+
+    return _parse_unit(text)
