+    def test_equal_endpoints(self):
+        self.assertEqual(
+            parse_range("2026-10-01..2026-10-01"),
+            (datetime.date(2026, 10, 1), datetime.date(2026, 10, 1)),
+        )
+
+    def test_month(self):
+        self.assertEqual(
+            parse_range("2026-02"),
+            (datetime.date(2026, 2, 1), datetime.date(2026, 2, 28)),
+        )
+        self.assertEqual(
+            parse_range("2028-02"),
+            (datetime.date(2028, 2, 1), datetime.date(2028, 2, 29)),
+        )
+        self.assertEqual(
+            parse_range("2026-12"),
+            (datetime.date(2026, 12, 1), datetime.date(2026, 12, 31)),
+        )
+
+    def test_iso_week(self):
+        self.assertEqual(
+            parse_range("2026-W44"),
+            (datetime.date(2026, 10, 26), datetime.date(2026, 11, 1)),
+        )
+
+    def test_iso_week_across_calendar_year(self):
+        self.assertEqual(
+            parse_range("2026-W01"),
+            (datetime.date(2025, 12, 29), datetime.date(2026, 1, 4)),
+        )
+
+    def test_iso_week_53(self):
+        self.assertEqual(
+            parse_range("2026-W53"),
+            (datetime.date(2026, 12, 28), datetime.date(2027, 1, 3)),
+        )
+
+    def test_single_date_is_one_day(self):
+        day = datetime.date(2026, 10, 1)
+        self.assertEqual(parse_range("2026-10-01"), (day, day))
+
+    def test_range_with_coarse_endpoints(self):
+        self.assertEqual(
+            parse_range("2026-10..2026-12"),
+            (datetime.date(2026, 10, 1), datetime.date(2026, 12, 31)),
+        )
+        self.assertEqual(
+            parse_range("2026-W44..2026-11"),
+            (datetime.date(2026, 10, 26), datetime.date(2026, 11, 30)),
+        )
+
+    def test_year(self):
+        self.assertEqual(
+            parse_range("2026"),
+            (datetime.date(2026, 1, 1), datetime.date(2026, 12, 31)),
+        )
+
+    def test_open_start(self):
+        self.assertEqual(
+            parse_range("..2026-10-31"),
+            (None, datetime.date(2026, 10, 31)),
+        )
+
+    def test_open_end(self):
+        self.assertEqual(
+            parse_range("2026-10-01.."),
+            (datetime.date(2026, 10, 1), None),
+        )
+
+    def test_surrounding_spaces(self):
+        self.assertEqual(
+            parse_range("  2026-10-01..2026-10-31  "),
