+
+    def test_malformed_inputs(self):
+        malformed = [
+            "",
+            "   ",
+            "..",
+            " .. ",
+            "2026-13",
+            "2026-00",
+            "2026-W54",
+            "2026-W00",
+            "2026-W1",
+            "2026-02-30",
+            "2026-1-1",
+            "2026-10-1",
+            "20261001",
+            "2026/10/01",
+            "26-10-01",
+            "not a date",
+            "2026-10-01..2026-10-32",
+            "2026-10-01..oops",
+            "oops..2026-10-01",
+            "2026-10-01...2026-10-31",
+            "2026-10-01....2026-10-31",
+            "2026-10-01..2026-10-31..2026-11-01",
+            "2026-13..2026-14",
+            "2026-W54..2026-W55",
+        ]
+        for text in malformed:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_range(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
