 """Date ranges, see SPEC.md."""
+import calendar
 import datetime
+import re
+
+_SEPARATOR = ".."
+
+_DATE_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_MONTH_RE = re.compile(r"([0-9]{4})-([0-9]{2})")
+_WEEK_RE = re.compile(r"([0-9]{4})-W([0-9]{2})")
+_YEAR_RE = re.compile(r"([0-9]{4})")
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Return the inclusive ``(start, end)`` day range described by ``text``.
+
+    Each side of an optional ``..`` separator denotes a span of days:
+
+    * ``YYYY-MM-DD`` - that single day;
+    * ``YYYY-MM`` - the whole month, first to last day;
+    * ``YYYY-Www`` - the ISO week ``ww`` of ``YYYY``, Monday to Sunday;
+    * ``YYYY`` - the whole year.
+
+    A value on its own yields its own span, ``A..B`` yields the first day of
+    ``A`` through the last day of ``B``, and a missing side is reported as
+    ``None``.  ``start`` is never later than ``end``.
+
+    Raises ``ValueError`` for empty or malformed input, for ``..`` alone, and
+    for a range whose first day is after its last day.
+    """
+    body = _checked(text)
+    parts = body.split(_SEPARATOR)
+
+    if len(parts) == 1:
+        return _span(parts[0].strip())
+
+    if len(parts) != 2:
+        raise ValueError(f"expected at most one '..' in {text!r}")
+
+    left = parts[0].strip()
+    right = parts[1].strip()
+    if not left and not right:
+        raise ValueError(f"open range without a bound: {text!r}")
+
+    start = None if not left else _span(left)[0]
+    end = None if not right else _span(right)[1]
+    if start is not None and end is not None and start > end:
+        raise ValueError(f"range ends before it starts: {text!r}")
+    return start, end
+
+
+def _checked(text):
+    """Return ``text`` without its surrounding spaces, or raise if unusable."""
+    if not isinstance(text, str):
+        raise ValueError(f"expected a string, got {type(text).__name__}")
+    body = text.strip()
+    if not body:
+        raise ValueError("empty date range")
+    return body
+
+
+def _span(value):
+    """Return the ``(first, last)`` day denoted by a single bound ``value``."""
+    match = _DATE_RE.fullmatch(value)
+    if match is not None:
+        day = _make_date(match.group(1), match.group(2), match.group(3), value)
+        return day, day
+
+    match = _MONTH_RE.fullmatch(value)
+    if match is not None:
+        year, month = int(match.group(1)), int(match.group(2))
+        first = _make_date(year, month, 1, value)
+        return first, datetime.date(year, month, calendar.monthrange(year, month)[1])
+
+    match = _WEEK_RE.fullmatch(value)
+    if match is not None:
+        year, week = int(match.group(1)), int(match.group(2))
+        try:
+            monday = datetime.date.fromisocalendar(year, week, 1)
+            sunday = datetime.date.fromisocalendar(year, week, 7)
+        except ValueError:
+            raise ValueError(f"invalid ISO week: {value!r}") from None
+        return monday, sunday
+
+    match = _YEAR_RE.fullmatch(value)
+    if match is not None:
+        year = int(match.group(1))
+        try:
+            return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+        except ValueError:
+            raise ValueError(f"invalid year: {value!r}") from None
+
+    raise ValueError(f"not a date, month, ISO week or year: {value!r}")
+
+
+def _make_date(year, month, day, value):
+    """Build a date from the regex groups of ``value``, or raise."""
+    try:
+        return datetime.date(int(year), int(month), int(day))
+    except ValueError:
+        raise ValueError(f"invalid date: {value!r}") from None
