 """Date ranges, see SPEC.md."""
 import datetime
+import re
+
+_DATE_RE = re.compile(r"(\d{4})-(\d{2})-(\d{2})")
+_MONTH_RE = re.compile(r"(\d{4})-(\d{2})")
+_WEEK_RE = re.compile(r"(\d{4})-W(\d{2})")
+_YEAR_RE = re.compile(r"(\d{4})")
+
+
+def _parse_token(text):
+    """Return the inclusive (first, last) day covered by one date or period token."""
+    match = _DATE_RE.fullmatch(text)
+    if match:
+        day = datetime.date(*(int(part) for part in match.groups()))
+        return day, day
+
+    match = _MONTH_RE.fullmatch(text)
+    if match:
+        year, month = (int(part) for part in match.groups())
+        first = datetime.date(year, month, 1)
+        if month == 12:
+            following = datetime.date(year + 1, 1, 1)
+        else:
+            following = datetime.date(year, month + 1, 1)
+        return first, following - datetime.timedelta(days=1)
+
+    match = _WEEK_RE.fullmatch(text)
+    if match:
+        year, week = (int(part) for part in match.groups())
+        return (
+            datetime.date.fromisocalendar(year, week, 1),
+            datetime.date.fromisocalendar(year, week, 7),
+        )
+
+    match = _YEAR_RE.fullmatch(text)
+    if match:
+        year = int(match.group(1))
+        return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+
+    raise ValueError("invalid date, month, week or year: {!r}".format(text))
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse a date range such as ``2026-01-01..2026-03-31`` into a pair of dates.
+
+    Either end may be omitted (``..B``, ``A..``) and is returned as None.
+    Single tokens (``YYYY-MM``, ``YYYY-Www``, ``YYYY``) expand to their full
+    span.  Raises ValueError for malformed input or a range that ends before
+    it starts.
+    """
+    if not isinstance(text, str):
+        raise ValueError("range must be a string, got {!r}".format(type(text).__name__))
+
+    parts = [part.strip() for part in text.strip().split("..")]
+    if len(parts) == 1:
+        if not parts[0]:
+            raise ValueError("empty date range: {!r}".format(text))
+        return _parse_token(parts[0])
+    if len(parts) != 2:
+        raise ValueError("not a date range: {!r}".format(text))
+
+    start_text, end_text = parts
+    if not start_text and not end_text:
+        raise ValueError("empty date range: {!r}".format(text))
+
+    start = end = None
+    if start_text:
+        start, _ = _parse_token(start_text)
+    if end_text:
+        _, end = _parse_token(end_text)
+
+    if start is not None and end is not None and end < start:
+        raise ValueError("range end is before its start: {!r}".format(text))
+    return start, end
