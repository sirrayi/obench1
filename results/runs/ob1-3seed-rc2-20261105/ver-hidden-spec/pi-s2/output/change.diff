 """Date ranges, see SPEC.md."""
+import calendar
 import datetime
+import re
+
+
+_DATE_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_MONTH_RE = re.compile(r"([0-9]{4})-([0-9]{2})")
+_WEEK_RE = re.compile(r"([0-9]{4})-W([0-9]{2})")
+_YEAR_RE = re.compile(r"([0-9]{4})")
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse an inclusive date range as described in SPEC.md."""
+    if not isinstance(text, str):
+        raise ValueError("date range must be text")
+
+    value = text.strip(" ")
+    if not value:
+        raise ValueError("date range is empty")
+
+    if ".." not in value:
+        return _parse_standalone(value)
+
+    left, _, right = value.partition("..")
+    if ".." in right:
+        raise ValueError("invalid date range: {!r}".format(text))
+
+    left = left.strip(" ")
+    right = right.strip(" ")
+    if not left and not right:
+        raise ValueError("date range must have at least one end")
+
+    start = _parse_date(left) if left else None
+    end = _parse_date(right) if right else None
+    if start is not None and end is not None and end < start:
+        raise ValueError("range end precedes range start")
+    return start, end
+
+
+def _parse_standalone(value):
+    match = _MONTH_RE.fullmatch(value)
+    if match:
+        year, month = (int(part) for part in match.groups())
+        try:
+            first = datetime.date(year, month, 1)
+            last = datetime.date(year, month, calendar.monthrange(year, month)[1])
+        except ValueError:
+            raise ValueError("invalid month: {!r}".format(value)) from None
+        return first, last
+
+    match = _WEEK_RE.fullmatch(value)
+    if match:
+        year, week = (int(part) for part in match.groups())
+        try:
+            return (
+                datetime.date.fromisocalendar(year, week, 1),
+                datetime.date.fromisocalendar(year, week, 7),
+            )
+        except ValueError:
+            raise ValueError("invalid ISO week: {!r}".format(value)) from None
+
+    match = _YEAR_RE.fullmatch(value)
+    if match:
+        year = int(match.group(1))
+        try:
+            return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+        except ValueError:
+            raise ValueError("invalid year: {!r}".format(value)) from None
+
+    raise ValueError("invalid date range: {!r}".format(value))
+
+
+def _parse_date(value):
+    match = _DATE_RE.fullmatch(value)
+    if not match:
+        raise ValueError("invalid ISO date: {!r}".format(value))
+    year, month, day = (int(part) for part in match.groups())
+    try:
+        return datetime.date(year, month, day)
+    except ValueError:
+        raise ValueError("invalid ISO date: {!r}".format(value)) from None
