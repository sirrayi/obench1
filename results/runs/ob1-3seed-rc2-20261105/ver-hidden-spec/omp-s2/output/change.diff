@@ -1,6 +1,78 @@
 """Date ranges, see SPEC.md."""
 import datetime
+import re
+
+_DATE = re.compile(r"(\d{4})-(\d{2})-(\d{2})")
+_MONTH = re.compile(r"(\d{4})-(\d{2})")
+_WEEK = re.compile(r"(\d{4})-W(\d{2})")
+_YEAR = re.compile(r"(\d{4})")
+
+
+def _parse_endpoint(text):
+    """Return the inclusive (first, last) day described by one endpoint."""
+    match = _DATE.fullmatch(text)
+    if match:
+        try:
+            day = datetime.date(*map(int, match.groups()))
+        except ValueError:
+            raise ValueError(f"invalid date: {text!r}") from None
+        return day, day
+
+    match = _MONTH.fullmatch(text)
+    if match:
+        year, month = map(int, match.groups())
+        try:
+            first = datetime.date(year, month, 1)
+        except ValueError:
+            raise ValueError(f"invalid month: {text!r}") from None
+        if month == 12:
+            last = datetime.date(year, 12, 31)
+        else:
+            last = datetime.date(year, month + 1, 1) - datetime.timedelta(days=1)
+        return first, last
+
+    match = _WEEK.fullmatch(text)
+    if match:
+        year, week = map(int, match.groups())
+        try:
+            first = datetime.date.fromisocalendar(year, week, 1)
+            last = first + datetime.timedelta(days=6)
+        except (ValueError, OverflowError):
+            raise ValueError(f"invalid ISO week: {text!r}") from None
+        return first, last
+
+    match = _YEAR.fullmatch(text)
+    if match:
+        year = int(match.group(1))
+        try:
+            return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+        except ValueError:
+            raise ValueError(f"invalid year: {text!r}") from None
+
+    raise ValueError(f"invalid date: {text!r}")
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse an inclusive range, or a standalone month/week/year shorthand."""
+    if not isinstance(text, str):
+        raise ValueError(f"range must be a string: {text!r}")
+    text = text.strip()
+    if not text:
+        raise ValueError(f"invalid range: {text!r}")
+
+    if ".." not in text:
+        if _DATE.fullmatch(text):
+            raise ValueError(f"invalid range: {text!r}")
+        return _parse_endpoint(text)
+
+    parts = text.split("..")
+    if len(parts) != 2:
+        raise ValueError(f"invalid range: {text!r}")
+    start_text, end_text = (part.strip() for part in parts)
+    if not start_text and not end_text:
+        raise ValueError(f"invalid range: {text!r}")
+    start = _parse_endpoint(start_text)[0] if start_text else None
+    end = _parse_endpoint(end_text)[1] if end_text else None
+    if start is not None and end is not None and end < start:
+        raise ValueError(f"range ends before it starts: {text!r}")
+    return start, end
diff --git a/tests/test_daterange.py b/tests/test_daterange.py
index 7018d91..ceb30ab 100644
--- a/tests/test_daterange.py
+++ b/tests/test_daterange.py
@@ -3,7 +3,127 @@ import unittest
 
 from daterange import parse_range
 
+DATE = datetime.date
+
 
 class TestRange(unittest.TestCase):
     def test_two_dates(self):
-        self.assertEqual(parse_range("2026-10-01..2026-10-31"), (datetime.date(2026, 10, 1), datetime.date(2026, 10, 31)))
+        self.assertEqual(parse_range("2026-10-01..2026-10-31"), (DATE(2026, 10, 1), DATE(2026, 10, 31)))
+
+    def test_equal_dates(self):
+        self.assertEqual(parse_range("2026-10-01..2026-10-01"), (DATE(2026, 10, 1), DATE(2026, 10, 1)))
+
+    def test_reversed_dates(self):
+        with self.assertRaises(ValueError):
+            parse_range("2026-10-31..2026-10-01")
+
+    def test_month(self):
+        self.assertEqual(parse_range("2026-10"), (DATE(2026, 10, 1), DATE(2026, 10, 31)))
+
+    def test_month_february_leap(self):
+        self.assertEqual(parse_range("2024-02"), (DATE(2024, 2, 1), DATE(2024, 2, 29)))
+
+    def test_month_february_common(self):
+        self.assertEqual(parse_range("2026-02"), (DATE(2026, 2, 1), DATE(2026, 2, 28)))
+
+    def test_month_december(self):
+        self.assertEqual(parse_range("2026-12"), (DATE(2026, 12, 1), DATE(2026, 12, 31)))
+
+    def test_iso_week(self):
+        self.assertEqual(parse_range("2026-W44"), (DATE(2026, 10, 26), DATE(2026, 11, 1)))
+
+    def test_iso_week_crosses_year(self):
+        self.assertEqual(parse_range("2026-W01"), (DATE(2025, 12, 29), DATE(2026, 1, 4)))
+
+    def test_iso_week_53(self):
+        self.assertEqual(parse_range("2026-W53"), (DATE(2026, 12, 28), DATE(2027, 1, 3)))
+        self.assertEqual(parse_range("2020-W53"), (DATE(2020, 12, 28), DATE(2021, 1, 3)))
+
+    def test_iso_week_53_invalid_year(self):
+        with self.assertRaises(ValueError):
+            parse_range("2019-W53")
+
+    def test_iso_week_54(self):
+        with self.assertRaises(ValueError):
+            parse_range("2026-W54")
+
+    def test_iso_week_zero(self):
+        with self.assertRaises(ValueError):
+            parse_range("2026-W00")
+
+    def test_year(self):
+        self.assertEqual(parse_range("2026"), (DATE(2026, 1, 1), DATE(2026, 12, 31)))
+
+    def test_year_leap(self):
+        self.assertEqual(parse_range("2024"), (DATE(2024, 1, 1), DATE(2024, 12, 31)))
+
+    def test_open_start(self):
+        self.assertEqual(parse_range("..2026-10-31"), (None, DATE(2026, 10, 31)))
+
+    def test_open_end(self):
+        self.assertEqual(parse_range("2026-10-01.."), (DATE(2026, 10, 1), None))
+
+    def test_open_start_month_week_year(self):
+        self.assertEqual(parse_range("..2026-10"), (None, DATE(2026, 10, 31)))
+        self.assertEqual(parse_range("..2026-W44"), (None, DATE(2026, 11, 1)))
+        self.assertEqual(parse_range("..2026"), (None, DATE(2026, 12, 31)))
+
+    def test_open_end_month_week_year(self):
+        self.assertEqual(parse_range("2026-10.."), (DATE(2026, 10, 1), None))
+        self.assertEqual(parse_range("2026-W44.."), (DATE(2026, 10, 26), None))
+        self.assertEqual(parse_range("2026.."), (DATE(2026, 1, 1), None))
+
+    def test_both_open(self):
+        with self.assertRaises(ValueError):
+            parse_range("..")
+
+    def test_whitespace(self):
+        self.assertEqual(
+            parse_range("  2026-10-01  ..  2026-10-31  "),
+            (DATE(2026, 10, 1), DATE(2026, 10, 31)),
+        )
+        self.assertEqual(parse_range(" 2026-10 "), (DATE(2026, 10, 1), DATE(2026, 10, 31)))
+        self.assertEqual(parse_range(" .. 2026 "), (None, DATE(2026, 12, 31)))
+        self.assertEqual(parse_range(" 2026 .. "), (DATE(2026, 1, 1), None))
+
+    def test_mixed_endpoint_types(self):
+        self.assertEqual(parse_range("2026-01..2026-03-15"), (DATE(2026, 1, 1), DATE(2026, 3, 15)))
+        self.assertEqual(parse_range("2025..2026-06"), (DATE(2025, 1, 1), DATE(2026, 6, 30)))
+
+    def test_reversed_mixed(self):
+        with self.assertRaises(ValueError):
+            parse_range("2026-02..2026-01")
+
+    def test_empty(self):
+        for text in ("", "   ", "\t"):
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_range(text)
+
+    def test_malformed(self):
+        for text in (
+            "garbage",
+            "2026-1-1",
+            "2026-1",
+            "2026-10-32",
+            "2026-02-30",
+            "2026-13",
+            "2026-00",
+            "2026-W1",
+            "2026-w44",
+            "2026-10-01...2026-10-02",
+            "2026-10-01..2026-10-02..",
+            "2026-10-01",
+            "2026 - 10 - 01",
+            "2026-W44..2026-W43",
+            "0000",
+            "0000-01-01",
+            "26-10-01",
+        ):
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_range(text)
+
+
+if __name__ == "__main__":
+    unittest.main()
