 """Date ranges, see SPEC.md."""
+import calendar
 import datetime
+import re
+
+
+_DATE_RE = re.compile(r"(\d{4})-(\d{2})-(\d{2})")
+_WEEK_RE = re.compile(r"(\d{4})-W(\d{2})")
+_MONTH_RE = re.compile(r"(\d{4})-(\d{2})")
+_YEAR_RE = re.compile(r"(\d{4})")
+
+
+def _parse_token(text):
+    """Return the inclusive (first, last) day of the span a single token names.
+
+    Supported tokens are an ISO date, an ISO week (YYYY-Www), a month
+    (YYYY-MM) and a year (YYYY). Raises ValueError for anything else.
+    """
+    match = _DATE_RE.fullmatch(text)
+    if match:
+        day = datetime.date(*(int(part) for part in match.groups()))
+        return day, day
+
+    match = _WEEK_RE.fullmatch(text)
+    if match:
+        year, week = (int(part) for part in match.groups())
+        monday = datetime.date.fromisocalendar(year, week, 1)
+        return monday, monday + datetime.timedelta(days=6)
+
+    match = _MONTH_RE.fullmatch(text)
+    if match:
+        year, month = (int(part) for part in match.groups())
+        first = datetime.date(year, month, 1)
+        return first, first.replace(day=calendar.monthrange(year, month)[1])
+
+    match = _YEAR_RE.fullmatch(text)
+    if match:
+        year = int(match.group(1))
+        return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+
+    raise ValueError("not a date, week, month or year: {!r}".format(text))
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse a date range into an inclusive (start, end) pair of dates.
+
+    A missing side of an open range is returned as None. See SPEC.md for the
+    accepted forms. Raises ValueError for malformed or reversed ranges.
+    """
+    if not isinstance(text, str):
+        raise ValueError("range must be text, got {!r}".format(text))
+
+    parts = text.strip().split("..")
+    if len(parts) > 2:
+        raise ValueError("at most one '..' is allowed: {!r}".format(text))
+
+    if len(parts) == 1:
+        return _parse_token(parts[0].strip())
+
+    left, right = (part.strip() for part in parts)
+    if not left and not right:
+        raise ValueError("range needs at least one end: {!r}".format(text))
+
+    start = _parse_token(left)[0] if left else None
+    end = _parse_token(right)[1] if right else None
+
+    if start is not None and end is not None and start > end:
+        raise ValueError("range ends before it starts: {!r}".format(text))
+    return start, end
