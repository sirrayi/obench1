 """Date ranges, see SPEC.md."""
 import datetime
+import re
+
+_DATE_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_MONTH_RE = re.compile(r"([0-9]{4})-([0-9]{2})")
+_WEEK_RE = re.compile(r"([0-9]{4})-W([0-9]{2})")
+_YEAR_RE = re.compile(r"([0-9]{4})")
+
+_SEPARATOR = ".."
+
+
+def _parse_point(token):
+    """Parse one bound into a (first day, last day) pair."""
+    match = _DATE_RE.fullmatch(token)
+    if match:
+        day = datetime.date(*(int(part) for part in match.groups()))
+        return day, day
+
+    match = _MONTH_RE.fullmatch(token)
+    if match:
+        year, month = (int(part) for part in match.groups())
+        start = datetime.date(year, month, 1)
+        if month == 12:
+            end = datetime.date(year, 12, 31)
+        else:
+            end = datetime.date(year, month + 1, 1) - datetime.timedelta(days=1)
+        return start, end
+
+    match = _WEEK_RE.fullmatch(token)
+    if match:
+        year, week = (int(part) for part in match.groups())
+        start = datetime.date.fromisocalendar(year, week, 1)
+        end = datetime.date.fromisocalendar(year, week, 7)
+        return start, end
+
+    match = _YEAR_RE.fullmatch(token)
+    if match:
+        year = int(match.group(1))
+        return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+
+    raise ValueError("invalid date or range bound: {!r}".format(token))
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse a range description into an inclusive (start, end) pair.
+
+    Either end may be None to mean "unbounded". Raises ValueError for
+    anything that does not match the forms listed in SPEC.md.
+    """
+    if not isinstance(text, str):
+        raise ValueError("range must be a string: {!r}".format(text))
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("empty range")
+
+    if _SEPARATOR not in stripped:
+        return _parse_point(stripped)
+
+    parts = stripped.split(_SEPARATOR)
+    if len(parts) != 2:
+        raise ValueError("expected a single '..' in {!r}".format(text))
+
+    left, right = parts[0].strip(), parts[1].strip()
+    if not left and not right:
+        raise ValueError("'..' needs at least one bound")
+
+    start = _parse_point(left)[0] if left else None
+    end = _parse_point(right)[1] if right else None
+
+    if start is not None and end is not None and end < start:
+        raise ValueError("range end {!r} is before start {!r}".format(right, left))
+
+    return start, end
