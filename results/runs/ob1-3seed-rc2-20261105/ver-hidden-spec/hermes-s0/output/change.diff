 """Date ranges, see SPEC.md."""
+import calendar
 import datetime
+import re
+
+_DATE_RE = re.compile(r"(\d{4})-(\d{2})-(\d{2})")
+_MONTH_RE = re.compile(r"(\d{4})-(\d{2})")
+_WEEK_RE = re.compile(r"(\d{4})-W(\d{2})")
+_YEAR_RE = re.compile(r"(\d{4})")
+
+
+def _month_span(year, month):
+    if not 1 <= month <= 12:
+        raise ValueError("month out of range: %04d-%02d" % (year, month))
+    last = calendar.monthrange(year, month)[1]
+    return datetime.date(year, month, 1), datetime.date(year, month, last)
+
+
+def _week_span(year, week):
+    try:
+        start = datetime.date.fromisocalendar(year, week, 1)
+        end = datetime.date.fromisocalendar(year, week, 7)
+    except ValueError:
+        raise ValueError("invalid ISO week: %04d-W%02d" % (year, week)) from None
+    return start, end
+
+
+def _parse_token(token):
+    """Parse one term into an inclusive (start, end) date pair."""
+    match = _DATE_RE.fullmatch(token)
+    if match:
+        try:
+            day = datetime.date(*(int(part) for part in match.groups()))
+        except ValueError:
+            raise ValueError("invalid date: %s" % token) from None
+        return day, day
+
+    match = _WEEK_RE.fullmatch(token)
+    if match:
+        return _week_span(int(match.group(1)), int(match.group(2)))
+
+    match = _MONTH_RE.fullmatch(token)
+    if match:
+        return _month_span(int(match.group(1)), int(match.group(2)))
+
+    match = _YEAR_RE.fullmatch(token)
+    if match:
+        year = int(match.group(1))
+        try:
+            return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+        except ValueError:
+            raise ValueError("invalid year: %s" % token) from None
+
+    raise ValueError("invalid date range term: %r" % token)
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse a date range expression, returning inclusive (start, end) dates.
+
+    Either end is None when the range is open on that side. Raises ValueError
+    for malformed input or a range whose end precedes its start.
+    """
+    if not isinstance(text, str):
+        raise ValueError("date range must be a string")
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("empty date range")
+
+    if ".." in stripped:
+        left_text, _, right_text = stripped.partition("..")
+        left_text = left_text.strip()
+        right_text = right_text.strip()
+        if not left_text and not right_text:
+            raise ValueError("date range needs at least one end")
+        start = _parse_token(left_text)[0] if left_text else None
+        end = _parse_token(right_text)[1] if right_text else None
+    else:
+        start, end = _parse_token(stripped)
+
+    if start is not None and end is not None and end < start:
+        raise ValueError("range end %s precedes start %s" % (end, start))
+    return start, end
