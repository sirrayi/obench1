 """Date ranges, see SPEC.md."""
+import calendar
 import datetime
+import re
+
+_DATE_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_WEEK_RE = re.compile(r"([0-9]{4})-W([0-9]{2})")
+_MONTH_RE = re.compile(r"([0-9]{4})-([0-9]{2})")
+_YEAR_RE = re.compile(r"([0-9]{4})")
+
+
+def _expand(text):
+    """Return the first and last date represented by a single endpoint."""
+    match = _DATE_RE.fullmatch(text)
+    if match:
+        year, month, day = (int(part) for part in match.groups())
+        value = datetime.date(year, month, day)
+        return value, value
+
+    match = _WEEK_RE.fullmatch(text)
+    if match:
+        year, week = (int(part) for part in match.groups())
+        monday = datetime.date.fromisocalendar(year, week, 1)
+        sunday = datetime.date.fromisocalendar(year, week, 7)
+        return monday, sunday
+
+    match = _MONTH_RE.fullmatch(text)
+    if match:
+        year, month = (int(part) for part in match.groups())
+        first = datetime.date(year, month, 1)
+        last_day = calendar.monthrange(year, month)[1]
+        return first, datetime.date(year, month, last_day)
+
+    match = _YEAR_RE.fullmatch(text)
+    if match:
+        year = int(match.group(1))
+        return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+
+    raise ValueError("malformed date endpoint: {!r}".format(text))
 
 
 def parse_range(text):
-    raise NotImplementedError
+    if not isinstance(text, str):
+        raise ValueError("date range must be a string")
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("date range is empty")
+
+    if ".." in stripped:
+        parts = stripped.split("..")
+        if len(parts) != 2:
+            raise ValueError("date range must contain exactly one '..' separator")
+
+        left_text, right_text = (part.strip() for part in parts)
+        if not left_text and not right_text:
+            raise ValueError("both ends of the date range are open")
+
+        start = None
+        end = None
+        if left_text:
+            start, _ = _expand(left_text)
+        if right_text:
+            _, end = _expand(right_text)
+
+        if start is not None and end is not None and end < start:
+            raise ValueError("end of date range is before its start")
+        return start, end
+
+    if _DATE_RE.fullmatch(stripped):
+        raise ValueError("a single date is not a range")
+
+    return _expand(stripped)
