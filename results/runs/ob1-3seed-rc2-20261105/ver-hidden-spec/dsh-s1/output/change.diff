@@ -1,6 +1,72 @@
 """Date ranges, see SPEC.md."""
 import datetime
+import re
+
+_DATE_RE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_MONTH_RE = re.compile(r"([0-9]{4})-([0-9]{2})")
+_WEEK_RE = re.compile(r"([0-9]{4})-W([0-9]{2})")
+_YEAR_RE = re.compile(r"([0-9]{4})")
+
+
+def _month_end(year, month):
+    """Return the last day of a month as a date."""
+    if month == 12:
+        return datetime.date(year, 12, 31)
+    return datetime.date(year, month + 1, 1) - datetime.timedelta(days=1)
+
+
+def _parse_endpoint(text):
+    """Expand one supported token to its inclusive (first, last) dates."""
+    match = _DATE_RE.fullmatch(text)
+    if match is not None:
+        day = datetime.date(*(int(part) for part in match.groups()))
+        return day, day
+
+    match = _WEEK_RE.fullmatch(text)
+    if match is not None:
+        year, week = (int(part) for part in match.groups())
+        return (
+            datetime.date.fromisocalendar(year, week, 1),
+            datetime.date.fromisocalendar(year, week, 7),
+        )
+
+    match = _MONTH_RE.fullmatch(text)
+    if match is not None:
+        year, month = (int(part) for part in match.groups())
+        return datetime.date(year, month, 1), _month_end(year, month)
+
+    match = _YEAR_RE.fullmatch(text)
+    if match is not None:
+        year = int(match.group(1))
+        return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+
+    raise ValueError("not a valid date, month, ISO week or year: %r" % (text,))
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse a date range, returning inclusive (start, end) dates."""
+    if not isinstance(text, str):
+        raise ValueError("range must be a string, got %r" % (text,))
+
+    parts = text.split("..")
+    if len(parts) > 2:
+        raise ValueError("expected at most one '..' separator in %r" % (text,))
+
+    if len(parts) == 1:
+        return _parse_endpoint(text.strip())
+
+    left = parts[0].strip()
+    right = parts[1].strip()
+    if not left and not right:
+        raise ValueError("a range needs at least one end: %r" % (text,))
+
+    if not left:
+        return None, _parse_endpoint(right)[1]
+    if not right:
+        return _parse_endpoint(left)[0], None
+
+    start = _parse_endpoint(left)[0]
+    end = _parse_endpoint(right)[1]
+    if end < start:
+        raise ValueError("range end %s is before its start %s" % (end, start))
+    return start, end
