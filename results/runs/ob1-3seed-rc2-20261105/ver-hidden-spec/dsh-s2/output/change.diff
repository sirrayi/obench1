-"""Date ranges, see SPEC.md."""
+"""Date ranges, see SPEC.md.
+
+``parse_range(text)`` turns a compact range expression into an inclusive
+``(start, end)`` pair of :class:`datetime.date` objects.  A ``None`` end
+means that side of the range is open.
+"""
+import calendar
 import datetime
+import re
+
+# Accepted tokens: full date, month, ISO week (YYYY-Www) and year.
+_FULL_DATE_RE = re.compile(r"\A(\d{4})-(\d{2})-(\d{2})\Z")
+_MONTH_RE = re.compile(r"\A(\d{4})-(\d{2})\Z")
+_WEEK_RE = re.compile(r"\A(\d{4})-W(\d{2})\Z")
+_YEAR_RE = re.compile(r"\A(\d{4})\Z")
+
+# Tokens never contain a dot, so the range separator is easy to isolate.
+_RANGE_RE = re.compile(r"\A([^.]*)\.\.([^.]*)\Z")
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Return the inclusive ``(start, end)`` date pair described by *text*.
+
+    The two ends are ISO dates, months, ISO weeks or years; see SPEC.md for
+    the accepted forms.  A missing end (``..B`` or ``A..``) is represented by
+    ``None``.  Malformed text raises :exc:`ValueError`.
+    """
+    if not isinstance(text, str):
+        raise ValueError("range must be text, not %r" % (text,))
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("empty range")
+
+    if ".." not in stripped:
+        # A single token stands for its whole span, e.g. the whole month.
+        return _expand(stripped)
+
+    match = _RANGE_RE.fullmatch(stripped)
+    if match is None:
+        raise ValueError("malformed range: %r" % (text,))
+
+    start_text = match.group(1).strip()
+    end_text = match.group(2).strip()
+    if not start_text and not end_text:
+        raise ValueError("'..' on its own is not a range")
+
+    start = _expand(start_text)[0] if start_text else None
+    end = _expand(end_text)[1] if end_text else None
+    if start is not None and end is not None and end < start:
+        raise ValueError("range end %s is before start %s" % (end, start))
+    return (start, end)
+
+
+def _expand(token):
+    """Return ``(first, last)`` for a single date, month, ISO week or year."""
+    match = _FULL_DATE_RE.fullmatch(token)
+    if match is not None:
+        year, month, day = (int(part) for part in match.groups())
+        try:
+            value = datetime.date(year, month, day)
+        except ValueError:
+            raise ValueError("invalid date: %r" % (token,)) from None
+        return (value, value)
+
+    match = _MONTH_RE.fullmatch(token)
+    if match is not None:
+        return _month_span(token, int(match.group(1)), int(match.group(2)))
+
+    match = _WEEK_RE.fullmatch(token)
+    if match is not None:
+        return _week_span(token, int(match.group(1)), int(match.group(2)))
+
+    match = _YEAR_RE.fullmatch(token)
+    if match is not None:
+        return _year_span(token, int(match.group(1)))
+
+    raise ValueError("unrecognised date, month, week or year: %r" % (token,))
+
+
+def _month_span(token, year, month):
+    if not 1 <= month <= 12:
+        raise ValueError("invalid month: %r" % (token,))
+    try:
+        first = datetime.date(year, month, 1)
+    except ValueError:
+        raise ValueError("invalid month: %r" % (token,)) from None
+    last = datetime.date(year, month, calendar.monthrange(year, month)[1])
+    return (first, last)
+
+
+def _week_span(token, year, week):
+    try:
+        # The Monday of ISO week 1 is the Monday nearest to January 4th.
+        january_4th = datetime.date(year, 1, 4)
+        monday = january_4th - datetime.timedelta(days=january_4th.isoweekday() - 1)
+        monday += datetime.timedelta(weeks=week - 1)
+        if not 1 <= week <= 53 or monday.isocalendar()[:2] != (year, week):
+            raise ValueError("invalid ISO week: %r" % (token,))
+        sunday = monday + datetime.timedelta(days=6)
+    except (ValueError, OverflowError):
+        raise ValueError("invalid ISO week: %r" % (token,)) from None
+    return (monday, sunday)
+
+
+def _year_span(token, year):
+    try:
+        return (datetime.date(year, 1, 1), datetime.date(year, 12, 31))
+    except ValueError:
+        raise ValueError("invalid year: %r" % (token,)) from None
