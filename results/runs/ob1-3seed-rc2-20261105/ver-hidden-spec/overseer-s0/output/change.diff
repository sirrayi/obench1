 """Date ranges, see SPEC.md."""
+import calendar
 import datetime
+import re
+
+_DATE = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})")
+_MONTH = re.compile(r"([0-9]{4})-([0-9]{2})")
+_WEEK = re.compile(r"([0-9]{4})-[Ww]([0-9]{2})")
+_YEAR = re.compile(r"([0-9]{4})")
+
+
+def _parse_date(text):
+    """A whole `YYYY-MM-DD` string as a date."""
+    match = _DATE.fullmatch(text)
+    if match is None:
+        raise ValueError("not an ISO date: %r" % (text,))
+    year, month, day = (int(part) for part in match.groups())
+    try:
+        return datetime.date(year, month, day)
+    except ValueError:
+        raise ValueError("not a valid date: %r" % (text,)) from None
+
+
+def _expand(token):
+    """First and last day of the month, ISO week or year named by `token`."""
+    match = _MONTH.fullmatch(token)
+    if match is not None:
+        year, month = (int(part) for part in match.groups())
+        if not 1 <= month <= 12:
+            raise ValueError("not a valid month: %r" % (token,))
+        last_day = calendar.monthrange(year, month)[1]
+        return datetime.date(year, month, 1), datetime.date(year, month, last_day)
+
+    match = _WEEK.fullmatch(token)
+    if match is not None:
+        year, week = (int(part) for part in match.groups())
+        try:
+            monday = datetime.date.fromisocalendar(year, week, 1)
+        except ValueError:
+            raise ValueError("not a valid ISO week: %r" % (token,)) from None
+        return monday, monday + datetime.timedelta(days=6)
+
+    match = _YEAR.fullmatch(token)
+    if match is not None:
+        year = int(match.group(1))
+        try:
+            return datetime.date(year, 1, 1), datetime.date(year, 12, 31)
+        except ValueError:
+            raise ValueError("not a valid year: %r" % (token,)) from None
+
+    raise ValueError("not a month, ISO week or year: %r" % (token,))
 
 
 def parse_range(text):
-    raise NotImplementedError
+    """Parse `text` into an inclusive `(start, end)` pair of dates, see SPEC.md."""
+    if not isinstance(text, str):
+        raise ValueError("date range must be text, got %r" % (text,))
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("empty date range")
+
+    if ".." in stripped:
+        start_text, _, end_text = stripped.partition("..")
+        start_text = start_text.strip()
+        end_text = end_text.strip()
+        if not start_text and not end_text:
+            raise ValueError("date range needs at least one end: %r" % (text,))
+        start = _parse_date(start_text) if start_text else None
+        end = _parse_date(end_text) if end_text else None
+        if start is not None and end is not None and end < start:
+            raise ValueError("date range ends before it starts: %r" % (text,))
+        return start, end
+
+    return _expand(stripped)
