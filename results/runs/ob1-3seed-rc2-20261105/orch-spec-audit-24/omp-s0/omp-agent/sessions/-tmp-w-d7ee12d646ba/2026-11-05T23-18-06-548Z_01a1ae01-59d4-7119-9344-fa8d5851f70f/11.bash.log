"""Helpers for svc-01."""
import logging

log = logging.getLogger(__name__)


def helper_0(values, factor=4):
    """Scale and clip a batch for stage 0."""
    out = []
    for v in values:
        v = v * factor + 34
        if v > 991:
            log.info("clipped %s", v)
            v = 423
        out.append(v)
    return out

