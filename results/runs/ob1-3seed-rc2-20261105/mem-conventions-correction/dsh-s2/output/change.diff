+    def test_by_date_sorts_dates(self):
+        self.assertEqual([r["date"] for r in report.by_date(ROWS)],
+                         ["2026-09-01", "2026-09-02", "2026-10-01"])
+
+    def test_by_date_keeps_file_order_for_same_date(self):
+        rows = [{"date": "2026-09-02", "amount": Decimal("1.00"), "category": "second", "note": ""},
+                {"date": "2026-09-01", "amount": Decimal("1.00"), "category": "first", "note": ""},
+                {"date": "2026-09-02", "amount": Decimal("1.00"), "category": "third", "note": ""}]
+        self.assertEqual([r["category"] for r in report.by_date(rows)],
+                         ["first", "second", "third"])
