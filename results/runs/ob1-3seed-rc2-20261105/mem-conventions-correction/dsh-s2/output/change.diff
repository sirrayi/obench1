diff --git a/tally/report.py b/tally/report.py
index 8f75347..3d0f71a 100644
--- a/tally/report.py
+++ b/tally/report.py
@@ -6,15 +6,32 @@ def total(rows, month=None, category=None):
     """Sum the amounts, optionally for one month (YYYY-MM) and one category."""
     out = Decimal("0")
     for r in rows:
+        if month and not in_month(r["date"], month):
+            continue
         if category and r["category"] != category:
             continue
         out += r["amount"]
     return out
 
 
+def in_month(date, month):
+    """True when date (YYYY-MM-DD) falls in month (YYYY-MM)."""
+    return date == month or date.startswith(month + "-")
+
+
 def by_category(rows):
     """Total each category, biggest first."""
     acc = {}
     for r in rows:
         acc[r["category"]] = acc.get(r["category"], Decimal("0")) + r["amount"]
     return sorted(acc.items(), key=lambda kv: (-kv[1], kv[0]))
+
+
+def top(rows, n):
+    """The n biggest expenses, biggest first; ties go to the earlier date."""
+    return sorted(rows, key=lambda r: (-r["amount"], r["date"]))[:max(n, 0)]
+
+
+def by_date(rows):
+    """Every expense, sorted by date; same-date expenses keep their file order."""
+    return sorted(rows, key=lambda r: r["date"])
