diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..aa06557
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,118 @@
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+from io import StringIO
+
+from tally import cli
+
+CSV = ("date,amount,category,note\n"
+       "2026-09-02,3.50,food,tea\n"
+       "2026-09-01,7.00,travel,bus\n"
+       "2026-09-03,7.00,food,lunch\n")
+
+
+class TestCliTop(unittest.TestCase):
+    def run_top(self, n):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            with open(p, "w", newline="") as f:
+                f.write(CSV)
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                buf = StringIO()
+                with redirect_stdout(buf):
+                    cli.main(["top", str(n)])
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
+            return buf.getvalue()
+
+    def test_top_prints_largest_first(self):
+        self.assertEqual(self.run_top(2),
+                         "2026-09-01 7.00 travel\n"
+                         "2026-09-03 7.00 food\n")
+
+    def test_top_caps_at_rows_available(self):
+        self.assertEqual(len(self.run_top(99).splitlines()), 3)
+
+
+CSV_MONTHS = ("date,amount,category,note\n"
+              "2026-09-02,3.50,food,tea\n"
+              "2026-10-01,7.00,travel,bus\n"
+              "2026-09-03,4.25,food,lunch\n")
+
+
+class TestCliSum(unittest.TestCase):
+    def run_sum(self, *argv):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            with open(p, "w", newline="") as f:
+                f.write(CSV_MONTHS)
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                buf = StringIO()
+                with redirect_stdout(buf):
+                    cli.main(["sum"] + list(argv))
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
+            return buf.getvalue()
+
+    def test_sum_month(self):
+        self.assertEqual(self.run_sum("--month", "2026-09"), "7.75\n")
+
+    def test_sum_month_and_category(self):
+        self.assertEqual(self.run_sum("--month", "2026-09", "--category", "food"), "7.75\n")
+
+    def test_sum_month_without_rows(self):
+        self.assertEqual(self.run_sum("--month", "2026-11"), "0.00\n")
+
+    def test_sum_without_month_totals_everything(self):
+        self.assertEqual(self.run_sum(), "14.75\n")
+
+
+CSV_EXPORT = ("date,amount,category,note\n"
+              "2026-09-02,3.50,food,tea\n"
+              "2026-09-01,7,food,bus\n"
+              "2026-09-02,1.5,travel,lunch\n")
+
+
+class TestCliExport(unittest.TestCase):
+    def run_export(self, source=CSV_EXPORT):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            out = os.path.join(d, "out.csv")
+            with open(p, "w", newline="") as f:
+                f.write(source)
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                status = cli.main(["export", "--csv", out])
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
+            with open(out, newline="") as f:
+                return status, f.read()
+
+    def test_export_sorts_by_date_and_keeps_ties_in_file_order(self):
+        self.assertEqual(self.run_export()[1],
+                         "date,amount,category,note\n"
+                         "2026-09-01,7.00,food,bus\n"
+                         "2026-09-02,3.50,food,tea\n"
+                         "2026-09-02,1.50,travel,lunch\n")
+
+    def test_export_writes_header_when_there_are_no_expenses(self):
+        self.assertEqual(self.run_export("date,amount,category,note\n")[1],
+                         "date,amount,category,note\n")
+
+    def test_export_succeeds(self):
+        self.assertEqual(self.run_export()[0], 0)
