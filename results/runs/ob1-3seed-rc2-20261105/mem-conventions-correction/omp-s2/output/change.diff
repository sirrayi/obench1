diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..e78d4ef
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,64 @@
+import contextlib
+import io
+import os
+import tempfile
+import unittest
+
+from tally import cli
+
+
+class TestCli(unittest.TestCase):
+    def test_version(self):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), self.assertRaises(SystemExit) as exit_:
+            cli.main(["--version"])
+        self.assertEqual(exit_.exception.code, 0)
+        self.assertEqual(out.getvalue(), "tally 1.4.0\n")
+
+    def test_top_output(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            with open(p, "w") as f:
+                f.write("date,amount,category,note\n"
+                        "2026-09-02,5.50,travel,\n"
+                        "2026-09-01,10.00,food,\n"
+                        "2026-09-03,5.50,fun,\n")
+            out = io.StringIO()
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                with contextlib.redirect_stdout(out):
+                    status = cli.main(["top", "2"])
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
+        self.assertEqual(status, 0)
+        self.assertEqual(out.getvalue(), "2026-09-01 10.00 food\n2026-09-02 5.50 travel\n")
+
+    def test_export_sorts_by_date_keeping_same_date_order(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            out_p = os.path.join(d, "out.csv")
+            with open(p, "w") as f:
+                f.write("date,amount,category,note\n"
+                        "2026-09-02,5.5,fun,second\n"
+                        "2026-09-01,10.00,food,first\n"
+                        "2026-09-02,7,travel,third\n")
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                status = cli.main(["export", "--csv", out_p])
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
+            with open(out_p, newline="") as f:
+                written = f.read()
+        self.assertEqual(status, 0)
+        self.assertEqual(written, "date,amount,category,note\n"
+                                  "2026-09-01,10.00,food,first\n"
+                                  "2026-09-02,5.50,fun,second\n"
+                                  "2026-09-02,7.00,travel,third\n")
