diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..7b9a3b8
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,55 @@
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+
+from tally import store
+from tally.cli import main
+
+
+class TestCli(unittest.TestCase):
+    def test_version(self):
+        out = io.StringIO()
+        with redirect_stdout(out), self.assertRaises(SystemExit) as ctx:
+            main(["--version"])
+        self.assertEqual(ctx.exception.code, 0)
+        self.assertEqual(out.getvalue().strip(), "tally 1.4.0")
+
+    def test_top(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            store.append({"date": "2026-09-05", "amount": "3.5", "category": "food", "note": ""}, p)
+            store.append({"date": "2026-09-01", "amount": "12", "category": "travel", "note": ""}, p)
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                out = io.StringIO()
+                with redirect_stdout(out):
+                    main(["top", "1"])
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
+            self.assertEqual(out.getvalue(), "2026-09-01 12.00 travel\n")
+
+    def test_export(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            out_csv = os.path.join(d, "out.csv")
+            store.append({"date": "2026-09-05", "amount": "3.5", "category": "food", "note": ""}, p)
+            store.append({"date": "2026-09-01", "amount": "12", "category": "travel", "note": "bus"}, p)
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = p
+            try:
+                main(["export", "--csv", out_csv])
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
+            with open(out_csv, newline="") as f:
+                self.assertEqual(f.read(), "date,amount,category,note\n"
+                                           "2026-09-01,12.00,travel,bus\n"
+                                           "2026-09-05,3.50,food,\n")
