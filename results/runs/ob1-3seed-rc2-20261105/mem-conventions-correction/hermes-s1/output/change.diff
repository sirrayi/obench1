diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..c21eff9
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,89 @@
+import csv
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from tally import __version__, cli
+
+
+class TestCli(unittest.TestCase):
+    def restore_db(self, old):
+        if old is None:
+            os.environ.pop("TALLY_DB", None)
+        else:
+            os.environ["TALLY_DB"] = old
+
+    def test_version_flag_prints_version(self):
+        out = io.StringIO()
+        with redirect_stdout(out), self.assertRaises(SystemExit) as ctx:
+            cli.main(["--version"])
+        self.assertEqual(ctx.exception.code, 0)
+        self.assertEqual(out.getvalue(), "tally 1.4.0\n")
+
+    def test_version_flag_tracks_package_version(self):
+        out = io.StringIO()
+        with redirect_stdout(out), self.assertRaises(SystemExit):
+            cli.main(["--version"])
+        self.assertEqual(out.getvalue().strip(), "tally %s" % __version__)
+
+    def test_sum_month_totals_only_that_month(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        path = os.path.join(tmp.name, "expenses.csv")
+        with open(path, "w", newline="") as f:
+            f.write("date,amount,category,note\n")
+            f.write("2026-09-02,5.50,travel,\n")
+            f.write("2026-09-20,2.00,food,\n")
+            f.write("2026-10-01,9.00,food,\n")
+        old = os.environ.get("TALLY_DB")
+        os.environ["TALLY_DB"] = path
+        self.addCleanup(self.restore_db, old)
+        out = io.StringIO()
+        with redirect_stdout(out):
+            cli.main(["sum", "--month", "2026-09"])
+        self.assertEqual(out.getvalue(), "7.50\n")
+
+    def test_top_prints_amount_and_category(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        path = os.path.join(tmp.name, "expenses.csv")
+        with open(path, "w", newline="") as f:
+            f.write("date,amount,category,note\n")
+            f.write("2026-09-02,5.50,travel,\n")
+            f.write("2026-09-01,12.00,food,\n")
+            f.write("2026-09-03,12.00,fun,\n")
+        old = os.environ.get("TALLY_DB")
+        os.environ["TALLY_DB"] = path
+        self.addCleanup(self.restore_db, old)
+        out = io.StringIO()
+        with redirect_stdout(out):
+            cli.main(["top", "2"])
+        self.assertEqual(out.getvalue(), "2026-09-01 12.00 food\n2026-09-03 12.00 fun\n")
+
+    def test_export_writes_sorted_csv(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        path = os.path.join(tmp.name, "expenses.csv")
+        out_path = os.path.join(tmp.name, "export.csv")
+        with open(path, "w", newline="") as f:
+            f.write("date,amount,category,note\n")
+            f.write("2026-09-02,5.5,travel,bus\n")
+            f.write("2026-09-01,12,food,tea\n")
+            f.write("2026-09-02,3,fun,film\n")
+        old = os.environ.get("TALLY_DB")
+        os.environ["TALLY_DB"] = path
+        self.addCleanup(self.restore_db, old)
+        self.assertEqual(cli.main(["export", "--csv", out_path]), 0)
+        with open(out_path, newline="") as f:
+            got = list(csv.reader(f))
+        self.assertEqual(got, [["date", "amount", "category", "note"],
+                               ["2026-09-01", "12.00", "food", "tea"],
+                               ["2026-09-02", "5.50", "travel", "bus"],
+                               ["2026-09-02", "3.00", "fun", "film"]])
+
+    def test_export_requires_csv_option(self):
+        with redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as ctx:
+            cli.main(["export"])
+        self.assertEqual(ctx.exception.code, 2)
