+
+
+def top(rows, n):
+    """Return the n largest expenses, biggest first; ties go to the earlier date."""
+    if n <= 0:
+        return []
+    return sorted(rows, key=lambda r: (-r["amount"], r["date"]))[:n]
diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..1ae716b
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,30 @@
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+from unittest.mock import patch
+
+from tally import cli, store
+
+
+class TestCli(unittest.TestCase):
+    def test_version_flag(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            with self.assertRaises(SystemExit) as caught:
+                cli.main(["--version"])
+        self.assertEqual(caught.exception.code, 0)
+        self.assertEqual(out.getvalue().strip(), "tally 1.4.0")
+
+    def test_top(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "e.csv")
+            store.append({"date": "2026-09-02", "amount": "5.50", "category": "travel", "note": ""}, path)
+            store.append({"date": "2026-09-01", "amount": "10.00", "category": "food", "note": ""}, path)
+            store.append({"date": "2026-08-01", "amount": "5.50", "category": "fun", "note": ""}, path)
+            out = io.StringIO()
+            with patch.dict(os.environ, {"TALLY_DB": path}):
+                with redirect_stdout(out):
+                    self.assertEqual(cli.main(["top", "2"]), 0)
+            self.assertEqual(out.getvalue(), "2026-09-01 10.00 food\n2026-08-01 5.50 fun\n")
