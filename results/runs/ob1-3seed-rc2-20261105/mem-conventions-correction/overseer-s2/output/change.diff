     def test_total_category(self):
         self.assertEqual(report.total(ROWS, category="food"), Decimal("12.25"))
 
+    def test_total_month(self):
+        self.assertEqual(report.total(ROWS, month="2026-09"), Decimal("15.50"))
+
+    def test_total_month_and_category(self):
+        self.assertEqual(report.total(ROWS, month="2026-09", category="food"), Decimal("10.00"))
+
+    def test_total_month_with_no_rows(self):
+        self.assertEqual(report.total(ROWS, month="2026-11"), Decimal("0"))
+
     def test_by_category(self):
         self.assertEqual(report.by_category(ROWS)[0], ("food", Decimal("12.25")))
+
+    def test_top_sorts_largest_first(self):
+        self.assertEqual([r["amount"] for r in report.top(ROWS, 2)], [Decimal("10.00"), Decimal("5.50")])
+
+    def test_top_ties_go_to_earlier_date(self):
+        rows = [{"date": "2026-09-02", "amount": Decimal("7.00"), "category": "b", "note": ""},
+                {"date": "2026-09-01", "amount": Decimal("7.00"), "category": "a", "note": ""}]
+        self.assertEqual([r["category"] for r in report.top(rows, 2)], ["a", "b"])
+
+    def test_top_fewer_rows_than_n(self):
+        self.assertEqual(len(report.top(ROWS, 10)), 3)
+
+    def test_by_date_sorts_oldest_first(self):
+        rows = [{"date": "2026-10-01", "amount": Decimal("1.00"), "category": "c", "note": ""},
+                {"date": "2026-08-15", "amount": Decimal("2.00"), "category": "a", "note": ""},
+                {"date": "2026-09-01", "amount": Decimal("3.00"), "category": "b", "note": ""}]
+        self.assertEqual([r["category"] for r in report.by_date(rows)], ["a", "b", "c"])
+
+    def test_by_date_keeps_file_order_for_same_date(self):
+        rows = [{"date": "2026-09-02", "amount": Decimal("1.00"), "category": "c", "note": ""},
+                {"date": "2026-09-01", "amount": Decimal("2.00"), "category": "a", "note": ""},
+                {"date": "2026-09-02", "amount": Decimal("3.00"), "category": "b", "note": ""}]
+        self.assertEqual([r["category"] for r in report.by_date(rows)], ["a", "c", "b"])
