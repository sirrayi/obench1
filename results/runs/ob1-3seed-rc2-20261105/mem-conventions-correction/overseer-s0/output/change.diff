     """Sum the amounts, optionally for one month (YYYY-MM) and one category."""
     out = Decimal("0")
     for r in rows:
+        if month and r["date"][:7] != month:
+            continue
         if category and r["category"] != category:
             continue
         out += r["amount"]
     return out
 
 
+def top(rows, n):
+    """Return the n largest expenses, largest first, ties by earlier date."""
+    if n <= 0:
+        return []
+    return sorted(rows, key=lambda r: (-r["amount"], r["date"]))[:n]
+
+
+def sorted_by_date(rows):
+    """Return the expenses sorted by date, same-date rows in their file order."""
+    return sorted(rows, key=lambda r: r["date"])
+
