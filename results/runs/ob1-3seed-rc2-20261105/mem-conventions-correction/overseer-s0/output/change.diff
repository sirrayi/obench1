diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..c88aff9
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,59 @@
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from unittest import mock
+
+from tally import __version__, cli, store
+
+
+class TestCli(unittest.TestCase):
+    def test_version_flag(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            with self.assertRaises(SystemExit) as ctx:
+                cli.main(["--version"])
+        self.assertEqual(ctx.exception.code, 0)
+        self.assertEqual(out.getvalue(), "tally %s\n" % __version__)
+
+    def test_version_text(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            with self.assertRaises(SystemExit):
+                cli.main(["--version"])
+        self.assertEqual(out.getvalue(), "tally 1.4.0\n")
+
+    def test_export_csv(self):
+        with tempfile.TemporaryDirectory() as d:
+            db = os.path.join(d, "e.csv")
+            out = os.path.join(d, "out.csv")
+            store.append({"date": "2026-09-02", "amount": "12", "category": "travel", "note": "taxi"}, db)
+            store.append({"date": "2026-09-01", "amount": "3.5", "category": "food", "note": ""}, db)
+            store.append({"date": "2026-09-02", "amount": "7.25", "category": "books", "note": "novel"}, db)
+            with mock.patch.dict(os.environ, {"TALLY_DB": db}):
+                self.assertEqual(cli.main(["export", "--csv", out]), 0)
+            with open(out, newline="") as f:
+                self.assertEqual(f.read(),
+                                 "date,amount,category,note\r\n"
+                                 "2026-09-01,3.50,food,\r\n"
+                                 "2026-09-02,12.00,travel,taxi\r\n"
+                                 "2026-09-02,7.25,books,novel\r\n")
+
+    def test_export_requires_csv_path(self):
+        with self.assertRaises(SystemExit) as ctx:
+            with redirect_stderr(io.StringIO()):
+                cli.main(["export"])
+        self.assertEqual(ctx.exception.code, 2)
+
+    def test_top(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            store.append({"date": "2026-09-01", "amount": "3.50", "category": "food", "note": ""}, p)
+            store.append({"date": "2026-09-02", "amount": "12.00", "category": "travel", "note": "taxi"}, p)
+            store.append({"date": "2026-09-03", "amount": "7.25", "category": "books", "note": ""}, p)
+            out = io.StringIO()
+            with mock.patch.dict(os.environ, {"TALLY_DB": p}):
+                with redirect_stdout(out):
+                    self.assertEqual(cli.main(["top", "2"]), 0)
+        self.assertEqual(out.getvalue(), "2026-09-02 12.00 travel\n2026-09-03 7.25 books\n")
