diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..2d70249
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,98 @@
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from unittest import mock
+
+import tally
+from tally import cli, store
+
+
+class TestCli(unittest.TestCase):
+    def test_version(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            with self.assertRaises(SystemExit) as caught:
+                cli.main(["--version"])
+        self.assertEqual(caught.exception.code, 0)
+        self.assertEqual(out.getvalue(), "tally 1.4.0\n")
+
+    def test_version_tracks_package(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            with self.assertRaises(SystemExit):
+                cli.main(["--version"])
+        self.assertEqual(out.getvalue(), "tally %s\n" % tally.__version__)
+
+    def test_subcommand_still_required(self):
+        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as caught:
+                cli.main([])
+        self.assertEqual(caught.exception.code, 2)
+
+    def test_sum_month(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            for date, amount, category in [("2026-09-09", "7.00", "a"),
+                                           ("2026-10-01", "2.25", "c")]:
+                store.append({"date": date, "amount": amount,
+                              "category": category, "note": ""}, p)
+            out = io.StringIO()
+            with mock.patch.dict(os.environ, {"TALLY_DB": p}):
+                with redirect_stdout(out):
+                    cli.main(["sum", "--month", "2026-09"])
+        self.assertEqual(out.getvalue(), "7.00\n")
+
+    def test_top(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            for date, amount, category in [("2026-09-09", "7.00", "a"),
+                                           ("2026-09-02", "7.00", "b"),
+                                           ("2026-10-01", "2.25", "c")]:
+                store.append({"date": date, "amount": amount,
+                              "category": category, "note": ""}, p)
+            out = io.StringIO()
+            with mock.patch.dict(os.environ, {"TALLY_DB": p}):
+                with redirect_stdout(out):
+                    cli.main(["top", "2"])
+        self.assertEqual(out.getvalue(),
+                         "2026-09-02 7.00 b\n2026-09-09 7.00 a\n")
+
+    def test_export(self):
+        with tempfile.TemporaryDirectory() as d:
+            db = os.path.join(d, "e.csv")
+            out = os.path.join(d, "out.csv")
+            for date, amount, category, note in [
+                    ("2026-10-01", "2.25", "c", ""),
+                    ("2026-09-09", "7", "a", "tea"),
+                    ("2026-09-09", "1.5", "b", "bus, tram")]:
+                store.append({"date": date, "amount": amount,
+                              "category": category, "note": note}, db)
+            with mock.patch.dict(os.environ, {"TALLY_DB": db}):
+                self.assertEqual(cli.main(["export", "--csv", out]), 0)
+            with open(out, newline="") as f:
+                self.assertEqual(f.read(),
+                                 "date,amount,category,note\n"
+                                 "2026-09-09,7.00,a,tea\n"
+                                 "2026-09-09,1.50,b,\"bus, tram\"\n"
+                                 "2026-10-01,2.25,c,\n")
+
+    def test_export_leaves_db_alone(self):
+        with tempfile.TemporaryDirectory() as d:
+            db = os.path.join(d, "e.csv")
+            out = os.path.join(d, "out.csv")
+            store.append({"date": "2026-09-09", "amount": "7",
+                          "category": "a", "note": ""}, db)
+            with open(db, newline="") as f:
+                before = f.read()
+            with mock.patch.dict(os.environ, {"TALLY_DB": db}):
+                cli.main(["export", "--csv", out])
+            with open(db, newline="") as f:
+                self.assertEqual(f.read(), before)
+
+    def test_export_requires_csv(self):
+        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as caught:
+                cli.main(["export"])
+        self.assertEqual(caught.exception.code, 2)
