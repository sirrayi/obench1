@@ -18,3 +20,15 @@ def by_category(rows):
     for r in rows:
         acc[r["category"]] = acc.get(r["category"], Decimal("0")) + r["amount"]
     return sorted(acc.items(), key=lambda kv: (-kv[1], kv[0]))
+
+
+def sorted_by_date(rows):
+    """The rows earliest date first; same-date rows keep their file order."""
+    return sorted(rows, key=lambda r: r["date"])
+
+
+def top(rows, n):
+    """The n largest expenses, biggest first; ties go to the earlier date."""
+    if n <= 0:
+        return []
+    return sorted(rows, key=lambda r: (-r["amount"], r["date"]))[:n]
