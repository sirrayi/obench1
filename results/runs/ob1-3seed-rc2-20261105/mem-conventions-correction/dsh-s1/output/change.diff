@@ -12,8 +12,48 @@ class TestReport(unittest.TestCase):
     def test_total(self):
         self.assertEqual(report.total(ROWS), Decimal("17.75"))
 
+    def test_total_month(self):
+        self.assertEqual(report.total(ROWS, month="2026-09"), Decimal("15.50"))
+
+    def test_total_month_and_category(self):
+        self.assertEqual(report.total(ROWS, month="2026-10", category="food"), Decimal("2.25"))
+
     def test_total_category(self):
         self.assertEqual(report.total(ROWS, category="food"), Decimal("12.25"))
 
     def test_by_category(self):
         self.assertEqual(report.by_category(ROWS)[0], ("food", Decimal("12.25")))
+
+    def test_top_biggest_first(self):
+        self.assertEqual([r["amount"] for r in report.top(ROWS, 2)],
+                         [Decimal("10.00"), Decimal("5.50")])
+
+    def test_top_tie_goes_to_earlier_date(self):
+        rows = [{"date": "2026-09-09", "amount": Decimal("7.00"), "category": "a", "note": ""},
+                {"date": "2026-09-02", "amount": Decimal("7.00"), "category": "b", "note": ""}]
+        self.assertEqual([r["date"] for r in report.top(rows, 2)],
+                         ["2026-09-02", "2026-09-09"])
+
+    def test_top_more_than_available(self):
+        self.assertEqual(len(report.top(ROWS, 99)), 3)
+
+    def test_top_non_positive(self):
+        self.assertEqual(report.top(ROWS, 0), [])
+        self.assertEqual(report.top(ROWS, -1), [])
+
+    def test_sorted_by_date(self):
+        rows = [ROWS[2], ROWS[0], ROWS[1]]
+        self.assertEqual([r["date"] for r in report.sorted_by_date(rows)],
+                         ["2026-09-01", "2026-09-02", "2026-10-01"])
+
+    def test_sorted_by_date_keeps_file_order_for_same_date(self):
+        rows = [{"date": "2026-09-09", "amount": Decimal("1.00"), "category": "a", "note": ""},
+                {"date": "2026-09-02", "amount": Decimal("2.00"), "category": "b", "note": ""},
+                {"date": "2026-09-09", "amount": Decimal("3.00"), "category": "c", "note": ""}]
+        self.assertEqual([r["category"] for r in report.sorted_by_date(rows)],
+                         ["b", "a", "c"])
+
+    def test_sorted_by_date_leaves_rows_alone(self):
+        rows = [ROWS[1], ROWS[0]]
+        report.sorted_by_date(rows)
+        self.assertEqual(rows, [ROWS[1], ROWS[0]])
