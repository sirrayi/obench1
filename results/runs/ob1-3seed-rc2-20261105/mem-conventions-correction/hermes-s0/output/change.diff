@@ -0,0 +1,14 @@
+"""Write the expenses to a CSV file."""
+import csv
+from decimal import Decimal
+
+from tally.store import FIELDS
+
+
+def write_csv(rows, path):
+    """Write the expenses to path sorted by date, keeping file order within a date."""
+    with open(path, "w", newline="") as f:
+        w = csv.DictWriter(f, FIELDS)
+        w.writeheader()
+        for r in sorted(rows, key=lambda r: r["date"]):
+            w.writerow(dict(r, amount="%.2f" % Decimal(r["amount"])))
