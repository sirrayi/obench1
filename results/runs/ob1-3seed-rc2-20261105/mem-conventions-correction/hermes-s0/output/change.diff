@@ -0,0 +1,64 @@
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+from decimal import Decimal
+from unittest import mock
+
+from tally import cli
+
+
+class TestCli(unittest.TestCase):
+    def test_version_flag(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            with self.assertRaises(SystemExit) as ctx:
+                cli.main(["--version"])
+        self.assertEqual(ctx.exception.code, 0)
+        self.assertEqual(out.getvalue().strip(), "tally 1.4.0")
+
+    @mock.patch("tally.cli.store.load")
+    def test_top_command(self, load):
+        load.return_value = [
+            {"date": "2026-09-01", "amount": Decimal("5.00"), "category": "food", "note": ""},
+            {"date": "2026-09-03", "amount": Decimal("9.00"), "category": "travel", "note": ""},
+            {"date": "2026-09-02", "amount": Decimal("5.00"), "category": "rent", "note": ""},
+        ]
+        out = io.StringIO()
+        with redirect_stdout(out):
+            cli.main(["top", "2"])
+        self.assertEqual(out.getvalue(), "2026-09-03 9.00 travel\n2026-09-01 5.00 food\n")
+
+    @mock.patch("tally.cli.store.load")
+    def test_sum_month_command(self, load):
+        load.return_value = [
+            {"date": "2026-09-01", "amount": Decimal("5.00"), "category": "food", "note": ""},
+            {"date": "2026-09-02", "amount": Decimal("7.25"), "category": "travel", "note": ""},
+            {"date": "2026-10-01", "amount": Decimal("3.00"), "category": "food", "note": ""},
+        ]
+        out = io.StringIO()
+        with redirect_stdout(out):
+            cli.main(["sum", "--month", "2026-09"])
+        self.assertEqual(out.getvalue(), "12.25\n")
+
+    @mock.patch("tally.cli.store.load")
+    def test_export_command(self, load):
+        load.return_value = [
+            {"date": "2026-09-03", "amount": Decimal("9.00"), "category": "travel", "note": "train"},
+            {"date": "2026-09-01", "amount": Decimal("5.00"), "category": "food", "note": ""},
+            {"date": "2026-09-03", "amount": Decimal("1.50"), "category": "fun", "note": "gift"},
+        ]
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "out.csv")
+            cli.main(["export", "--csv", p])
+            with open(p) as f:
+                self.assertEqual(f.read(),
+                                 "date,amount,category,note\n"
+                                 "2026-09-01,5.00,food,\n"
+                                 "2026-09-03,9.00,travel,train\n"
+                                 "2026-09-03,1.50,fun,gift\n")
+
+    def test_export_requires_csv_path(self):
+        with self.assertRaises(SystemExit):
+            cli.main(["export"])
