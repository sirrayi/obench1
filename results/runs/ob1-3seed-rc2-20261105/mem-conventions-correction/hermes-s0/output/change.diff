@@ -0,0 +1,38 @@
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from tally import export
+
+ROWS = [{"date": "2026-09-03", "amount": Decimal("5.00"), "category": "travel", "note": "train"},
+        {"date": "2026-09-01", "amount": Decimal("7.5"), "category": "food", "note": "tea"},
+        {"date": "2026-09-03", "amount": Decimal("2.25"), "category": "rent", "note": ""}]
+
+
+class TestExport(unittest.TestCase):
+    def test_sorted_by_date_keeping_file_order(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "out.csv")
+            export.write_csv(ROWS, p)
+            with open(p) as f:
+                self.assertEqual(f.read(),
+                                 "date,amount,category,note\n"
+                                 "2026-09-01,7.50,food,tea\n"
+                                 "2026-09-03,5.00,travel,train\n"
+                                 "2026-09-03,2.25,rent,\n")
+
+    def test_header_written_for_no_rows(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "out.csv")
+            export.write_csv([], p)
+            with open(p) as f:
+                self.assertEqual(f.read(), "date,amount,category,note\n")
+
+    def test_note_with_comma_is_quoted(self):
+        rows = [{"date": "2026-09-01", "amount": Decimal("1"), "category": "food", "note": "tea, milk"}]
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "out.csv")
+            export.write_csv(rows, p)
+            with open(p) as f:
+                self.assertEqual(f.read().splitlines()[1], '2026-09-01,1.00,food,"tea, milk"')
