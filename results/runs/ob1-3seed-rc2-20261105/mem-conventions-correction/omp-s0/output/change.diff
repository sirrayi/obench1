diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..32f55c7
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,47 @@
+import csv
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+from unittest import mock
+
+from tally import store
+from tally.cli import main
+
+
+class TestCli(unittest.TestCase):
+    def test_version(self):
+        out = io.StringIO()
+        with redirect_stdout(out), self.assertRaises(SystemExit) as raised:
+            main(["--version"])
+        self.assertEqual(raised.exception.code, 0)
+        self.assertEqual(out.getvalue(), "tally 1.4.0\n")
+
+    def test_top_prints_largest_first(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "e.csv")
+            store.append({"date": "2026-09-02", "amount": "5.50", "category": "travel", "note": ""}, path)
+            store.append({"date": "2026-09-01", "amount": "10.00", "category": "food", "note": ""}, path)
+            store.append({"date": "2026-08-31", "amount": "10.00", "category": "rent", "note": ""}, path)
+            out = io.StringIO()
+            with mock.patch.dict(os.environ, {"TALLY_DB": path}), redirect_stdout(out):
+                main(["top", "2"])
+            self.assertEqual(out.getvalue(),
+                             "2026-08-31 10.00 rent\n2026-09-01 10.00 food\n")
+
+    def test_export_writes_sorted_csv(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "e.csv")
+            out = os.path.join(d, "export.csv")
+            store.append({"date": "2026-09-02", "amount": "5.50", "category": "travel", "note": ""}, path)
+            store.append({"date": "2026-09-01", "amount": "10", "category": "food", "note": "lunch"}, path)
+            with mock.patch.dict(os.environ, {"TALLY_DB": path}):
+                main(["export", "--csv", out])
+            with open(out, newline="") as f:
+                reader = csv.DictReader(f)
+                self.assertEqual(reader.fieldnames, ["date", "amount", "category", "note"])
+                self.assertEqual(list(reader), [
+                    {"date": "2026-09-01", "amount": "10.00", "category": "food", "note": "lunch"},
+                    {"date": "2026-09-02", "amount": "5.50", "category": "travel", "note": ""},
+                ])
