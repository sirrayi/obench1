diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..19d37a1
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,85 @@
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+from io import StringIO
+
+from tally import cli
+
+
+class TestCli(unittest.TestCase):
+    def test_version(self):
+        out = StringIO()
+        with redirect_stdout(out), self.assertRaises(SystemExit) as raised:
+            cli.main(["--version"])
+        self.assertEqual(raised.exception.code, 0)
+        self.assertEqual(out.getvalue(), "tally 1.4.0\n")
+
+    def test_sum_month(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "e.csv")
+            with open(path, "w") as f:
+                f.write("date,amount,category,note\n"
+                        "2026-09-01,5.00,food,\n"
+                        "2026-10-02,10.00,travel,\n")
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = path
+            try:
+                out = StringIO()
+                with redirect_stdout(out):
+                    cli.main(["sum", "--month", "2026-09"])
+                self.assertEqual(out.getvalue(), "5.00\n")
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
+
+    def test_top(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "e.csv")
+            with open(path, "w") as f:
+                f.write("date,amount,category,note\n"
+                        "2026-09-01,5.00,food,\n"
+                        "2026-09-02,10.00,travel,\n"
+                        "2026-09-03,5.00,books,\n")
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = path
+            try:
+                out = StringIO()
+                with redirect_stdout(out):
+                    cli.main(["top", "2"])
+                self.assertEqual(out.getvalue(),
+                                 "2026-09-02 10.00 travel\n2026-09-01 5.00 food\n")
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
+
+    def test_export_sorted_by_date_stably(self):
+        with tempfile.TemporaryDirectory() as d:
+            source = os.path.join(d, "e.csv")
+            dest = os.path.join(d, "out.csv")
+            with open(source, "w") as f:
+                f.write("date,amount,category,note\n"
+                        "2026-09-03,3.5,books,third\n"
+                        "2026-09-01,1,food,first\n"
+                        "2026-09-03,4,travel,fourth\n"
+                        "2026-09-02,2.25,rent,second\n")
+            old = os.environ.get("TALLY_DB")
+            os.environ["TALLY_DB"] = source
+            try:
+                cli.main(["export", "--csv", dest])
+                with open(dest) as f:
+                    self.assertEqual(f.read(),
+                                     "date,amount,category,note\n"
+                                     "2026-09-01,1.00,food,first\n"
+                                     "2026-09-02,2.25,rent,second\n"
+                                     "2026-09-03,3.50,books,third\n"
+                                     "2026-09-03,4.00,travel,fourth\n")
+            finally:
+                if old is None:
+                    del os.environ["TALLY_DB"]
+                else:
+                    os.environ["TALLY_DB"] = old
