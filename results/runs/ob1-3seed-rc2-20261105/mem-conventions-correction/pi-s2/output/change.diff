diff --git a/tally/report.py b/tally/report.py
index 8f75347..557f9bc 100644
--- a/tally/report.py
+++ b/tally/report.py
@@ -6,6 +6,8 @@ def total(rows, month=None, category=None):
     """Sum the amounts, optionally for one month (YYYY-MM) and one category."""
     out = Decimal("0")
     for r in rows:
+        if month and r["date"][:7] != month:
+            continue
         if category and r["category"] != category:
             continue
         out += r["amount"]
