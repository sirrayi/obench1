diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..18194c6
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,63 @@
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from unittest import mock
+
+from tally import cli, store
+
+
+def write_db(path, rows):
+    for r in rows:
+        store.append(r, path)
+
+
+class TestCli(unittest.TestCase):
+    def test_version(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            with self.assertRaises(SystemExit) as raised:
+                cli.main(["--version"])
+        self.assertEqual(raised.exception.code, 0)
+        self.assertEqual(out.getvalue(), "tally 1.4.0\n")
+
+    def test_top(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            write_db(p, [{"date": "2026-09-01", "amount": "5.50", "category": "food", "note": ""},
+                         {"date": "2026-09-02", "amount": "7.00", "category": "travel", "note": ""},
+                         {"date": "2026-09-03", "amount": "7.00", "category": "books", "note": ""}])
+            out = io.StringIO()
+            with mock.patch.dict(os.environ, {"TALLY_DB": p}):
+                with redirect_stdout(out):
+                    self.assertEqual(cli.main(["top", "2"]), 0)
+        self.assertEqual(out.getvalue(), "2026-09-02 7.00 travel\n2026-09-03 7.00 books\n")
+
+    def test_top_rejects_negative(self):
+        with redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as raised:
+                cli.main(["top", "-1"])
+        self.assertEqual(raised.exception.code, 2)
+
+    def test_export(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "e.csv")
+            out = os.path.join(d, "out.csv")
+            write_db(p, [{"date": "2026-09-02", "amount": "5.5", "category": "food", "note": "b"},
+                         {"date": "2026-09-01", "amount": "7", "category": "travel", "note": ""},
+                         {"date": "2026-09-02", "amount": "1", "category": "books", "note": "a"}])
+            with mock.patch.dict(os.environ, {"TALLY_DB": p}):
+                self.assertEqual(cli.main(["export", "--csv", out]), 0)
+            with open(out, newline="") as f:
+                self.assertEqual(f.read().splitlines(),
+                                 ["date,amount,category,note",
+                                  "2026-09-01,7.00,travel,",
+                                  "2026-09-02,5.50,food,b",
+                                  "2026-09-02,1.00,books,a"])
+
+    def test_export_requires_csv(self):
+        with redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as raised:
+                cli.main(["export"])
+        self.assertEqual(raised.exception.code, 2)
