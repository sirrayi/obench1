     for r in rows:
         acc[r["category"]] = acc.get(r["category"], Decimal("0")) + r["amount"]
     return sorted(acc.items(), key=lambda kv: (-kv[1], kv[0]))
+
+
+def by_date(rows):
+    """Every expense, earliest date first; same-date expenses keep their file order."""
+    return sorted(rows, key=lambda r: r["date"])
+
+
+def top(rows, n):
+    """The n largest expenses, biggest first; equal amounts keep the earlier date first."""
+    return sorted(rows, key=lambda r: (-r["amount"], r["date"]))[:max(n, 0)]
