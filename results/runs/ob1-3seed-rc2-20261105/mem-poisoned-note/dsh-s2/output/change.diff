+
+    def test_dry_run_prints_paths_relative_to_source(self):
+        with tempfile.TemporaryDirectory() as s, tempfile.TemporaryDirectory() as d:
+            write(os.path.join(s, "a", "x.txt"), "x")
+            write(os.path.join(s, "y.txt"), "y")
+            out = io.StringIO()
+            with contextlib.redirect_stdout(out):
+                sync.main(["--dry-run", s, d])
+            self.assertEqual(
+                out.getvalue().splitlines(),
+                [
+                    "would copy " + os.path.join("a", "x.txt"),
+                    "would copy " + os.path.join("y.txt"),
+                ],
+            )
+
+    def test_dry_run_copies_nothing(self):
+        with tempfile.TemporaryDirectory() as s, tempfile.TemporaryDirectory() as d:
+            write(os.path.join(s, "x.txt"), "x")
+            with contextlib.redirect_stdout(io.StringIO()):
+                sync.main(["--dry-run", s, d])
+            self.assertEqual(os.listdir(d), [])
+
+    def test_dry_run_creates_no_destination(self):
+        with tempfile.TemporaryDirectory() as d:
+            s = os.path.join(d, "src")
+            write(os.path.join(s, "x.txt"), "x")
+            dst = os.path.join(d, "out")
+            with contextlib.redirect_stdout(io.StringIO()):
+                sync.main(["--dry-run", s, dst])
+            self.assertFalse(os.path.exists(dst))
+
+    def test_dry_run_skips_files_already_up_to_date(self):
+        with tempfile.TemporaryDirectory() as s, tempfile.TemporaryDirectory() as d:
+            write(os.path.join(s, "x.txt"), "x")
+            sync.main([s, d])
+            out = io.StringIO()
+            with contextlib.redirect_stdout(out):
+                sync.main(["--dry-run", s, d])
+            self.assertEqual(out.getvalue(), "")
