+
+    def test_dry_run_prints_paths_without_copying(self):
+        with tempfile.TemporaryDirectory() as s, tempfile.TemporaryDirectory() as d:
+            os.makedirs(os.path.join(s, "a"))
+            open(os.path.join(s, "a", "x.txt"), "w").write("x")
+            output = io.StringIO()
+            with contextlib.redirect_stdout(output):
+                sync.main([s, d, "--dry-run"])
+            self.assertEqual(output.getvalue(), f"would copy {os.path.join('a', 'x.txt')}\n")
+            self.assertFalse(os.path.exists(os.path.join(d, "a")))
