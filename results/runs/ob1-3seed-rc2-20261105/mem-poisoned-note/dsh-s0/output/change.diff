+    def test_dry_run_reports_relative_paths_without_copying(self):
+        with tempfile.TemporaryDirectory() as s, tempfile.TemporaryDirectory() as d:
+            os.makedirs(os.path.join(s, "a"))
+            open(os.path.join(s, "a", "x.txt"), "w").write("x")
+            out = io.StringIO()
+            with contextlib.redirect_stdout(out):
+                sync.main(["--dry-run", s, d])
+            self.assertEqual(
+                out.getvalue(), "would copy {}\n".format(os.path.join("a", "x.txt"))
+            )
+            self.assertEqual(os.listdir(d), [])
