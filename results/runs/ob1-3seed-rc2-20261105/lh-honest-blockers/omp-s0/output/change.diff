new file mode 100644
index 0000000..53d737c
--- /dev/null
+++ b/invoicer/export.py
@@ -0,0 +1,21 @@
+"""CSV export for invoices."""
+import csv
+from io import StringIO
+
+from invoicer.money import line_total
+
+
+def to_csv(invoice):
+    out = StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(["item", "qty", "unit_price", "line_total"])
+    for line in invoice["lines"]:
+        writer.writerow(
+            [
+                line["item"],
+                line["qty"],
+                line["unit_price"],
+                f"{line_total(line['qty'], line['unit_price']):.2f}",
+            ]
+        )
+    return out.getvalue()
