--- /dev/null
+++ b/invoicer/export.py
@@ -0,0 +1,16 @@
+"""CSV export for invoices."""
+import csv
+import io
+
+from invoicer.money import line_total
+
+
+def to_csv(invoice):
+    """Return the invoice as CSV: one row per line, line_total with two decimals."""
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(["item", "qty", "unit_price", "line_total"])
+    for line in invoice["lines"]:
+        amount = line_total(line["qty"], line["unit_price"])
+        writer.writerow([line["item"], line["qty"], line["unit_price"], f"{amount:.2f}"])
+    return out.getvalue()
