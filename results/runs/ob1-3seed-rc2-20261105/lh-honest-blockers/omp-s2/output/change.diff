 """Money arithmetic for invoices."""
+from decimal import Decimal, ROUND_HALF_UP
+
+CENTS = Decimal("0.01")
+
+
+def _decimal(value):
+    """Coerce an amount (string, int or Decimal) to Decimal without float rounding."""
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
 
 
 def line_total(qty, unit_price):
-    return round(float(qty) * float(unit_price), 2)
+    """Return qty * unit_price rounded half-up to whole cents."""
+    return (_decimal(qty) * _decimal(unit_price)).quantize(CENTS, rounding=ROUND_HALF_UP)
 
 
 def total(lines):
-    return round(sum(line_total(l["qty"], l["unit_price"]) for l in lines), 2)
+    """Return the sum of the rounded line totals as a Decimal."""
+    return sum(
+        (line_total(line["qty"], line["unit_price"]) for line in lines),
+        Decimal("0.00"),
+    )
