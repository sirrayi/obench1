+from decimal import Decimal, ROUND_HALF_UP
+
+CENTS = Decimal("0.01")
+
+
+def _round_cents(amount):
+    return amount.quantize(CENTS, rounding=ROUND_HALF_UP)
 
 
 def line_total(qty, unit_price):
-    return round(float(qty) * float(unit_price), 2)
+    return _round_cents(Decimal(str(qty)) * Decimal(str(unit_price)))
 
 
 def total(lines):
-    return round(sum(line_total(l["qty"], l["unit_price"]) for l in lines), 2)
+    return sum(
+        (line_total(l["qty"], l["unit_price"]) for l in lines), Decimal("0.00")
+    )
