@@ -0,0 +1,39 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from invoicer.cli import main
+
+
+class TestCli(unittest.TestCase):
+    def setUp(self):
+        self.invoice = {"client": "Acme", "lines": [{"item": "X", "qty": "1", "unit_price": "2.675"}]}
+        fd, self.path = tempfile.mkstemp(suffix=".json")
+        with os.fdopen(fd, "w") as f:
+            json.dump(self.invoice, f)
+        self.addCleanup(os.remove, self.path)
+
+    def output(self, argv):
+        buf = io.StringIO()
+        with contextlib.redirect_stdout(buf):
+            main(argv)
+        return buf.getvalue().strip()
+
+    def test_default_currency_is_eur(self):
+        self.assertEqual(self.output([self.path]), "Acme: €2.68")
+
+    def test_usd_and_gbp_prefixes(self):
+        self.assertEqual(self.output([self.path, "--currency", "USD"]), "Acme: $2.68")
+        self.assertEqual(self.output([self.path, "--currency", "GBP"]), "Acme: £2.68")
+
+    def test_unknown_currency_is_an_error(self):
+        with contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit):
+                main([self.path, "--currency", "JPY"])
+
+
+if __name__ == "__main__":
+    unittest.main()
