--- /dev/null
+++ b/invoicer/export.py
@@ -0,0 +1,19 @@
+"""CSV export for invoices."""
+import csv
+import io
+
+from invoicer.money import line_total
+
+HEADER = ["item", "qty", "unit_price", "line_total"]
+
+
+def to_csv(invoice):
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(HEADER)
+    for line in invoice["lines"]:
+        row_total = line_total(line["qty"], line["unit_price"])
+        writer.writerow(
+            [line["item"], line["qty"], line["unit_price"], f"{row_total:.2f}"]
+        )
+    return buf.getvalue()
