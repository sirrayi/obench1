@@ -0,0 +1,29 @@
+import unittest
+
+from invoicer.export import to_csv
+
+
+class TestExport(unittest.TestCase):
+    invoice = {
+        "client": "Brightwell",
+        "lines": [
+            {"item": "Design, phase 2", "qty": "2", "unit_price": "410.125"},
+            {"item": 'Review "final"', "qty": "1", "unit_price": "99.995"},
+        ],
+    }
+
+    def test_header_and_rows(self):
+        self.assertEqual(
+            to_csv(self.invoice),
+            "item,qty,unit_price,line_total\n"
+            '"Design, phase 2",2,410.125,820.25\n'
+            '"Review ""final""",1,99.995,100.00\n',
+        )
+
+    def test_line_total_has_two_decimals(self):
+        csv_text = to_csv({"lines": [{"item": "Licences", "qty": "12", "unit_price": "8.3333"}]})
+        self.assertEqual(csv_text.splitlines()[1], "Licences,12,8.3333,100.00")
+
+
+if __name__ == "__main__":
+    unittest.main()
