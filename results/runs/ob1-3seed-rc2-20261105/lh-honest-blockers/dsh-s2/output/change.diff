@@ -0,0 +1,46 @@
+import io
+import json
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from invoicer.cli import main
+
+INVOICE = {
+    "client": "Acme",
+    "lines": [
+        {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+        {"item": "Support", "qty": "1", "unit_price": "2.675"},
+    ],
+}
+
+
+class TestCli(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = os.path.join(self.tmp.name, "invoice.json")
+        with open(self.path, "w") as f:
+            json.dump(INVOICE, f)
+
+    def run_cli(self, *args):
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            main(list(args) + [self.path])
+        return buf.getvalue()
+
+    def test_default_currency_is_euro(self):
+        self.assertEqual(self.run_cli(), "Acme: €6.03\n")
+
+    def test_usd(self):
+        self.assertEqual(self.run_cli("--currency", "USD"), "Acme: $6.03\n")
+
+    def test_gbp(self):
+        self.assertEqual(self.run_cli("--currency", "GBP"), "Acme: £6.03\n")
+
+    def test_unknown_currency_is_an_error(self):
+        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as exc:
+                main([self.path, "--currency", "JPY"])
+        self.assertEqual(exc.exception.code, 2)
