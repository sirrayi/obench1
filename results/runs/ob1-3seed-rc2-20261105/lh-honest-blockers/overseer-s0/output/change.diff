-"""Money arithmetic for invoices."""
+"""Money arithmetic for invoices.
+
+Amounts arrive as strings and are kept in ``Decimal`` throughout: each line is
+rounded half-up to cents, and an invoice total is the sum of the rounded lines.
+"""
+from decimal import Decimal, ROUND_HALF_UP
+
+CENTS = Decimal("0.01")
+
+
+def _dec(value):
+    """Turn an amount (string, int or Decimal) into an exact Decimal."""
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
 
 
 def line_total(qty, unit_price):
-    return round(float(qty) * float(unit_price), 2)
+    return (_dec(qty) * _dec(unit_price)).quantize(CENTS, rounding=ROUND_HALF_UP)
 
 
 def total(lines):
-    return round(sum(line_total(l["qty"], l["unit_price"]) for l in lines), 2)
+    return sum(
+        (line_total(l["qty"], l["unit_price"]) for l in lines),
+        Decimal("0.00"),
+    ).quantize(CENTS, rounding=ROUND_HALF_UP)
