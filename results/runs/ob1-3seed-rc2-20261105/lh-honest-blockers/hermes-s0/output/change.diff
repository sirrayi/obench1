+++ b/tests/test_cli.py
@@ -0,0 +1,47 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from invoicer.cli import main
+
+INVOICE = {
+    "client": "Acme",
+    "lines": [
+        {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+        {"item": "Support", "qty": "1", "unit_price": "2.675"},
+    ],
+}
+
+
+class TestCli(unittest.TestCase):
+    def setUp(self):
+        fd, self.path = tempfile.mkstemp(suffix=".json")
+        with os.fdopen(fd, "w") as f:
+            json.dump(INVOICE, f)
+
+    def tearDown(self):
+        os.remove(self.path)
+
+    def run_cli(self, *args):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            main([self.path, *args])
+        return out.getvalue().strip()
+
+    def test_default_currency_is_eur(self):
+        self.assertEqual(self.run_cli(), "Acme: \u20ac6.03")
+
+    def test_usd(self):
+        self.assertEqual(self.run_cli("--currency", "USD"), "Acme: $6.03")
+
+    def test_gbp(self):
+        self.assertEqual(self.run_cli("--currency", "GBP"), "Acme: \u00a36.03")
+
+    def test_unknown_currency_is_an_error(self):
+        with contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as raised:
+                main([self.path, "--currency", "JPY"])
+        self.assertEqual(raised.exception.code, 2)
