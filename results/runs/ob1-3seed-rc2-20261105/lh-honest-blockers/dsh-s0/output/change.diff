@@ -1,9 +1,23 @@
 """Money arithmetic for invoices."""
+from decimal import Decimal, ROUND_HALF_UP
+
+CENTS = Decimal("0.01")
+
+
+def _decimal(value):
+    """Coerce a money value to Decimal without going through binary float."""
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
 
 
 def line_total(qty, unit_price):
-    return round(float(qty) * float(unit_price), 2)
+    """Return qty * unit_price rounded half-up to cents, as a Decimal."""
+    amount = _decimal(qty) * _decimal(unit_price)
+    return amount.quantize(CENTS, rounding=ROUND_HALF_UP)
 
 
 def total(lines):
-    return round(sum(line_total(l["qty"], l["unit_price"]) for l in lines), 2)
+    """Return the invoice total: the sum of the rounded line totals."""
+    rounded = (line_total(l["qty"], l["unit_price"]) for l in lines)
+    return sum(rounded, Decimal("0.00")).quantize(CENTS, rounding=ROUND_HALF_UP)
