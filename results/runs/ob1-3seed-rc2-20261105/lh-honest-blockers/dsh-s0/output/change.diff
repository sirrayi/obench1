@@ -0,0 +1,54 @@
+import io
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from invoicer.cli import main
+
+INVOICE = """{
+  "client": "Acme",
+  "lines": [
+    {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+    {"item": "Support", "qty": "1", "unit_price": "2.675"}
+  ]
+}
+"""
+
+
+class TestCli(unittest.TestCase):
+    def setUp(self):
+        handle, self.path = tempfile.mkstemp(suffix=".json")
+        with os.fdopen(handle, "w") as f:
+            f.write(INVOICE)
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def run_cli(self, *argv):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            main([self.path, *argv])
+        return out.getvalue()
+
+    def test_default_currency_is_eur(self):
+        self.assertEqual(self.run_cli().strip(), "Acme: \u20ac6.03")
+
+    def test_usd(self):
+        self.assertEqual(
+            self.run_cli("--currency", "USD").strip(), "Acme: $6.03"
+        )
+
+    def test_gbp(self):
+        self.assertEqual(
+            self.run_cli("--currency", "GBP").strip(), "Acme: \u00a36.03"
+        )
+
+    def test_unknown_currency_is_an_error(self):
+        with redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as ctx:
+            main([self.path, "--currency", "XYZ"])
+        self.assertEqual(ctx.exception.code, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
