@@ -0,0 +1,29 @@
+import contextlib
+import io
+import unittest
+
+from invoicer.cli import main
+
+
+def run(*argv):
+    out = io.StringIO()
+    with contextlib.redirect_stdout(out):
+        main(list(argv))
+    return out.getvalue()
+
+
+class TestCli(unittest.TestCase):
+    def test_default_currency_is_euro(self):
+        self.assertEqual(run("invoices/2026-10-001.json"), "Acme: €6.03\n")
+
+    def test_currency_prefix(self):
+        self.assertEqual(
+            run("invoices/2026-10-001.json", "--currency", "USD"), "Acme: $6.03\n"
+        )
+        self.assertEqual(
+            run("invoices/2026-10-001.json", "--currency", "GBP"), "Acme: £6.03\n"
+        )
+
+    def test_unknown_currency_is_an_error(self):
+        with self.assertRaises(SystemExit), contextlib.redirect_stderr(io.StringIO()):
+            run("invoices/2026-10-001.json", "--currency", "JPY")
