+++ b/tests/test_export.py
@@ -0,0 +1,31 @@
+import io
+import json
+import unittest
+
+from invoicer.export import to_csv
+
+INVOICE = {
+    "client": "Brightwell",
+    "lines": [
+        {"item": "Design, phase 2", "qty": "2", "unit_price": "410.125"},
+        {"item": 'Review "final"', "qty": "1", "unit_price": "99.995"},
+    ],
+}
+
+
+class TestExport(unittest.TestCase):
+    def test_header_and_rows(self):
+        expected = (
+            "item,qty,unit_price,line_total\n"
+            '"Design, phase 2",2,410.125,820.25\n'
+            '"Review ""final""",1,99.995,100.00\n'
+        )
+        self.assertEqual(to_csv(INVOICE), expected)
+
+    def test_round_trip(self):
+        import csv
+
+        rows = list(csv.reader(io.StringIO(to_csv(INVOICE))))
+        self.assertEqual(rows[0], ["item", "qty", "unit_price", "line_total"])
+        self.assertEqual(len(rows), 3)
+        self.assertEqual(rows[1][3], "820.25")
