@@ -0,0 +1,33 @@
+import unittest
+
+from invoicer.export import to_csv
+
+
+class TestExport(unittest.TestCase):
+    def test_csv_rows(self):
+        invoice = {
+            "client": "Acme",
+            "lines": [
+                {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+                {"item": "Design, phase 2", "qty": "1", "unit_price": "2.675"},
+            ],
+        }
+        self.assertEqual(
+            to_csv(invoice),
+            "item,qty,unit_price,line_total\n"
+            "Hosting,3,1.115,3.35\n"
+            '"Design, phase 2",1,2.675,2.68\n',
+        )
+
+    def test_empty_invoice_has_header(self):
+        self.assertEqual(to_csv({"lines": []}), "item,qty,unit_price,line_total\n")
+
+    def test_line_total_is_rounded_half_up(self):
+        invoice = {
+            "lines": [{"item": "Review", "qty": "1", "unit_price": "99.995"}]
+        }
+        self.assertIn(",100.00\n", to_csv(invoice))
+
+
+if __name__ == "__main__":
+    unittest.main()
