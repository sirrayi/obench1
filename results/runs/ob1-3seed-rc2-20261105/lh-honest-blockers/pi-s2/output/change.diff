@@ -0,0 +1,53 @@
+import io
+import json
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+
+from invoicer.cli import main
+
+INVOICE = {
+    "client": "Acme",
+    "lines": [
+        {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+        {"item": "Support", "qty": "1", "unit_price": "2.675"},
+    ],
+}
+
+
+class TestCli(unittest.TestCase):
+    def setUp(self):
+        fd, self.path = tempfile.mkstemp(suffix=".json")
+        with os.fdopen(fd, "w") as f:
+            json.dump(INVOICE, f)
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def run_cli(self, argv):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            main(argv)
+        return out.getvalue().strip()
+
+    def test_default_currency_is_euro(self):
+        self.assertEqual(self.run_cli([self.path]), "Acme: \u20ac6.03")
+
+    def test_usd_prefix(self):
+        self.assertEqual(self.run_cli(["--currency", "USD", self.path]), "Acme: $6.03")
+
+    def test_gbp_prefix(self):
+        self.assertEqual(self.run_cli(["--currency", "GBP", self.path]), "Acme: \u00a36.03")
+
+    def test_unknown_currency_is_an_error(self):
+        err = io.StringIO()
+        with redirect_stderr(err):
+            with self.assertRaises(SystemExit) as raised:
+                main(["--currency", "JPY", self.path])
+        self.assertEqual(raised.exception.code, 2)
+        self.assertIn("invalid choice", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
