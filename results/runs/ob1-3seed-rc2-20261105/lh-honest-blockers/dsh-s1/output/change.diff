@@ -0,0 +1,51 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from invoicer.cli import main
+
+
+INVOICE = {
+    "client": "Acme",
+    "lines": [
+        {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+        {"item": "Support", "qty": "1", "unit_price": "2.675"},
+    ],
+}
+
+
+class TestCli(unittest.TestCase):
+    def setUp(self):
+        fd, self.path = tempfile.mkstemp(suffix=".json")
+        with os.fdopen(fd, "w") as f:
+            json.dump(INVOICE, f)
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def run_cli(self, argv):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            main(argv)
+        return out.getvalue()
+
+    def test_default_currency_is_eur(self):
+        self.assertEqual(self.run_cli([self.path]), "Acme: \u20ac6.03\n")
+
+    def test_usd(self):
+        self.assertEqual(self.run_cli([self.path, "--currency", "USD"]), "Acme: $6.03\n")
+
+    def test_gbp(self):
+        self.assertEqual(self.run_cli([self.path, "--currency", "GBP"]), "Acme: \u00a36.03\n")
+
+    def test_unknown_currency_is_an_error(self):
+        with contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit):
+                self.run_cli([self.path, "--currency", "CHF"])
+
+
+if __name__ == "__main__":
+    unittest.main()
