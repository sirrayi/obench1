@@ -0,0 +1,42 @@
+import csv
+import io
+import unittest
+
+from invoicer.export import to_csv
+
+
+INVOICE = {
+    "client": "Acme",
+    "lines": [
+        {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+        {"item": "Support", "qty": "1", "unit_price": "2.675"},
+    ],
+}
+
+
+class TestExport(unittest.TestCase):
+    def test_header(self):
+        rows = list(csv.reader(io.StringIO(to_csv(INVOICE))))
+        self.assertEqual(rows[0], ["item", "qty", "unit_price", "line_total"])
+
+    def test_one_row_per_line_with_rounded_totals(self):
+        rows = list(csv.reader(io.StringIO(to_csv(INVOICE))))
+        self.assertEqual(len(rows), 3)
+        self.assertEqual(rows[1], ["Hosting", "3", "1.115", "3.35"])
+        self.assertEqual(rows[2], ["Support", "1", "2.675", "2.68"])
+
+    def test_line_total_uses_two_decimals(self):
+        invoice = {"client": "Brightwell", "lines": [{"item": "Review", "qty": "1", "unit_price": "99.995"}]}
+        rows = list(csv.reader(io.StringIO(to_csv(invoice))))
+        self.assertEqual(rows[1][3], "100.00")
+
+    def test_fields_with_commas_and_quotes_are_escaped(self):
+        invoice = {"client": "Brightwell", "lines": [{"item": 'Design, phase "2"', "qty": "2", "unit_price": "410.125"}]}
+        text = to_csv(invoice)
+        rows = list(csv.reader(io.StringIO(text)))
+        self.assertEqual(rows[1][0], 'Design, phase "2"')
+        self.assertEqual(rows[1][3], "820.25")
+
+
+if __name__ == "__main__":
+    unittest.main()
