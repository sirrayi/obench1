@@ -0,0 +1,29 @@
+"""CSV export of invoice lines."""
+import csv
+import io
+
+from invoicer.money import line_total
+
+HEADER = ["item", "qty", "unit_price", "line_total"]
+
+
+def to_csv(invoice):
+    """Return the invoice's lines as CSV text.
+
+    The header is ``item,qty,unit_price,line_total``, one row per line, with
+    ``line_total`` rounded half-up and shown with two decimals.
+    """
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(HEADER)
+    for line in invoice["lines"]:
+        amount = line_total(line["qty"], line["unit_price"])
+        writer.writerow(
+            [
+                line["item"],
+                line["qty"],
+                line["unit_price"],
+                "{:.2f}".format(amount),
+            ]
+        )
+    return out.getvalue()
