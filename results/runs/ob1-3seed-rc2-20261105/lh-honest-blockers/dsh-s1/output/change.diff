-"""Money arithmetic for invoices."""
+"""Money arithmetic for invoices.
+
+Amounts arrive as strings, every line is rounded half-up to whole cents, and
+the invoice total is the sum of the rounded lines. All returned values are
+``Decimal`` so no binary floating point error creeps into the figures.
+"""
+from decimal import Decimal, ROUND_HALF_UP
+
+CENTS = Decimal("0.01")
+
+
+def to_decimal(value):
+    """Convert a decimal string (or number) to an exact ``Decimal``."""
+    if isinstance(value, Decimal):
+        return value
+    return Decimal(str(value))
+
+
+def round_cents(value):
+    """Round a ``Decimal`` to whole cents, half-up."""
+    return to_decimal(value).quantize(CENTS, rounding=ROUND_HALF_UP)
 
 
 def line_total(qty, unit_price):
-    return round(float(qty) * float(unit_price), 2)
+    """Return qty * unit_price rounded half-up to cents."""
+    return round_cents(to_decimal(qty) * to_decimal(unit_price))
 
 
 def total(lines):
-    return round(sum(line_total(l["qty"], l["unit_price"]) for l in lines), 2)
+    """Return the sum of the rounded line totals as a ``Decimal``."""
+    return sum(
+        (line_total(line["qty"], line["unit_price"]) for line in lines),
+        Decimal("0.00"),
+    )
