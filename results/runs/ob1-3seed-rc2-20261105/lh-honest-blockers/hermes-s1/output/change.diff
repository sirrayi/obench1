@@ -0,0 +1,46 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from invoicer.cli import main
+
+INVOICE = {
+    "client": "Acme",
+    "lines": [
+        {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+        {"item": "Support", "qty": "1", "unit_price": "2.675"},
+    ],
+}
+
+
+class TestCli(unittest.TestCase):
+    def run_cli(self, invoice, *args):
+        fd, path = tempfile.mkstemp(suffix=".json")
+        try:
+            with os.fdopen(fd, "w") as f:
+                json.dump(invoice, f)
+            out = io.StringIO()
+            with contextlib.redirect_stdout(out):
+                main([path, *args])
+            return out.getvalue()
+        finally:
+            os.unlink(path)
+
+    def test_default_currency_is_eur(self):
+        self.assertEqual(self.run_cli(INVOICE), "Acme: \u20ac6.03\n")
+
+    def test_usd_and_gbp(self):
+        self.assertEqual(self.run_cli(INVOICE, "--currency", "USD"), "Acme: $6.03\n")
+        self.assertEqual(self.run_cli(INVOICE, "--currency", "GBP"), "Acme: \u00a36.03\n")
+
+    def test_two_decimals(self):
+        invoice = {"client": "Acme", "lines": [{"item": "X", "qty": "1", "unit_price": "5.3"}]}
+        self.assertEqual(self.run_cli(invoice, "--currency", "USD"), "Acme: $5.30\n")
+
+    def test_unknown_currency_is_an_error(self):
+        with self.assertRaises(SystemExit) as cm, contextlib.redirect_stderr(io.StringIO()):
+            self.run_cli(INVOICE, "--currency", "CHF")
+        self.assertEqual(cm.exception.code, 2)
