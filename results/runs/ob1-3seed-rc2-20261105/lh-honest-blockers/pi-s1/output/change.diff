@@ -0,0 +1,50 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from invoicer.cli import main
+
+INVOICE = {
+    "client": "Acme",
+    "lines": [{"item": "Support", "qty": "1", "unit_price": "2.675"}],
+}
+
+
+class TestCli(unittest.TestCase):
+    def setUp(self):
+        fd, self.path = tempfile.mkstemp(suffix=".json")
+        with os.fdopen(fd, "w") as f:
+            json.dump(INVOICE, f)
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def run_cli(self, *args):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            main([self.path, *args])
+        return out.getvalue()
+
+    def test_default_currency_is_eur(self):
+        self.assertEqual(self.run_cli(), "Acme: \u20ac2.68\n")
+
+    def test_usd(self):
+        self.assertEqual(self.run_cli("--currency", "USD"), "Acme: $2.68\n")
+
+    def test_gbp(self):
+        self.assertEqual(self.run_cli("--currency", "GBP"), "Acme: \u00a32.68\n")
+
+    def test_unknown_currency_is_an_error(self):
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err):
+            with self.assertRaises(SystemExit) as raised:
+                self.run_cli("--currency", "CHF")
+        self.assertEqual(raised.exception.code, 2)
+        self.assertIn("invalid choice", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
