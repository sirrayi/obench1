@@ -0,0 +1,47 @@
+import unittest
+
+from invoicer.export import to_csv
+
+
+class TestExport(unittest.TestCase):
+    def test_header_and_rows(self):
+        invoice = {
+            "client": "Acme",
+            "lines": [
+                {"item": "Hosting", "qty": "3", "unit_price": "1.115"},
+                {"item": "Support", "qty": "1", "unit_price": "2.675"},
+            ],
+        }
+        self.assertEqual(
+            to_csv(invoice),
+            "item,qty,unit_price,line_total\n"
+            "Hosting,3,1.115,3.35\n"
+            "Support,1,2.675,2.68\n",
+        )
+
+    def test_quotes_items_containing_delimiters(self):
+        invoice = {
+            "client": "Brightwell",
+            "lines": [
+                {"item": "Design, phase 2", "qty": "2", "unit_price": "410.125"},
+                {"item": 'Review "final"', "qty": "1", "unit_price": "99.995"},
+            ],
+        }
+        self.assertEqual(
+            to_csv(invoice),
+            "item,qty,unit_price,line_total\n"
+            '"Design, phase 2",2,410.125,820.25\n'
+            '"Review ""final""",1,99.995,100.00\n',
+        )
+
+    def test_line_total_always_has_two_decimals(self):
+        invoice = {
+            "client": "Corvid Ltd",
+            "lines": [{"item": "Licences", "qty": "12", "unit_price": "8.3333"}],
+        }
+        rows = to_csv(invoice).splitlines()
+        self.assertEqual(rows[1], "Licences,12,8.3333,100.00")
+
+
+if __name__ == "__main__":
+    unittest.main()
