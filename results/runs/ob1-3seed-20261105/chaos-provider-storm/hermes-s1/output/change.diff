@@ -0,0 +1,28 @@
+"""Command line interface: python3 -m units <value> <src> <dst>."""
+
+import sys
+
+from . import convert
+
+_USAGE = "usage: python3 -m units <value> <src> <dst>"
+
+
+def main(argv=None):
+    args = sys.argv[1:] if argv is None else argv
+    if len(args) != 3:
+        print(_USAGE, file=sys.stderr)
+        return 2
+
+    value, src, dst = args
+    try:
+        result = convert(value, src, dst)
+    except ValueError as exc:
+        print(exc, file=sys.stderr)
+        return 2
+
+    print("%.6g" % result)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
