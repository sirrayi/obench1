@@ -0,0 +1,26 @@
+"""Command line interface: python3 -m units <value> <src> <dst>."""
+
+import sys
+
+from . import convert
+
+USAGE = "usage: python3 -m units <value> <src> <dst>"
+
+
+def main(argv=None):
+    args = sys.argv[1:] if argv is None else argv
+    if len(args) != 3:
+        print(USAGE, file=sys.stderr)
+        return 2
+    raw_value, src, dst = args
+    try:
+        result = convert(float(raw_value), src, dst)
+    except ValueError as exc:
+        print(exc, file=sys.stderr)
+        return 2
+    print("%.6g" % result)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
