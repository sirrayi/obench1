+"""Command line entry point: python3 -m units <value> <src> <dst>."""
+
+import sys
+
+from . import convert
+
+_USAGE = "usage: python3 -m units <value> <src> <dst>"
+
+
+def main(argv=None):
+    args = sys.argv[1:] if argv is None else list(argv)
+    if len(args) != 3:
+        print(_USAGE, file=sys.stderr)
+        return 2
+    raw_value, src, dst = args
+    try:
+        value = float(raw_value)
+    except ValueError:
+        print("units: not a number: %s" % raw_value, file=sys.stderr)
+        return 2
+    try:
+        result = convert(value, src, dst)
+    except ValueError as exc:
+        print("units: %s" % exc, file=sys.stderr)
+        return 2
+    print("%.6g" % result)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
